<h1 class="regular center h1">Receive your <strong><%= @grant.amount.format %></strong> grant from<br /><strong><%= @grant.event.name %></strong>:</h1>

<%= form_with model: @grant, url: activate_grant_path(@grant), method: :post do |form| %>
  <ul class="steps" data-controller="conditional-fields" data-conditional-fields-state-value="<%= { recipient_org_type: nil, receipt_method: @grant.receipt_method || "ach_transfer" }.to_json %>">
    <li>
      <div class="field field--options mx-auto fit">
        <%= form.radio_button :recipient_org_type, "fiscally_sponsored", required: true, data: { conditional_fields_key: "recipient_org_type", action: "change->conditional-fields#update" } %>
        <%= form.label :recipient_org_type, class: "pointer", value: "fiscally_sponsored", style: "grid-area: 1 / 1 / 2 / 3" do %>
          <span class="badge m0 bg-info mb1">
            <%= inline_icon "rep", size: 24, style: "margin: -2px 0px -3px -2px" %>
            Recommended
          </span>
          <strong>Start a new <span class="nowrap">501(c)(3)</span> with us</strong>
          <small>Get set up with a nonprofit fund in minutes.<br />No fees, and no strings attached.</small>
        <% end %>

        <%= form.radio_button :recipient_org_type, "501c3", required: true, data: { conditional_fields_key: "recipient_org_type", action: "change->conditional-fields#update" } %>
        <%= form.label :recipient_org_type, class: "pointer justify-center", value: "501c3" do %>
          <%= inline_icon "payment-docs", size: 28 %>
          <strong>Deposit into an existing <span class="nowrap">501(c)(3)</span> organization</strong>
          <small>Available only in the US.</small>
        <% end %>

        <%= form.radio_button :recipient_org_type, "existing_hcb_account", required: true, data: { conditional_fields_key: "recipient_org_type", action: "change->conditional-fields#update" } %>
        <%= form.label :recipient_org_type, class: "pointer justify-center", value: "existing_hcb_account" do %>
          <%= inline_icon "bank-account", size: 28 %>
          <strong>Deposit into an existing HCB account</strong>
        <% end %>

        <%= form.radio_button :recipient_org_type, "international", required: true, data: { conditional_fields_key: "recipient_org_type", action: "change->conditional-fields#update" } %>
        <%= form.label :recipient_org_type, class: "pointer justify-center", value: "international" do %>
          <%= inline_icon "web", size: 28 %>
          <strong>Deposit into a nonprofit outside the US</strong>
        <% end %>
      </div>
      <div style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","in":["international"]}]' class="card">
        We'll reach out to <strong><%= @grant.recipient.email %></strong> to coordinate receiving the grant internationally.
      </div>
    </li>
    <li style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","present":true},{"key":"recipient_org_type","notIn":["international"]}]'>
      <h3>Organization details</h3>

      <div class="field" style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","present":true},{"key":"recipient_org_type","notIn":["international","existing_hcb_account"]}]'>
        <%= form.label :recipient_organization, "Organization name", data: { conditional_fields_text: [{ key: "recipient_org_type", in: ["501c3"] }].to_json, conditional_fields_text_on: "501(c)(3) organization name", conditional_fields_text_off: "Organization name" } %>
        <%= form.text_field :recipient_organization, data: { conditional_fields_require: [{ key: "recipient_org_type", present: true }, { key: "recipient_org_type", notIn: ["international"] }].to_json } %>
      </div>

      <div class="field" style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","in":["existing_hcb_account"]}]'>
        <%= form.label :event_id, "HCB organization" %>
        <%= form.collection_select :event_id, current_user.events.not_hidden.not_demo_mode, :id, :name, {}, { data: { conditional_fields_require: [{ key: "recipient_org_type", in: ["existing_hcb_account"] }].to_json } } %>
      </div>

      <div class="field field--fileupload" style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","in":["501c3"]}]'>
        <%= form.label :determination_letter, "Upload IRS determination letter", class: "field--fileupload__label" %>
        <%= form.file_field :determination_letter, data: { conditional_fields_require: [{ key: "recipient_org_type", in: ["501c3"] }].to_json }, class: "field--fileupload__field" %>
      </div>
    </li>
    <li style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","in":["501c3"]}]'>
      <h3>Payment method</h3>

      <ul class="tab-container mb2">
        <% [["ach_transfer", "ACH"], ["check", "Mailed check"], ["manual", "Other"]].each do |method, label| %>
          <li class="pointer" data-conditional-fields-class='[{"key":"receipt_method","in":["<%= method %>"]}]' data-conditional-fields-class-name="active"><%= link_to label, "#", data: { action: "conditional-fields#assign:prevent", conditional_fields_assign_key_param: "receipt_method", conditional_fields_assign_value_param: method } %></li>
        <% end %>
      </ul>

      <%= form.hidden_field :receipt_method, data: { conditional_fields_value: "receipt_method" } %>

      <div data-conditional-fields-when='[{"key":"receipt_method","in":["ach_transfer"]}]'>
        <%= render "ach_transfer_form", form: %>
      </div>

      <div data-conditional-fields-when='[{"key":"receipt_method","in":["check"]}]'>
        <%= render "check_form", form: %>
      </div>

      <div data-conditional-fields-when='[{"key":"receipt_method","in":["manual"]}]' class="card">
        We'll reach out to <strong><%= @grant.recipient.email %></strong> to coordinate a custom payment method.
      </div>
    </li>
    <%# <li data-conditional-fields-when='[{"key":"recipient_org_type","present":true}]'>
      <h3>Sign the contract</h3>
      <p>TODO actually sign contract</p>
    </li> %>
    <li style="display: none;" data-conditional-fields-when='[{"key":"recipient_org_type","present":true}]'>
      <button class="btn" data-conditional-fields-text='[{"key":"recipient_org_type","in":["fiscally_sponsored","existing_hcb_account"]}]' data-conditional-fields-text-on="Receive grant" data-conditional-fields-text-off="Submit">Submit</button>
    </li>
  </ul>
<% end %>
