<% title "My receipts" %>
<% page_md %>
<%= render "users/nav", selected: :receipts %>

<h1 class="heading border-0 mb-0">
  <span>
    Receipts
  </span>
</h1>

<% if Flipper.enabled?(:card_locking_2025_06_09, current_user) %>
  <%= render "application/callout", class: "mt-2", type: "info", title: "Card locking", badge: badge_for("Beta", class: "bg-muted") do %>
    <p class="my-0">
      Upload a receipt within <strong>7 days</strong> of every card charge. Miss it and your cards pause until you upload. Uploading unlocks them in seconds. Your cards are currently <strong class="<%= current_user.cards_locked? ? "error" : "success" %>"><%= current_user.cards_locked? ? "locked" : "active" %></strong>.
    </p>
  <% end %>
<% end %>

<section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-1">
  <div class="flex flex-col">
    <label for="sms_number">Send in via SMS</label>
    <p class="h5 muted mt0 mb1">
      Message photos from your phone.
    </p>
    <div class="relative block mt-auto flex gap-2" data-controller="clipboard" data-clipboard-text-value="+1-864-548-4225">
      <input id="sms_number" type="tel" value="+1-864-548-4225" readonly style="cursor: text;" class="fit select-all">
      <button
        type="button"
        class="pointer pop align-middle tooltipped tooltipped--n"
        aria-label="Copy number"
        data-action="clipboard#copy:prevent">
        <%= inline_icon "copy", size: 28 %>
      </button>
    </div>
  </div>

  <%= form_for current_user do |form| %>
    <%= form.label :receipt_identifier, "Send in via email" %>
    <p class="h5 muted mt0 mb1">
      Send from in-store terminals, or forward emails later.
    </p>

    <%= turbo_frame_tag "mailbox_address" do %>
      <% if @mailbox_address %>
        <%= render @mailbox_address %>
      <% else %>
        <%= link_to "Choose an email address",
            mailbox_addresses_path,
            class: "btn btn-small pl2 pr2",
            data: { turbo: true, "turbo-method" => "post" } %>
      <% end %>
    <% end %>
  <% end %>
</section>

<%= turbo_stream_from current_user, :receipt_bin %>
<%= turbo_frame_tag "suggested_pairings", src: suggested_pairings_path %>

<div class="mt2 mb3">
  <%= render partial: "receipts/form_v3", locals: {
        upload_method: "receipt_center",
        restricted_dropzone: true,
        turbo: true,
        global_paste: true
      } %>
</div>

<%= render partial: "receipts/blankslate", locals: { count: @receipts.size } %>

<ul class="grid grid--medium-narrow text-left w-100 mt0" id="receipts_list">
  <% @receipts.each do |receipt| %>
    <li class="flex grid flex-col justify-between h-100 mx-auto" id="receipt_<%= receipt.id %>">
      <%= render partial: "receipts/receipt", locals: { receipt:, show_delete_button: true, show_reimbursements_button: true, link_to_file: true, turbo_for_deletion: true } %>
    </li>
  <% end %>
</ul>

<h2 class="flex items-center mb2">
  Transactions
  <% if Flipper.enabled?(:card_locking_2025_06_09, current_user) %>
    <%= badge_for(pluralize(@count, "missing receipt")) %>
    <%= badge_for(pluralize(@locking_count, "overdue receipt")) %>
  <% else %>
    <%= badge_for(@count) %>
  <% end %>
</h2>

<% if @count > 0 && @groupable_by_due_date %>
  <ul class="tab-container mt-0 mb2">
    <% { "due_date" => "By due date", "card" => "By card", "flat" => "Newest first" }.slice("due_date", @alternate_grouping).each do |grouping, label| %>
      <%= settings_tab active: @grouping == grouping do %>
        <%# Switching the grouping invalidates the page number, so drop it. %>
        <%= link_to label,
                    my_inbox_path(request.query_parameters.except("page", "group").merge("group" => grouping)),
                    data: { turbo: true, turbo_action: "advance" } %>
      <% end %>
    <% end %>
  </ul>
<% end %>

<% if @grouping == "due_date" %>
  <% @due_date_groups.each do |group, hcb_codes| %>
    <% style = receipt_due_group_style(group, now: @now) %>
    <section class="mb3 card p0 receipt-card">
      <h2 class="heading leading-[1.5] p1 pl2 mt0 ml0 flex justify-between items-center gap-2">
        <span class="flex items-center gap-2">
          <%= inline_icon style[:icon], size: 25, class: style[:icon_class] %>
          <%= receipt_due_group_label(group, now: @now) %>
        </span>

        <%# When a group spills onto other pages, say so rather than repeating
            the same total above a partial list. %>
        <% total = @due_date_group_counts[group] %>
        <%= badge_for hcb_codes.size == total ? pluralize(total, "transaction") : "#{hcb_codes.size} of #{total} transactions", class: style[:badge_class] %>
      </h2>

      <%= render "my/missing_receipt_transactions", hcb_codes:, show_event_name: true %>
    </section>
  <% end %>
<% elsif @grouping == "card" %>
  <% @cards.each do |card| %>
    <section class="mb3 card p0 receipt-card">
      <h2 class="heading leading-[1.5] p1 pl2 mt0 ml0 flex justify-between items-center">
        <%= link_to card.event.name, event_path(card.event), class: "no-underline" %>

        <%= link_to card, class: "regular h3 mention flex items-center" do %>
          <%= inline_icon "card", class: "mr1", size: 25 %>
          <%= card.last_four %>
        <% end %>
      </h2>

      <%# The org is already in this section's header, so it isn't repeated per row. %>
      <%= render "my/missing_receipt_transactions", hcb_codes: @card_hcb_codes[card.to_global_id.to_s] %>
    </section>
  <% end %>
<% else %>
  <section class="mb3 card p0 receipt-card">
    <%= render "my/missing_receipt_transactions", hcb_codes: @hcb_codes, show_event_name: true %>
  </section>
<% end %>

<% if @count == 0 %>
  <%= blankslate "No missing receipts!" %>
<% end %>

<style>
  @media (min-width: 72em) {
    .receipt-card {
      max-width: calc(100vw - 20rem);
    }
  }
</style>

<%= paginate @hcb_codes %>
