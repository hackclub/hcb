<% title "My cards" %>
<% page_md %>
<%= render "users/nav", selected: :cards %>
<% @show_card_popovers = Flipper.enabled?(:hcb_code_popovers_2023_06_16, current_user) && organizer_signed_in? %>
<% if @stripe_cards.any? || current_user(allow_unverified: true).verified? %>
  <h1 class="heading flex items-center flex-col sm:flex-row border-0 mb-0">
    <span class="flex items-center">
      Cards
      <%= badge_for @stripe_cards.active.count + @emburse_cards.count, class: "bg-muted" %>
    </span>
    <div class="flex ml-auto gap-3 items-center -mt-3">
      <%= pop_icon_to @view == "list" ? "grid" : "list",
                      upsert_query_params("view" => @view == "list" ? "grid" : "list"),
                      class: "mb-1 tooltipped tooltipped--s",
                      aria: { label: @view == "list" ? "Grid view" : "List view" },
                      data: { turbo_prefetch: "false" } %>
      <button class="btn bg-success mb-1" data-behavior="modal_trigger" data-modal="order_card" <%= "disabled" if current_user.events.not_demo_mode.where.not(id: current_user.reader_events).none? %>>
        <%= inline_icon "card-add" %>
        Order a card
      </button>
    </div>
  </h1>
  <div class="flex items-center gap-2 mt-2">
    <%= form_with(model: false, local: true, method: :get, class: "flex-1") do |form| %>
      <%= hidden_field_tag :status, @status if @status %>
      <%= hidden_field_tag :type, @type if @type %>
      <%= render "events/filters/search", form: %>
    <% end %>
    <% if @filter_applied %>
      <%= render partial: "my/cards_filter_menu" %>
      <%= link_to upsert_query_params("status" => nil, "type" => nil, "q" => nil), class: "pop muted tooltipped tooltipped--s", aria: { label: "Clear filters" }, data: { turbo_prefetch: "false" } do %>
        <%= inline_icon "view-close", size: 28 %>
      <% end %>
    <% else %>
      <%= render partial: "my/cards_filter_menu" %>
    <% end %>
  </div>
  <% if @filter_applied %>
    <div class="filter-menu__chips mt-1">
      <% if @status %>
        <div class="badge badge-large bg-muted">
          <%= @status.humanize %>
          <%= link_to upsert_query_params("status" => nil), class: "flex items-center", data: { turbo_prefetch: "false" } do %>
            <%= inline_icon "view-close", size: 20 %>
          <% end %>
        </div>
      <% end %>
      <% if @type %>
        <div class="badge badge-large bg-muted">
          <%= @type.humanize %>
          <%= link_to upsert_query_params("type" => nil), class: "flex items-center", data: { turbo_prefetch: "false" } do %>
            <%= inline_icon "view-close", size: 20 %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="order_card">
    <%= modal_header "Order a card" %>
    <%= render "stripe_cards/form", stripe_card: StripeCard.new %>
  </section>
  <%= turbo_frame_tag :my_cards_shipping, src: my_cards_shipping_path, target: "_top" %>
  <% if @events.any? %>
    <% @events.each do |event| %>
      <section class="mt-3">
        <div class="flex items-center gap-2">
          <% can_view_event = policy(event).card_overview? %>
          <%= content_tag can_view_event ? :a : :div, href: (event_cards_overview_path(event_id: event.slug) if can_view_event), class: "flex items-center gap-2 text-decoration-none text-inherit flex-1 min-w-0 h3" do %>
            <% if event.logo.attached? %>
              <%= image_tag event.logo, height: 24, width: 24, class: "rounded flex-shrink-0" %>
            <% end %>
            <span class="eyebrow truncate"><%= event.name %></span>
            <%= badge_for @card_counts[event.id], class: "bg-muted flex-shrink-0 mx-0" %>
            <div class="menu__divider flex-1 ml-2"></div>
          <% end %>
        </div>
        <%= turbo_frame_tag dom_id(event, :my_cards), src: my_event_cards_path(event_id: event.id, **request.query_parameters.slice("q", "status", "type").symbolize_keys), loading: :lazy, target: "_top" do %>
          <div class="card card--breakdown p-0 relative <%= "mt-2" if @view == "list" %>" aria-busy="true">
            <%# Invisible placeholders size the card to match the loaded cards %>
            <% if @view == "list" %>
              <div class="flex flex-col gap-2 invisible" aria-hidden="true">
                <% @card_counts[event.id].times do %>
                  <div class="h-10"></div>
                <% end %>
              </div>
            <% else %>
              <div class="mixed-grid grid--spacious invisible" aria-hidden="true">
                <% @card_counts[event.id].times do %>
                  <div class="mt1 aspect-[364/224]"></div>
                <% end %>
              </div>
            <% end %>
            <%= render partial: "application/loading_container", locals: { klass: "absolute inset-0" } %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <%= blankslate "No cards found!" %>
  <% end %>
  <%= turbo_frame_tag :my_missing_receipts_list, src: my_missing_receipts_list_path, target: "_top" %>
  <% if @emburse_cards.any? %>
    <details class="mt3">
      <summary>
        <h2 class="inline-block mt0">Emburse cards</h2>
      </summary>
      <article class="grid">
        <%= render @emburse_cards, headless: true %>
      </article>
    </details>
  <% end %>
<% else %>
 <%= render "events/one_pager",
    title: "Cards",
    support_article: "https://help.hcb.hackclub.com/en/articles/15410085-hcb-cards-how-to-order-activate-and-use-them",
    screenshots: {
      light: "https://user-cdn.hackclub-assets.com/019c3c72-e7a5-7cf8-b207-f03b9071a748/hcb.hackclub.com_hq_cards%20(1).png",
      dark: "https://cdn.hackclub.com/019c3c73-25d9-79b3-b1ae-08bc8e7cb88b/hcb.hackclub.com_hq_cards.png"
    },
    hints: [
      {
        icon: "card",
        title: "Order physical and virtual cards",
        description: "Easily order physical and virtual cards for your organization to streamline spending and manage expenses."
      },
      {
        icon: "view",
        title: "Control spending with ease",
        description: "Set spending limits and monitor transactions in real-time to ensure responsible use of funds."
      },
      {
        icon: "docs",
        title: "Simplify expense tracking",
        description: "Automatically categorize and track expenses, making budgeting and financial reporting a breeze."
      }
    ] do %>
    <%= link_to auth_users_path(return_to: my_cards_path), class: "btn" do %>
      <%= inline_icon "email" %>
      Verify your email first
    <% end %>
    <% content_for :caption do %>
      <span class="text-sm text-muted">See <a href="https://hcb.hackclub.com/hq/cards" target="_blank" class="underline">how we utilize cards on HQ!</a></span>
    <% end %>

  <% end %>
<% end %>
