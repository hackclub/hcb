<% title "My reimbursements" %>
<% page_md %>
<%= render "users/nav", selected: :reimbursements %>

<% if current_user(allow_unverified: true).verified? %>
  <h1 class="heading flex-col sm:flex-row border-0 mb-0">
    <span>
      Reimbursements
    </span>

    <div class="flex sm:ml-auto gap-2 items-center flex-wrap justify-center">
      <% if @payout_method.present? %>
        <%= link_to settings_payouts_path, class: "!ml-0 btn bg-info" do %>
          <%= inline_icon "bank-account" %>
          Payout settings
        <% end %>
      <% else %>
        <%= link_to settings_payouts_path, class: "!ml-0 btn" do %>
          <%= inline_icon "bank-account" %>
          Configure payouts
        <% end %>
      <% end %>

      <% if current_user.events.not_demo_mode.any? %>
        <%= link_to "#", class: "!ml-0 btn bg-success", data: { behavior: "modal_trigger", modal: "create_reimbursement_report" } do %>
          <%= inline_icon "plus" %>
          Start report
        <% end %>
      <% else %>
        <span class="tooltipped tooltipped--n tooltipped--xl inline-block" aria-label="You aren't a member of any HCB organization, so you'll need to be invited to start a reimbursement report.">
          <button class="!ml-0 btn bg-success" disabled>
            <%= inline_icon "plus" %>
            Start report
          </button>
        </span>
      <% end %>
    </div>
  </h1>

  <%= render partial: "reimbursement/reports/create_form" %>

  <% if current_user.events.not_demo_mode.any? %>
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-1">
      <div>
        <label for="sms_number">Start a report via SMS</label>
        <p class="h5 muted mt0 mb1">
          Message photos from your phone.
        </p>
        <div class="flex gap-2" data-controller="clipboard" data-clipboard-text-value="+1-864-548-4225">
          <input id="sms_number" type="tel" value="+1-864-548-4225" readonly style="cursor: text;" class="fit">
          <button
            type="button"
            class="pointer pop tooltipped tooltipped--n"
            aria-label="Copy number"
            data-action="clipboard#copy:prevent">
            <%= inline_icon "copy", size: 28 %>
          </button>
        </div>
      </div>

      <div>
        <label for="email_address">Start a report via email</label>
        <p class="h5 muted mt0 mb1">
          Send or forward from your email address.
        </p>
        <div class="flex gap-2" data-controller="clipboard" data-clipboard-text-value="reimburse@hcb.gg">
          <input id="email_address" type="email" value="reimburse@hcb.gg" readonly style="cursor: text;" class="fit font-mono">
          <button
            type="button"
            class="pointer pop tooltipped tooltipped--n"
            aria-label="Copy email address"
            data-action="clipboard#copy:prevent">
            <%= inline_icon "copy", size: 28 %>
          </button>
        </div>
      </div>
    </section>
  <% end %>

  <div class="mt3">
    <%= form_with(model: false, local: true, method: :get) do |form| %>
      <%= render "events/filters/search", form: %>
    <% end %>
  </div>

  <% if @sections[:assigned].exists? %>
    <h3 class="mt3 mb1">Assigned to you for review</h3>
    <%= turbo_frame_tag :my_reimbursements_assigned, src: my_reimbursements_section_path(:assigned, q: params[:q].presence) do %>
      <p class="muted">Loading reports…</p>
    <% end %>
  <% end %>

  <% if @sections[:unassigned].exists? %>
    <h3 class="mt3 mb1">Awaiting review by any manager</h3>
    <%= turbo_frame_tag :my_reimbursements_unassigned, src: my_reimbursements_section_path(:unassigned, q: params[:q].presence) do %>
      <p class="muted">Loading reports…</p>
    <% end %>
  <% end %>

  <h3 class="mt3 mb1">Your reports</h3>
  <%= turbo_frame_tag :my_reimbursements_mine, src: my_reimbursements_section_path(:mine, q: params[:q].presence) do %>
    <p class="muted">Loading reports…</p>
  <% end %>
<% else %>
 <%= render "events/one_pager",
      title: "Reimbursements",
      support_article: "https://help.hcb.hackclub.com/en/articles/15410232-how-do-i-request-a-reimbursement",
      screenshots: {
        light: "https://user-cdn.hackclub-assets.com/019c3c7a-827e-779a-80bd-505c00c0f793/hcb.hackclub.com_hq_reimbursements.png",
        dark: "https://user-cdn.hackclub-assets.com/019c3c7a-6f5b-7e30-aada-7f7ee823679e/hcb.hackclub.com_hq_reimbursements%20(1).png"
      },
      hints: [
        {
          icon: "send",
          title: "Manage out-of-pocket expenses",
          description: "Easily track and reimburse expenses incurred by your team members during events."
        },
        {
          icon: "payment",
          title: "Four different methods",
          description: "Reimburse via ACH, mailed checks, Wise, or Wire transfers to suit your team's needs."
        },
        {
          icon: "copy",
          title: "Upload receipts",
          description: "Organize and store expense receipts to track each expense easily."
        }
      ] do %>
      <%= link_to auth_users_path(return_to: my_reimbursements_path), class: "btn" do %>
        <%= inline_icon "email" %>
        Verify your email first
      <% end %>
  <% end %>
<% end %>
