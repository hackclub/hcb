<%# locals: () %>
<%# herb:slots client %>
<%# herb:state (selected_tab: "status") %>
<%# Rendered inside the filter menu's content, which the menu clones when it opens, so each
    opening starts again at the Status tab. %>

<div>
  <button type="button" class="filter-tab" aria-current="<%= selected_tab == "status" %>" data-herb-set="selected_tab=status">Status</button>
  <button type="button" class="filter-tab" aria-current="<%= selected_tab == "type" %>" data-herb-set="selected_tab=type">Type</button>
  <div class="menu__divider--filter-tab"></div>

  <div hidden="<%= selected_tab != "status" %>">
    <% %w[active inactive frozen canceled].each do |status| %>
      <%= link_to status.humanize, upsert_query_params(status:), class: "flex-auto menu__action !border-t-0 #{"menu__action--active" if @status == status}", data: { turbo_prefetch: "false" } %>
    <% end %>
  </div>

  <div hidden="<%= selected_tab != "type" %>">
    <% %w[virtual physical].each do |type| %>
      <%= link_to type.humanize, upsert_query_params(type:), class: "flex-auto menu__action !border-t-0 #{"menu__action--active" if @type == type}", data: { turbo_prefetch: "false" } %>
    <% end %>
  </div>
</div>
