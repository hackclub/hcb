<%= turbo_frame_tag :my_missing_receipts_list do %>
  <% if @missing %>
    <section class="card p0 mt3 mb3">
      <h2 class="heading h2 leading-[1.25] mt0 ml0 pt1 pb1 pl2 pr2">
        Charges missing receipts
        <%= link_to my_inbox_path, class: "btn" do %>
          <%= inline_icon "view" %>
          See all
        <% end %>
      </h2>

      <div class="table-container">
        <table class="table-container">
          <thead>
            <tr>
              <th></th>
              <th class="hidden sm:table-cell">Date</th>
              <th>Description</th>
              <th class="text-right">Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody data-behavior="transactions">
            <%= render partial: "ledger/item", collection: @missing, as: :item, locals: { show_author: false, receipt_upload_button: true } %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
<% end %>
