<%= turbo_frame_tag :my_missing_receipts_list do %>
  <% if @missing %>
    <section class="card p0 mt3 mb3">
      <h2 class="heading h2 leading-[1.25] mt0 ml0 pt1 pb1 pl2 pr2">
        Charges missing receipts
        <%= link_to my_inbox_path, class: "btn" do %>
          <%= inline_icon "view" %>
          See all
        <% end %>
      </h2>

      <%# Already inside the my_missing_receipts_list frame, and @missing isn't paginated. %>
      <%= render "ledgers/ledger", items: @missing, frame_id: nil, show_pagination: false, show_author: false, receipt_upload_button: true %>
    </section>
  <% end %>
<% end %>
