<%# locals: (reports:) %>

<%# Each section of My reimbursements is its own table. A fixed layout keeps their columns lined up: Report takes the leftover width, everything else is pinned. %>
<article class="table-container">
  <table class="table-fixed min-w-[52rem]">
    <thead>
    <tr>
      <th class="w-12"></th>
      <th class="w-40">Status</th>
      <th>Report</th>
      <th class="w-52">Organization</th>
      <th class="w-32">Amount</th>
      <th class="w-36">Created</th>
    </tr>
    </thead>
    <tbody>
      <% reports.each do |report| %>
        <tr class="clickable">
          <td class="flex items-center justify-center" style="margin-top: 1px;">
            <%= avatar_for report.user, size: 24 %>
          </td>
          <td>
            <% if report.status_description %>
              <span class="ml0 badge bg-<%= report.status_color %> tooltipped tooltipped--e tooltipped--xl" aria-label="<%= report.status_description %>">
                <%= report.status_text %>
              </span>
            <% else %>
              <span class="ml0 badge bg-<%= report.status_color %>"><%= report.status_text %></span>
            <% end %>
          </td>
          <td class="truncate">
            <%= link_to "", report, class: "stretched-link", data: { turbo_frame: "_top" } %>
            <span><%= report.name %></span>
          </td>
          <td class="truncate">
            <%= report.event&.name || "None" %>
          </td>
          <td>
            <%= report.amount.format %>
          </td>
          <td>
            <%= format_date report.created_at %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>
