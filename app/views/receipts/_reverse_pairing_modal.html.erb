<%# locals: (receipt_id:) %>

<%= modal "Reverse receipt pairing", id: "reverse_receipt_modal", class: "max-w-md", open: true do %>
  <p>Are you sure you would like to reverse the receipt pairing for this transaction?</p>

  <%= button_to "Yes", reverse_receipt_path(receipt_id, format: :html), class: "left bg-success btn", method: :post %>
  <a href="#" class="right bg-error btn" data-modal-close>No</a>
<% end %>
