<%# locals: (preview_label:, details_label:, preview:, details:) %>
<%# herb:slots client %>
<%# herb:state (selected_tab: "preview") %>
<%# The phone layout of a receipt or invoice modal: tabs between the file and its details.
    `preview` and `details` are the panels' markup, captured by the caller. %>

<div class="w-100 h-100 overflow-hidden flex md:hidden flex-col md:flex-row md:min-h min-h-min">
  <ul class="tab-container m-0 mt-2">
    <li class="cursor-pointer ml-3" data-controller="scroll-into-view">
      <a aria-current="<%= selected_tab == "preview" %>" data-herb-set="selected_tab=preview"><%= preview_label %></a>
    </li>
    <li class="cursor-pointer" data-controller="scroll-into-view">
      <a aria-current="<%= selected_tab == "details" %>" data-herb-set="selected_tab=details"><%= details_label %></a>
    </li>
    <div class="flex-grow">
      <a href="#close_modal" tabindex="0" class="pop modal__close muted" rel="modal:close" style="background: #11111199; margin: 0px; margin-right: 6px;">
        <%= inline_icon "view-close", size: 28, class: "pop modal__close muted  m0" %>
      </a>
    </div>
  </ul>

  <div class="contents" hidden="<%= selected_tab != "preview" %>">
    <%= preview %>
  </div>

  <div class="contents" hidden="<%= selected_tab != "details" %>">
    <div style="padding: 1.5rem; border-radius: 0rem 0rem 0.75rem 0.75rem; height: 100vh; flex-direction: column;" class="bg-white dark:bg-dark md:w-[20rem] w-100">
      <%= details %>
    </div>
  </div>
</div>
