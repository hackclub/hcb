<%# locals: (event:, destination: "payments") %>
<%# herb:slots client %>
<%# The picker always opens in contractor mode; the buttons at the bottom switch
    to entering the recipient's payout details on their behalf. %>
<%# herb:state (selected_mode: "contractor") %>
<% has_payees = event.payees.any? %>
<% show_hcb_transfer = destination == "payments" %>

<div>
  <div data-payee-picker-target="defaultPanel" class="py-2" <% unless has_payees %> hidden<% end %>>
    <% if has_payees %>
      <%= turbo_frame_tag :payee_results, src: event_payees_path(event_id: event.slug, payee_id: params[:payee_id], destination:) do %>
        <%= render "application/loading_container", klass: "py-8" %>
      <% end %>
    <% end %>

    <%= render "payments/hcb_transfer_option", event: event if show_hcb_transfer && has_payees %>
  </div>

  <div data-payee-picker-target="addingPanel" <% if has_payees %> hidden<% end %>
       data-controller="payee-duplicate-check"
       data-payee-duplicate-check-url-value="<%= check_email_event_payees_path(event_id: event.slug) %>"
       data-payee-duplicate-check-destination-value="<%= destination %>">
    <div class="px-4 py-3 card">
      <% if has_payees %>
        <button type="button" class="btn mb-3" data-action="payee-picker#hideAdding">
          <%= inline_icon "view-back" %>
          Back
        </button>
      <% end %>

      <%# The recipient's name/email/type live in this form (associated via form:) and
          submit to PayeesController on Continue. On the manual path this also creates a
          managed legal entity, then the page reloads with ?payee_id= selected. %>
      <%= form_with(url: event_payees_path(event_id: event.slug), local: true, id: "new-payee-form", html: { class: "contents" }) do %>
        <%= hidden_field_tag :destination, destination %>
        <input type="hidden" name="manual" value="true" disabled="<%= selected_mode != "manual" %>">
      <% end %>

      <div class="flex flex-col gap-3">
        <div class="flex justify-between flex-col sm:flex-row sm:items-center gap-2">
          <%= label_tag :name, class: "flex gap-2 items-center" do %>
            Name
            <span class="info tooltipped tooltipped--e h-5" aria-label="<%= "Visible in transparency mode. " if event.is_public? %>This does not have to match the recipient's legal name.">
              <%= inline_icon "info", size: 20 %>
            </span>
          <% end %>
          <%= text_field_tag :name, params[:payee_name], placeholder: "Orpheus", required: true, form: "new-payee-form", data: { "payee-picker-target": "nameInput" } %>
        </div>
        <div class="flex justify-between flex-col sm:flex-row items-center gap-2">
          <%= label_tag :email, "Email" %>
          <%= email_field_tag :email, params[:payee_email], placeholder: "orpheus@hackclub.com", required: true, form: "new-payee-form", data: { "payee-picker-target": "emailInput", action: "input->payee-duplicate-check#check" } %>
        </div>

        <div data-payee-duplicate-check-target="warning" hidden>
          <%= render "application/callout", type: "warning", title: "You already have a recipient with this email", class: "mt-0 mb-0" do %>
            This email is already used by <span data-payee-duplicate-check-target="list"></span>.
            Only add a new recipient if this is a different person or legal entity.
          <% end %>
        </div>
        <fieldset class="contents" hidden="<%= selected_mode != "manual" %>" disabled="<%= selected_mode != "manual" %>">
          <div class="flex justify-between flex-col sm:flex-row items-center gap-2">
            <%= label_tag :payee_entity_type, "Recipient type" %>
            <%= select_tag :payee_entity_type,
                options_for_select([
                                     ["Select type", ""],
                                     ["An individual", "person"],
                                     ["An unincorporated business", "business"],
                                     ["A corporation", "corporation"]
                                   ], params[:payee_entity_type]),
                required: true,
                form: "new-payee-form" %>
          </div>
        </fieldset>

        <div hidden="<%= selected_mode == "manual" %>">
          <%= render "application/callout", type: "info", title: "HCB will email the recipient", class: "mt-0 mb-0" do %>
            They'll be asked to configure their payout method and tax information if necessary before receiving the payment.
          <% end %>
        </div>

        <div hidden="<%= selected_mode != "manual" %>">
          <%= render "application/callout", type: "warning", icon: "important", title: "Payout info required", class: "mt-0 mb-0" do %>
            We'll ask for this soon. Only use this if the recipient can't submit their own.
          <% end %>
        </div>

          <button type="submit" form="new-payee-form" class="btn bg-blue w-full gap-2 mt-3">
            Continue <%= inline_icon "view-forward" %>
          </button>
          <% if Flipper.enabled?(:manual_payees_2026_08_05, event) %>
            <button type="button" class="!shadow-none btn w-full text-sm font-[500] mt-1" hidden="<%= selected_mode == "manual" %>" data-herb-set="selected_mode=manual">
              I want to submit payout information on behalf of the recipient
            </button>
            <button type="button" class="!shadow-none btn w-full text-sm mt-1" hidden="<%= selected_mode != "manual" %>" data-herb-set="selected_mode=contractor">
              I'll have the recipient fill this out instead
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <%= render "payments/hcb_transfer_option", event: event if show_hcb_transfer && !has_payees %>
  </div>
