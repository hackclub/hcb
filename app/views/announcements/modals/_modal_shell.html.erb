<%# locals: (type:, block: nil, header: "") %>

<%= modal header, id: block ? dom_id(block, :edit) : "insert_#{type.underscore}_modal", class: "min-w-[50%]", open: block.present?,
                  data: { controller: "announcement-modal", announcement_modal_tiptap_outlet: "#announcement-form", announcement_modal_block_id_value: block&.id } do %>
  <div class="flex flex-col gap-4">
    <div class="error-card mb-0 hidden">
      <p data-announcement-modal-target="errors"></p>
    </div>

    <%= yield %>

    <button type="button" class="btn w-fit" data-action="announcement-modal#<%= type %>"><%= block.present? ? "Edit" : "Add" %></button>
  </div>
<% end %>
