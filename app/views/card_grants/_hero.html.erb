<%# locals: (card_grant:, footer: nil, actions: true) %>

<% own = card_grant.user == current_user %>
<% total = card_grant.amount %>
<% remaining = card_grant.balance %>
<% remaining_fraction = total.positive? ? [[remaining.cents.to_f / total.cents, 0].max, 1].min : 0 %>
<% days_left = (card_grant.expiration_at.to_date - Date.current).to_i %>
<% spendable = card_grant.active? && !card_grant.pending_invite? %>

<% manage = actions && organizer_signed_in?(as: :member) %>

<% if manage %>
  <div class="flex items-center flex-wrap justify-end gap-2 mt-4">
    <%= render "card_grants/actions/edit", card_grant: %>
  </div>
<% end %>

<section class="card card--background-image grant-hero <%= manage ? "mt-2" : "mt-4" %>"
         style="<%= card_grant.event.background_image.attached? ? "--bg-image: url(#{url_for(card_grant.event.background_image).dump})" : "--bg-image: #{GeoPattern.generate(card_grant.stripe_card&.public_id || card_grant.public_id).to_data_uri}" %>">
  <div class="grant-hero__grid">
    <div>
      <div class="flex items-center flex-wrap gap-x-3 gap-y-2 mb-1">
        <span class="badge ml-0 bg-<%= card_grant.status_badge_type %>">
          <%= card_grant.state_text %>
        </span>
        <% if card_grant.purpose.present? %>
          <span class="muted"><%= card_grant.purpose %></span>
        <% end %>
      </div>

      <span class="grant-hero__amount"><%= render_money remaining %></span>
      <p class="mt-1 mb-3 muted">
        <%= remaining == total ? "to spend" : "left of #{render_money total}" %>
      </p>

      <div class="grant-meter">
        <span class="grant-meter__fill <%= "grant-meter__fill--muted" unless spendable %>"
              style="width: <%= number_to_percentage(remaining_fraction * 100, precision: 2) %>"></span>
      </div>
    </div>

    <div class="grant-hero__aside">
      <p class="eyebrow m-0">
        <%= own ? "Spend it by" : "Expires on" %>
      </p>
      <div class="flex items-baseline flex-wrap gap-x-2">
        <p class="grant-hero__date"><%= format_date card_grant.expiration_at %></p>
        <span class="muted">
          <% if days_left.positive? %>
            <%= pluralize days_left, "day" %> left
          <% elsif days_left.zero? %>
            today
          <% else %>
            <%= pluralize days_left.abs, "day" %> ago
          <% end %>
        </span>
      </div>

      <div class="grant-meta mt-2">
        <div>
          <span class="muted grant-meta__label">Granted by</span>
          <%= link_to card_grant.event.name, card_grant.event, class: "grant-meta__value" %>
        </div>
        <div>
          <span class="muted grant-meta__label">Granted to</span>
          <%= user_mention card_grant.user, class: "grant-meta__value" %>
        </div>
        <div>
          <span class="muted grant-meta__label">Sent</span>
          <span class="grant-meta__value tooltipped tooltipped--w" aria-label="<%= card_grant.created_at.to_formatted_s(:long) %>">
            <%= time_ago_in_words card_grant.created_at %> ago
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
<% if footer.present? %>
  <div class="card mt-2">
    <%= footer %>
  </div>
<% end %>
