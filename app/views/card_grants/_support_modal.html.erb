<%# locals: (card_grant:) %>

<%# The organization's support message. Rendered once per page; every "contact
    the organization" button on it opens this same modal. %>

<% setting = card_grant.setting %>

<% if setting.support_message.present? %>
  <%= modal "Get support for your card grant", id: "support_card_grant_#{card_grant.id}" do %>
    <%= MarkdownService.instance.render(setting.support_message) %>

    <% if setting.support_url.present? %>
      <footer class="modal__action-row pt1 flex justify-end sticky bottom-0 mt2" style="border-top: none;">
        <div>
          <%= link_to setting.support_url, target: "_blank", rel: "noopener", class: "btn btn--primary" do %>
            <% if setting.slack_support? %>
              <%= inline_icon "slack" %>
              Contact <%= card_grant.event.name %> on Slack
            <% elsif setting.email_support? %>
              <%= inline_icon "email" %>
              Email <%= card_grant.event.name %>
            <% else %>
              <%= inline_icon "link" %>
              Get support
            <% end %>
          <% end %>
        </div>
      </footer>
    <% end %>
  <% end %>
<% end %>
