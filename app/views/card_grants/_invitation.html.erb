<%# locals: (card_grant:) %>

<% if card_grant.pending_invite? %>
  <%# Prompt user to create a Stripe Card %>
  <h2 class="grant-section">Activate your grant card</h2>
  <p class="muted mt-0 mb-3">
    One more step before you can start spending: agree to the following and we'll issue your card.
  </p>

  <%= form_with url: activate_card_grant_path(card_grant), class: "card grant-pledge" do |form| %>
    <%= form.label :purpose, class: "grant-pledge__row" do %>
      <%= form.check_box :purpose, required: true %>
      <span>
        I will only use this card for the intended purpose
        <% if card_grant.purpose.present? %>
          (<strong><%= card_grant.purpose %></strong>)
        <% end %>
        and adhere to the instructions provided by <%= card_grant.event.name %><%= " above" if card_grant.instructions.present? %>
      </span>
    <% end %>

    <%= form.label :policy, class: "grant-pledge__row" do %>
      <%= form.check_box :policy, required: true %>
      <span>
        I will abide by the <%= link_to "Code of Conduct", "https://hackclub.com/conduct", target: :_blank %> and understand that fraudulent activity will result in a ban
      </span>
    <% end %>

    <%= form.label :terms, class: "grant-pledge__row" do %>
      <%= form.check_box :terms, required: true %>
      <span>
        I agree to the <%= link_to "Card Issuing Terms", "https://stripe.com/legal/issuing/celtic-authorized-user-terms", target: :_blank %>
      </span>
    <% end %>

    <div class="grant-pledge__footer">
      <p class="m-0 muted">Your virtual card is ready to use as soon as you activate it.</p>
      <%= form.submit "Start spending", class: "btn bg-success" %>
    </div>
  <% end %>
<% end %>
