<%# locals: (icon:, title:, description:, cta:, tone: "muted", external: false) %>

<%# Body of one row in the grant controls list. The row itself is the button or link, so everything in here is inline. %>
<span class="grant-action__icon grant-action__icon--<%= tone %>"><%= inline_icon icon, size: 22 %></span>
<span class="grant-action__text">
  <span class="grant-action__title"><%= title %></span>
  <span class="grant-action__desc"><%= description %></span>
</span>
<span class="grant-action__cta">
  <%= cta %>
  <% if external %>
    <%= inline_icon "external", size: 16 %>
  <% else %>
    <span class="grant-action__chevron" aria-hidden="true"></span>
  <% end %>
</span>
