<%# locals: (card_grant:, title: "Need help?") %>

<%# The organization's support channel as a control row. The modal it may open
    comes from `card_grants/support_modal`, rendered once by the page. %>

<% setting = card_grant.setting %>

<% if setting.support? %>
  <% support_description = if setting.support_message.present?
                             "Get in touch with #{card_grant.event.name} for support"
                           elsif setting.slack_support?
                             "Contact #{card_grant.event.name} on Slack"
                           elsif setting.email_support?
                             "Email #{card_grant.event.name} for support"
                           else
                             "Get in touch with #{card_grant.event.name} for support"
                           end %>
  <% support_icon = if setting.support_message.present?
                      "support"
                    elsif setting.slack_support?
                      "slack"
                    elsif setting.email_support?
                      "email"
                    else
                      "support"
                    end %>

  <% if setting.support_message.present? %>
    <button type="button" class="grant-action grant-tone--info" data-behavior="modal_trigger" data-modal="support_card_grant_<%= card_grant.id %>">
      <%= render "card_grants/control", title:, description: support_description, icon: support_icon %>
    </button>
  <% else %>
    <%= link_to setting.support_url, target: "_blank", rel: "noopener", class: "grant-action grant-tone--info" do %>
      <%= render "card_grants/control", title:, description: support_description, icon: support_icon %>
    <% end %>
  <% end %>
<% end %>
