<%# locals: (card_grant:, title: "Need help?") %>

<%# The organization's support channel: a strip of copy with a real button, so
    it's obvious there's something to click. The modal the button may open
    comes from `card_grants/support_modal`, rendered once by the page. %>

<% if card_grant.setting.support? %>
  <div class="grant-support">
    <span class="grant-icon"><%= inline_icon "support", size: 20 %></span>
    <div class="grant-support__text">
      <strong><%= title %></strong>
      <span class="grant-support__desc"><%= card_grant.event.name %> runs this grant and can help with it.</span>
    </div>
    <%= render "card_grants/support_contact", card_grant:, classes: "btn bg-success" %>
  </div>
<% end %>
