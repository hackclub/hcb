<%# locals: (card_grant:, label: "", subtitle: "") %>

<% return_tooltip = subtitle.presence || "Cancel this grant and return funds to the organization" %>
<%= link_to "#", data: { behavior: "modal_trigger", modal: "return-grant" }, class: "grant-action" do %>
  <%= render "card_grants/control", icon: "reply", tone: "warning", title: label.presence || "Return grant", description: return_tooltip, cta: "Return" %>
<% end %>

<div class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="return-grant">
  <%= modal_header "Return #{card_grant.balance.format} to #{card_grant.event.name}?" %>

  <%= form_with(url: cancel_event_card_grant_path(id: card_grant.hashid, event_id: card_grant.event.slug), class: "w-full", data: { turbo_frame: "_top" }) do |form| %>
    <p><b>Caution, returning this grant will render it unusable.</b></p>
    <ul>
      <li><strong>You will not be able to use this card.</strong></li>
      <li>The remaining money on this card will be transferred to <%= card_grant.event.name %>.</li>
      <li>This card will be canceled.</li>
    </ul>

    <p>Are you sure you want to return this grant to <strong><%= card_grant.event.name %></strong>?</p>
    <%= form.submit "I understand. Return #{card_grant.balance.format} grant", class: "btn bg-primary w-full" %>
  <% end %>
</div>
