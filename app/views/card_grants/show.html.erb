<% title "Grant to #{@card_grant.user.name}" %>
<% if organizer_signed_in? %>
  <%= render "events/nav", selected: :card_grants %>
<% else %>
  <%= render "users/nav", selected: :cards %>
<% end %>

<% own = @card_grant.user == current_user %>
<% awaiting_activation = own && @card_grant.pending_invite? %>
<% stripe_card = @card_grant.stripe_card %>

<% footer = nil %>
<% if awaiting_activation %>
  <% footer = capture do %>
    <div class="flex items-baseline flex-wrap gap-x-2">
      <h3 class="m-0 p-0">Card activation</h3>
      <p class="m-0 muted">One more thing before you can start spending.</p>
    </div>
  <% end %>
<% end %>

<%= render partial: "card_grants/hero", locals: { card_grant: @card_grant, footer: } %>

<%= render partial: "card_grants/canceled_warning", locals: { card_grant: @card_grant } %>

<% if @card_grant.instructions.present? %>
  <%= render "application/callout", title: "Instructions from #{@card_grant.event.name}", type: "info", class: "mb-4" do %>
    <p class="m-0">
      <%= MarkdownService.instance.render(@card_grant.instructions) %>
    </p>
  <% end %>
<% end %>

<% if awaiting_activation %>
  <%# The grantee hasn't accepted the invite, so there's nothing to spend yet. %>
  <% if @card_grant.converted_to_reimbursement_report? %>
    <%= blankslate "This grant was converted into a reimbursement report." %>
    <% if policy(@card_grant.reimbursement_report).show? %>
      <p class="text-center">
        <%= link_to "View reimbursement report", @card_grant.reimbursement_report %>
      </p>
    <% end %>
  <% elsif @card_grant.canceled? %>
    <%= blankslate "Sorry, this grant was canceled!" %>
  <% else %>
    <%= render partial: "card_grants/invitation", locals: { card_grant: @card_grant } %>
  <% end %>
<% elsif @card_grant.user.admin? || organizer_signed_in? || own %>
  <%= render "card_grants/section_heading", icon: "1", title: own ? "What you can spend it on" : "Spending controls", own: own %>
  <%= render partial: "card_grants/grant_details", locals: { card_grant: @card_grant, own: own } %>

  <% if stripe_card.present? %>
    <%= render "card_grants/section_heading", icon: "2", title: own ? "Pay with your card" : "Virtual card", own: own %>
    <%= render partial: "card_grants/card_details", locals: { card_grant: @card_grant } %>
  <% end %>

  <%= render partial: "card_grant/pre_authorizations/organizer_info", locals: { pre_authorization: @card_grant.pre_authorization, link_to_pre_authorization: true } if @card_grant.pre_authorization.present? && organizer_signed_in? %>

  <%= render "card_grants/section_heading", icon: "3", title: own ? "Upload receipts for each purchase (required)" : "Transactions", own: own %>
  <%= render partial: "card_grants/transactions", locals: { hcb_codes: @hcb_codes, ledger: @ledger, items: @items, heading: false } %>
<% end %>

<% if policy(@card_grant.comments.build).create? %>
  <div class="mt-10 mb-10 block menu__divider"></div>
  <%= render "card_grants/section_heading", title: "Comments", own: own %>
  <%= render "comments/list", comments: @card_grant.comments, show_blankslate: true %>
  <%= render "comments/form", commentable: @card_grant %>
<% end %>
