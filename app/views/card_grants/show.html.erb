<% title "Grant to #{@card_grant.user.name}" %>
<% if organizer_signed_in? %>
  <%= render "events/nav", selected: :card_grants %>
<% else %>
  <%= render "users/nav", selected: :cards %>
<% end %>

<% own = @card_grant.user == current_user %>
<% awaiting_activation = own && @card_grant.pending_invite? %>
<% stripe_card = @card_grant.stripe_card %>
<%# Once a grant is over there's nothing left to do in order, so the grantee's
    numbered steps give way to plain headings. %>
<% ended = @card_grant.canceled? || @card_grant.expired? %>
<% steps = own && !ended %>

<%= render partial: "card_grants/hero", locals: { card_grant: @card_grant } %>

<%# Everything that explains the grant's state sits together under the hero. %>
<% notices = capture do %>
  <%= render partial: "card_grants/status_callout", locals: { card_grant: @card_grant } %>

  <%= render partial: "card_grant/pre_authorizations/organizer_info", locals: { pre_authorization: @card_grant.pre_authorization, link_to_pre_authorization: true } if @card_grant.pre_authorization.present? && organizer_signed_in? %>

  <% if @card_grant.instructions.present? %>
    <%= render "application/callout", title: "Instructions from #{@card_grant.event.name}", type: "info" do %>
      <p class="m-0">
        <%= MarkdownService.instance.render(@card_grant.instructions) %>
      </p>
    <% end %>
  <% end %>
<% end %>
<% if notices.present? %>
  <div class="grant-notices"><%= notices %></div>
<% end %>

<% if awaiting_activation %>
  <%= render partial: "card_grants/invitation", locals: { card_grant: @card_grant } %>
<% elsif own && (@card_grant.converted_to_reimbursement_report? || stripe_card.nil?) %>
  <%# The grant ended before (or instead of) the card being used, so the
      spending rules and card details don't apply: just the money trail. %>
  <%= render "card_grants/section_heading", title: "Transactions" %>
  <%= render partial: "card_grants/transactions", locals: { hcb_codes: @hcb_codes, ledger: @ledger, items: @items, heading: false } %>
<% elsif organizer_signed_in? || own %>
  <% unless own && ended %>
    <%= render "card_grants/section_heading", icon: steps ? "1" : "", title: own ? "What you can spend it on" : "Spending controls", own: own %>
    <%= render partial: "card_grants/grant_details", locals: { card_grant: @card_grant, own: own } %>
  <% end %>

  <% if stripe_card.present? %>
    <%= render "card_grants/section_heading", icon: steps ? "2" : "", title: own ? (ended ? "Your card" : "Pay with your card") : "Virtual card", own: own %>
    <%= render partial: "card_grants/card_details", locals: { card_grant: @card_grant } %>
  <% end %>

  <%= render "card_grants/section_heading", icon: steps ? "3" : "", title: own ? "Upload receipts for each purchase (required)" : "Transactions", own: own %>
  <%= render partial: "card_grants/transactions", locals: { hcb_codes: @hcb_codes, ledger: @ledger, items: @items, heading: false } %>
<% end %>

<% if policy(@card_grant.comments.build).create? %>
  <% comments = policy_scope(@card_grant.comments) %>
  <div class="mt-10 mb-10 block menu__divider"></div>
  <details class="grant-comments" <%= "open" if comments.any? %>>
    <summary class="grant-comments__summary">
      <h2 class="grant-section m-0">
        Comments
        <span class="grant-comments__count"><%= comments.size %></span>
      </h2>
    </summary>
    <div class="grant-comments__body">
      <%= render "comments/list", comments: @card_grant.comments, show_blankslate: true %>
      <%= render "comments/form", commentable: @card_grant %>
    </div>
  </details>
<% end %>
