<%= turbo_frame_tag :card_grant_transaction_overview do %>
  <% if Flipper.enabled?(:new_ledger_everywhere_2026_07_13, current_user) %>
    <%= render "ledgers/ledger", ledger: @ledger, items: @items, filter: capture { render partial: "ledgers/filters/filter", locals: { event: @event, filter_category: @category, filter_direction: @direction, filter_end_date: @end_date, filter_maximum_amount: @maximum_amount, filter_merchant: @merchant, filter_merchant_name: @merchant_name, filter_minimum_amount: @minimum_amount, filter_missing_receipts: @missing_receipts, filter_order_by: @order_by, filter_start_date: @start_date, filter_tag: @tag, filter_type: @type, filter_user: @user, ledger_filters_disabled: @ledger_filters_disabled, show_running_balance: @show_running_balance, use_card_grant_ledgers: @use_card_grant_ledgers, users: @users } } %>
  <% else %>
    <%= turbo_frame_tag [dom_id(@event), :ledger], src: event_transactions_list_path(@event, subledger: @subledger), loading: :eager do %>
      <%# I'd like to have this show to improve the loading experience eventually but the ledger and filter code needs to be refactored more %>
      <%# <%= render partial: "events/filter" %>

      <%= render "application/loading_container", klass: "mt-8" %>
    <% end %>
  <% end %>
<% end %>
