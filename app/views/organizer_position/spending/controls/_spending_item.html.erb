<% transaction = item.is_a?(Ledger::Item) %>
<% item_user = transaction ? item.author : item.authorized_by %>

<tr class="<%= !transaction && item.amount_cents.positive? ? "transaction--positive" : "transaction--negative" %>">
  <td><%= format_date(spending_item_created_date(item)) %></td>
  <td style="max-width: 400px; overflow: hidden; text-overflow: ellipsis;">
    <% if transaction %>
      <%= link_to ledger_item_path(item), data: ledger_item_popover_data(item) do %>
        <%= item.memo %>
      <% end %>
    <% else %>
      <%= item.memo %>
    <% end %>
  </td>

  <td class="flex items-center g1">
    <% if item_user %>
      <%= avatar_for item_user %>
      <%= item_user.name %>
    <% end %>
  </td>
  <td class="text-right"><%= render_money item.amount_cents %></td>
</tr>
