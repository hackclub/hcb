<%# locals: (application:) %>

<% content_for :footer do %>
  <div class="flex gap-4">
    <%= responsive_link_to applications_path, text: "Back to dashboard", icon: "view-back", class: "btn bg-muted" %>
    <%= mobile_button_to archive_application_path(application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?", turbo_confirm_danger: true } %>
  </div>

  <div class="flex items-center gap-4">
    <% admin_tool do %>
      <%= link_to "View in Airtable", airtable_application_path(application), class: "btn bg-blue", target: "_blank" %>
    <% end %>

    <%= link_to "View submission", submission_application_path(application), class: "btn bg-muted" %>
  </div>
<% end %>
