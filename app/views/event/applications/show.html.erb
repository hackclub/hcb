<% if @application.archived? %>
  <% title "Archived application" %>

  <div class="flex flex-col gap-3 w-full items-start md:items-center justify-start mt-6">
    <h2 class="text-3xl md:text-4xl m-0">This application has been archived.</h2>
    <p class="max-w-xl md:text-center">
      You archived <%= @application.name.present? ? "your application for #{@application.name}" : "this application" %> on <%= local_time(@application.archived_at, "%B %e") %> at <%= local_time(@application.archived_at, "%l:%M%P") %>.
      If you'd like to continue with this application, you can unarchive it.
    </p>

    <%= button_to "Unarchive application", unarchive_application_path(@application), class: "btn btn--destroy" %>

    <% content_for :footer do %>
      <%= link_to "Back to dashboard", applications_path, class: "btn bg-muted flex-shrink-0" %>

      <div class="w-full flex-grow flex items-center justify-end gap-4">
        <%= link_to "View submission", submission_application_path(@application), class: "btn bg-muted" %>
      </div>
    <% end %>
  </div>
<% elsif @application.draft? %>
  <% title "Apply" %>
  <%= render partial: "begin", locals: { application: @application } %>
<% elsif @application.rejected? %>
  <% title "Application status" %>

  <div class="flex flex-col gap-3 w-full items-start md:items-center justify-start mt-6">
    <h2 class="text-3xl md:text-4xl m-0">Your application has been reviewed</h2>
    <p>A status update on your application has been emailed to <%= @application.user.email %>.</p>
  </div>

  <% content_for :footer do %>
    <%= link_to "Back to dashboard", applications_path, class: "btn bg-muted flex-shrink-0" %>

    <div class="w-full flex-grow flex items-center justify-end gap-4">
      <%= mobile_button_to archive_application_path(@application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?" } %>
      <%= link_to "View submission", submission_application_path(@application), class: "btn bg-muted" %>
    </div>
  <% end %>
<% else %>
  <% title "Application status" %>

e  <%= render partial: "status_header", locals: { application: @application, steps: @steps } %>

  <div class="flex flex-col mt-9 items-center justify-start">
    <div class="flex flex-col gap-3 w-full max-w-xl items-start md:items-center">
      <h3 class="m-0"><%= @current_step[:name] %></h3>
      <p class="m-0 md:text-center"><%= @current_step[:description] %></p>

      <% if @current_step[:label] == "Await review" %>
        <div class="w-full">
          <%= render "application/ooo_callout", resource: "application", financial: false, business_days: @application.response_business_days %>
        </div>
      <% elsif @current_step[:label] == "Start spending" && @application.event.present? %>
        <%= link_to "Go to your new organization!", @application.event, class: "btn" %>
      <% end %>
    </div>
  </div>

  <%= render partial: "status_footer", locals: { application: @application } %>
<% end %>
