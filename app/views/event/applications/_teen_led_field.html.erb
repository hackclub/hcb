<%# locals: (form:, initial_teen_led:) %>
<%# herb:slots client %>
<%# herb:state (selected_teen_led: initial_teen_led) %>

<div class="card card--outline mb-6">
  <%= form.label :teen_led do %>
    Are you a teenager? <span class="text-primary">*</span>
  <% end %>

  <p class="text-sm muted mt-1 mb-2">HCB primarily focuses on teen-led projects, so we're more selective with adult-run organizations.</p>

  <div class="field field--options max-w-none mb-0 relative">
    <%= form.radio_button :teen_led, "true", { checked: initial_teen_led == "true", required: true, class: "absolute !block opacity-0", data: { herb_set: "selected_teen_led=$value" } } %>
    <%= form.label :teen_led, value: "true" do %>
      <strong>Yes, I'm a teenager</strong>
      <small>18 and under</small>
    <% end %>
    <%= form.radio_button :teen_led, "false", { checked: initial_teen_led == "false", required: true, class: "absolute !block opacity-0", data: { herb_set: "selected_teen_led=$value" } } %>
    <%= form.label :teen_led, value: "false" do %>
      <strong>No, I'm an adult</strong>
      <small>Over 18</small>
    <% end %>
  </div>

  <p class="text-sm muted mt-3 mb-0" hidden="<%= selected_teen_led != "true" %>">HCB is a full financial tool stack that provides 501(c)(3) status for your project. If you are a teenager running a club, nonprofit, or robotics team, you qualify.</p>
  <p class="text-sm muted mt-3 mb-0" hidden="<%= selected_teen_led != "false" %>">HCB is a model A fiscal sponsor. If approved, your nonprofit will become a project of The Hack Foundation.</p>

</div>
