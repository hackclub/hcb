<%# locals: (form:, application:, initial_has_website: application.website_url.present?.to_s, initial_has_political: application.political_description.present?.to_s, initial_committed_funding: !application.teen_led? && application.committed_amount.to_f.positive?) %>
<%# herb:slots client %>
<%# herb:state (selected_has_website: initial_has_website, selected_has_political: initial_has_political, committed_funding: initial_committed_funding, word_count_hint: "") %>

<div class="card card--outline mb-6" data-controller="application-project-info">
  <div class="field">
    <%= form.label :name do %>
      Project name <span class="text-primary">*</span>
    <% end %>
    <%= form.text_field :name, placeholder: "Leosia Hacks", class: "w-full !max-w-full", required: true %>
  </div>

  <div class="field">
    <%= form.label :description do %>
      <% if application.teen_led? %>
        Tell us about your project
      <% else %>
        Describe your mission's charitable purpose
      <% end %>
      <span class="text-primary">*</span>
    <% end %>
    <p class="text-sm muted mt-1 mb-2">
      <% if application.teen_led? %>
        Are you running a hackathon, leading a robotics team, organizing a nonprofit, building a project, or something else? We want to know!
      <% else %>
        Please share some additional details about your project’s charitable mission, operations and reason for seeking fiscal sponsorship. (minimum 50 words)
      <% end %>
    </p>
    <%# Adult-run projects need at least 50 words, which the controller counts. %>
    <%= form.text_area :description, class: "w-full max-w-full", required: true, data: application.teen_led? ? {} : { application_project_info_target: "description", action: "application-project-info#count" } %>
    <% unless application.teen_led? %>
      <p class="text-sm muted mt-1 mb-2"><%= word_count_hint %></p>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :has_website do %>
      Do you have a website? <span class="text-primary">*</span>
    <% end %>
    <%= form.select :has_website, options_for_select([["No", "false"], ["Yes", "true"]], initial_has_website), {}, { class: "w-full max-w-full", required: true, data: { herb_set: "selected_has_website=$value" } } %>
  </div>

  <div class="field" hidden="<%= selected_has_website != "true" %>">
    <%= form.label :website_url do %>
      Website URL <span class="text-primary">*</span>
    <% end %>
    <%# Still submitted when hidden: answering "No" empties it (application-project-info), which clears the saved website. %>
    <input type="url" name="<%= form.field_name(:website_url) %>" id="website_url_field" value="<%= application.website_url %>" placeholder="https://hackclub.com" class="w-full !max-w-full" required="<%= selected_has_website == "true" %>" data-controller="url-validator" data-action="blur->url-validator#handleBlur" data-application-project-info-target="website">
  </div>

  <div class="field">
    <%= form.label :has_political do %>
      Is your project involved with political activity? <span class="text-primary">*</span>
    <% end %>
    <p class="text-sm muted mt-1 mb-2">This includes but is not limited to protests, public demonstrations, political education, and lobbying.</p>
    <%= form.select :has_political, options_for_select([["No", "false"], ["Yes", "true"]], initial_has_political), {}, { class: "w-full max-w-full", required: true, data: { herb_set: "selected_has_political=$value" } } %>
  </div>

  <div class="field" hidden="<%= selected_has_political != "true" %>">
    <%= form.label :political_description do %>
      Please describe the political activity your project is involved in <span class="text-primary">*</span>
    <% end %>
    <textarea name="<%= form.field_name(:political_description) %>" id="political_description_field" class="w-full max-w-full" required="<%= selected_has_political == "true" %>">
<%= application.political_description %></textarea>
  </div>

  <%= tag.div class: "field", hidden: application.teen_led? do %>
    <%= form.label :planning_duration do %>
      How long have you been planning your project? <span class="text-primary">*</span>
    <% end %>
    <%= form.text_field :planning_duration, placeholder: "4 months", class: "w-full !max-w-full", required: !application.teen_led? %>
  <% end %>

  <%= tag.div class: "field", hidden: application.teen_led? do %>
    <%= form.label :team_size do %>
      How many people are on your team? <span class="text-primary">*</span>
    <% end %>
    <%= form.number_field :team_size, placeholder: "7", class: "w-full !max-w-full", required: !application.teen_led?, step: 1, min: 1 %>
  <% end %>

  <div class="flex flex-row w-full gap-4 my-4">
    <%= tag.div class: "field w-full flex-1 flex-shrink-0 mb-0", hidden: application.teen_led? do %>
      <%= form.label :annual_budget do %>
        Annual budget <span class="text-primary">*</span>
      <% end %>

      <div class="flex items-center">
        <div class="input flex gap-2 items-center py-0">
          <span class="bold muted">$</span>
          <%= form.number_field :annual_budget, id: "annual_budget_field", placeholder: "500.00", step: 0.01, min: 0.01, data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad" }, class: "!p-0 !border-none !shadow-none min-h-auto" %>
        </div>
      </div>
    <% end %>

    <%= tag.div class: "field w-full flex-1 flex-shrink-0 mb-0", hidden: application.teen_led? do %>
      <%= form.label :committed_amount do %>
        Committed amount <span class="text-primary">*</span>
      <% end %>
      <div class="flex items-center">
        <div class="input flex gap-2 items-center py-0">
          <span class="bold muted">$</span>
          <%= form.number_field :committed_amount, id: "committed_amount_field", placeholder: "500.00", step: 0.01, min: 0.00, data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad application-project-info#commit" }, class: "!p-0 !border-none !shadow-none min-h-auto" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="field m-0 my-4" hidden="<%= !committed_funding %>">
    <%= form.label :funding_source do %>
      What is the source of your funding? <span class="text-primary">*</span>
    <% end %>
    <input type="text" name="<%= form.field_name(:funding_source) %>" id="<%= form.field_id(:funding_source) %>" value="<%= application.funding_source %>" placeholder="The Orpheus Endowment" class="w-full !max-w-full" required="<%= committed_funding %>">
  </div>

  <div class="field m-0">
    <%= form.label :previously_applied do %>
      Have you applied for fiscal sponsorship with HCB in the past? <span class="text-primary">*</span>
    <% end %>
    <%= form.select :previously_applied, options_for_select([["No", "false"], ["Yes", "true"]], (application.previously_applied.nil? ? application.user.organizer_positions.with_deleted.joins(:organizer_position_invite).where(is_signee: true, organizer_position_invite: { initial: true }).exists? : application.previously_applied).to_s), {}, { class: "w-full max-w-full", required: true } %>
  </div>
</div>
