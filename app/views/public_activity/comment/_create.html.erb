<%# locals: (activity:, p:, current_user: nil, **) %>

<% current_user ||= p[:current_user] %>

<% commentable = activity.trackable&.commentable %>
<% commentable = commentable.ledger_item if commentable.is_a?(HcbCode) && commentable.ledger_item.present? %>

<% if commentable.present? %>
  <% if Pundit.policy(current_user, activity.trackable).show? %>
    <%= render layout: "/public_activity/common", locals: { activity:, current_user:, url: polymorphic_url(commentable, anchor: "comment-#{activity.trackable.hashid}") } do %>
      <%= activity.trackable.action_text %> on <%= link_to commentable.try(:name) || commentable.try(:memo) || "an item", commentable %>
    <% end %>
  <% end %>
<% else %>
  <%= render layout: "/public_activity/common", locals: { activity:, current_user: } do %>
    created a comment
  <% end %>
<% end %>
