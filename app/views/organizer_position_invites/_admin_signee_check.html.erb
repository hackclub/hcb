<%# locals: (form:, default_selected: "") %>

<div class="field field--select w-100" x-data="{ signee: '<%= default_selected %>' }">
  <div class="flex items-center justify-between">
    <strong>Contract</strong>
    <%= form.select :is_signee,
        [
          ["📃 Contract Signee", "true"],
          ["❌ Won't sign the contract", "false"],
        ],
        { include_blank: "Select a contract signee status",
          selected: default_selected
        },
        { required: true, style: "width: 100%", "x-model": "signee" } %>
    </div>

  <div class="flex items-center justify-between mt-2" x-show="signee === 'true'" x-cloak>
    <strong class="d-block">Cosigner Email</strong>
    <%= form.email_field :cosigner_email, placeholder: "Required if under 18", class: "w-100" %>
  </div>
  <div class="field field--checkbox mt-2">
    <%= form.check_box :include_videos %>
    <%= form.label :include_videos, "Would you like us to include the onboarding videos?" %>
  </div>
</div>
