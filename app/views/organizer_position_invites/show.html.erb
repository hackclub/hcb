<% title "You’ve been invited to #{@invite.event.name}" %>

<% if @invite.contract && !@invite.contract.signed? %>
  <% contract = @invite.contract %>
  <% signee = contract.party(:signee) %>
  <% cosigner = contract.party(:cosigner) %>
  <div class="max-w-3xl mx-auto">
    <% if signee&.signed? %>
      <%= render "application/callout", type: "warning", title: "You've signed the contract for this organization. It's under review." do %>
        <% if cosigner && !cosigner.signed? %>
          We're waiting for your parent / legal guardian to sign it.
        <% else %>
          The HCB team is reviewing it. We'll email you once it's complete.
        <% end %>
        <%= help_message %>
      <% end %>
    <% else %>
      <%= render "application/callout", type: "warning", title: "You have a pending contract for this organization." do %>
        The contract is still pending because you (<%= signee&.email %>) haven't signed it yet.
        This is a fiscal sponsorship agreement between you and HCB. We need it signed before you can help manage this organization's funds.
        <%= help_message %>
      <% end %>
    <% end %>
  </div>
<% end %>

<main class="center max-w-3xl card mt4 md-p3 mx-auto">
  <h1 class="mt0 border-0 mb-0"><%= @invite.event.name %></h1>

  <p class="muted caps bold mt-2">You've been invited to join</p>

  <% if @organizers.any? %>
    <div class="flex justify-center flex-wrap">
      <% @organizers.each do |position| %>
        <div class="tooltipped tooltipped--s mr1" aria-label="<%= position.user.name %>">
          <%= avatar_for position.user, size: 64 %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-center items-center flex-wrap mt-3 gap-2">
    <%= link_to "Reject", organizer_position_invite_reject_path(@invite), data: { turbo_method: :post }, class: "btn bg-error" %>
    <% if @invite.contract && !@invite.contract.signed? && !@invite.contract.party(:signee)&.signed? %>
      <% if @invite.contract.party(:signee).present? %>
        <%= link_to "View pending contract", contract_party_path(@invite.contract.party(:signee)), class: "btn bg-accent" %>
      <% elsif @invite.contract.sent_with_docuseal? %>
        <%= link_to "View pending contract", @invite.contract.signee_docuseal_url, class: "btn bg-accent" %>
      <% end %>
    <% else %>
      <% disabled = @invite.contract.present? && !@invite.contract.signed? %>
      <p class="tooltipped my-0" aria-label="<%= "The contract must be signed before you can accept this invite" if disabled %>"><%= link_to "Accept invitation", organizer_position_invite_accept_path(@invite), data: { turbo_method: :post }, class: "btn bg-success #{"pointer-events-none" if disabled}", disabled: %></p>
    <% end %>
  </div>
</main>
