<%# locals: (event:) -%>
<%# The org a transaction belongs to, shown under its memo when a table mixes
    rows from several orgs. Deliberately inside the memo cell rather than a
    column of its own: every table this
    partial's callers render into is also patched row-by-row over Turbo Streams
    from callers that don't know whether the org is being shown, and a
    conditional <td> would leave those rows a column short. -%>
<% if event.present? %>
  <div class="transaction__event">
    <%= link_to event.name, event_path(event), title: event.name, data: { turbo_frame: "_top" } %>
  </div>
<% end %>
