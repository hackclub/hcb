<%# Tags live on the ledger item now; without one there's nowhere to attach them. %>
<% ledger_item = hcb_code.ledger_item %>
<% tags = ledger_item&.tags || [] %>
<% if ledger_item.present? && (tags.any? || TagPolicy.new(current_user, @event).create?) %>
  <div>
    <strong>Tags</strong>
    <div class="flex items-center flex-wrap" style="gap: 0.25rem">
      <div class="flex items-center flex-wrap ledger_item_<%= ledger_item.hashid %>_tags" style="gap: 0.25rem">
        <%= render partial: "ledger/items/tag", collection: tags, locals: { item: ledger_item } %>
      </div>

      <% if TagPolicy.new(current_user, @event).create? %>
        <div data-controller="menu">
          <button class="list-badge add-tag-badge ml0 menu__toggle menu__toggle--arrowless h-full" style="height: 1.6rem" data-menu-target="toggle" data-action="menu#toggle">+ Add tag</button>
          <%= render "ledger/items/tag_menu_content", item: ledger_item, event: @event %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
