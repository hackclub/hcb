<%# locals: () %>

<% unless @hcb_code.stripe_refund? %>
  <% banner_id = @frame ? dom_id(@hcb_code, :popover_stripe_card_receipts) : "#{@ledger_instance}_stripe_card_receipts" %>
  <% if @hcb_code.receipts.any? %>
    <p class="card__banner bg-success white bold flex items-center mt0 mb0" id="<%= banner_id %>">
      <%= inline_icon "checkmark", size: 24, class: "mr2" %>
      <%= pluralize @hcb_code.receipts.count, "receipt" %>
      added
    </p>
  <% elsif @hcb_code.no_or_lost_receipt? %>
    <p class="card__banner bg-warning white bold flex items-center mt0 mb0" id="<%= banner_id %>">
      <%= inline_icon "view-close", size: 24, class: "mr2" %>
      Marked no/lost receipt
    </p>
  <% elsif @hcb_code.pt&.declined? %>
    <p class="card__banner bg-warning white bold flex items-center mt0 mb0" id="<%= banner_id %>">
      <%= inline_icon "important", size: 24, class: "mr2" %>
      This transaction has no receipt
    </p>
  <% elsif @hcb_code.ledger_item&.receipt_required? %>
    <p class="card__banner bg-pending slate bold flex items-center mt0 mb0" id="<%= banner_id %>">
      <%= inline_icon "important", size: 24, class: "mr2" %>
      This transaction is missing a receipt
    </p>
  <% end %>
<% end %>
