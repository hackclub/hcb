<%# locals: (hcb_code:, prepended_to_memo: "", location: "hcb_code_show_page", ledger_instance: nil, force_display_details: false) -%>

<% prepended_to_memo ||= "" %>
<% location ||= "hcb_code_show_page" %>
<% organizer_signed_in = current_user && (organizer_signed_in?(@event || hcb_code.event) || (hcb_code.events && organizer_signed_in?(hcb_code.events.last))) %>

<% memo = hcb_code.custom_memo.nil? && @event && location == "ledger" ? Rails.cache.fetch("#{@event.public_id}/#{hcb_code.hcb_code}/cached_memo", expires_in: 10.minutes) { hcb_code.memo(event: @event) } : hcb_code.memo(event: @event) %>

<% if (organizer_signed_in && (@event || hcb_code.event) || force_display_details) && !(@event || hcb_code.event)&.demo_mode? %>
  <% can_rename = policy(hcb_code).edit? %>

  <div class="flex gap-1" style="flex-grow: 1" data-controller="memo">
    <% card_grant = Rails.cache.fetch("tx_#{hcb_code.hcb_code}/card_grant", expires_in: 12.hours) { hcb_code.card_grant? } %>
    <% details_link = card_grant ? spending_card_grant_path(hcb_code.outgoing_disbursement.card_grant) : url_for(hcb_code) %>
    <% memo_popover_attrs = card_grant ?
        card_grant_popover_data(hcb_code.outgoing_disbursement.card_grant, hcb_code: hcb_code, event: @event) :
        hcb_code_popover_data(hcb_code, event: @event, ledger_instance: ledger_instance) %>

    <% contents = capture do %>
      <span style="flex-grow: 1">
        <span class="mr2 <%= "tooltipped tooltipped--s" if can_rename %> <%= "memo-underline" if ledger_instance %>"
              style="color: inherit; text-decoration: none;"
              <%= tag.attributes(aria: { label: "Shift+click to rename this transaction" }) if can_rename %>>
          <%= prepended_to_memo %>
          <span data-memo-for="<%= dom_id(hcb_code) %>">
            <%= memo %>
          </span>
        </span>
      </span>
    <% end %>

    <% display_data = { memo_target: "display" } %>

    <%= if ledger_instance
          link_to(contents, details_link, style: "color: inherit; min-width: 0;", data: display_data.merge(@force_no_popover ? { turbo_frame: "_top" } : memo_popover_attrs).merge(can_rename ? { action: "click->memo#editOnShiftClick" } : {}))
        else
          content_tag(:span, contents, style: "min-width: 0;", data: display_data)
        end %>

    <% if can_rename %>
      <%= form_with model: hcb_code, url: hcb_code_path(hcb_code), method: :patch, class: "renaming", html: { hidden: true }, data: { memo_target: "form", turbo_stream: true, action: "turbo:submit-end->memo#submitEnd" } do |form| %>
        <div class="flex items-center w-screen">
          <%= form.text_field :memo,
                              value: memo,
                              id: "#{dom_id(hcb_code)}_memo",
                              autocomplete: "off",
                              data: { memo_target: "input", action: "blur->memo#save keydown->memo#keydown" },
                              class: "bg-transparent fit",
                              style: "border: none; outline: none; padding: 0; border-radius: 0; min-height: 0; margin-top: 5px; margin-bottom: 3px; width: 100%" %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= prepended_to_memo %> <%= memo %>
<% end %>
