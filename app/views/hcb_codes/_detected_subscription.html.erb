<%# locals: (subscription:, current_item:) %>

<% admin_tool("mt2 p-3") do %>
  <h3 class="mt0 mb1">Detected as a subscription</h3>
  <p class="mt0 mb2 muted">
    <%= humanized_merchant_name subscription.merchant %>,
    <%= render_money subscription.amount_cents %> <%= subscription.cadence_label %>.
    Detected <%= local_time_ago subscription.created_at %>.
    <% if subscription.next_expected_at %>
      Next charge expected around <%= local_time subscription.next_expected_at, format: "%B %e, %Y" %>.
    <% end %>
  </p>
  <ul class="list-reset m0">
    <% subscription.ledger_items.includes(:hcb_code).order(datetime: :desc).each do |ledger_item| %>
      <li>
        <% if ledger_item == current_item %>
          <strong><%= ledger_item.datetime.to_date.to_fs(:long) %> (this charge)</strong>
        <% else %>
          <%= link_to ledger_item.datetime.to_date.to_fs(:long), ledger_item.hcb_code ? hcb_code_path(ledger_item.hcb_code) : ledger_item_path(ledger_item), data: { turbo_frame: "_top" } %>
        <% end %>
        &middot; <%= render_money ledger_item.amount_cents.abs %>
      </li>
    <% end %>
  </ul>
<% end %>
