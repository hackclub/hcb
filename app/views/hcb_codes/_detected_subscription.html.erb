<%# locals: (subscription:) %>

<% admin_tool("mt2 p-3") do %>
  <h3 class="mt0 mb1">Detected as a subscription (experimental)</h3>
  <p class="mt0 mb2">
    <%= subscription.name %>
    <%= subscription.lapsed? ? "charged" : "charges" %>
    <%= subscription.variable_amount? ? "a varying amount" : render_money(subscription.amount_cents) %>
    <%= subscription.cadence_label %>.
    <% if subscription.lapsed? %>
      Lapsed: no charge since <%= format_date subscription.last_charged_at %>.
    <% elsif subscription.overdue? %>
      Overdue: expected around <%= format_date subscription.next_expected_at %>.
    <% else %>
      Next charge expected around <%= format_date subscription.next_expected_at %>.
    <% end %>
  </p>
  <p class="mt0 mb2 muted">
    Confidence <%= subscription.confidence %> out of 100:
    <%= subscription.points.map { |signal, earned| "#{signal.to_s.humanize(capitalize: false)} #{earned}/#{Subscription::WEIGHTS.fetch(signal)}" }.to_sentence %>.
  </p>
  <ul class="list-reset m0">
    <% subscription.ledger_items.includes(:hcb_code, linked_object: { stripe_card: :user }).order(datetime: :desc).each do |ledger_item| %>
      <li>
        <% if ledger_item.hcb_code == @hcb_code %>
          <strong><%= format_date ledger_item.datetime %> (this charge)</strong>
        <% elsif ledger_item.hcb_code %>
          <%= link_to format_date(ledger_item.datetime), hcb_code_path(ledger_item.hcb_code), data: { turbo_frame: "_top" } %>
        <% else %>
          <%= format_date ledger_item.datetime %>
        <% end %>
        &middot; <%= render_money ledger_item.amount_cents.abs %>
        &middot; <%= ledger_item.linked_object.stripe_card.user.name %>
      </li>
    <% end %>
  </ul>
<% end %>
