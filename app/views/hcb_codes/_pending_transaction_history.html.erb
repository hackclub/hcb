<h2 class="mt-0">Pending transaction history</h2>

<% if @hcb_code.canonical_pending_transactions.exists? %>
  <article class="table-container">
    <table>
      <thead>
        <tr>
          <th>DATE</th>
          <th>MEMO</th>
          <th style="text-align: right;">AMOUNT</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @hcb_code.canonical_pending_transactions.each do |ct| %>
          <tr>
            <td><%= format_date ct.date %></td>
            <td><%= ct.smart_memo %></td>
            <td style="text-align: right;"><%= number_to_currency(ct.amount) %></td>
            <td>
              <%= pop_icon_to "view",
                  canonical_pending_transaction_path(ct),
                  class: "right tooltipped tooltipped--w", "aria-label": "View pending transaction" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </article>
<% else %>
  <%= blankslate "No pending transactions yet" %>
<% end %>
