<%# Cart screenshot dropzone. Rendered inline on the pre-authorization page and
    swapped wholesale by the controller's turbo stream after an upload, so the
    layout classes live on the outermost element. %>

<div id="screenshot_upload_form" class="grant-upload__drop">
  <%= form_with model: false, url: card_grant_pre_authorizations_path, method: :patch, remote: true, class: "h-100", data: {
        turbo: defined?(turbo) ? turbo : "false",
        controller: "file-drop form uploading",
        "uploading-button-value" => "upload-screenshot-button",
        action: "submit->uploading#start" + (local_assigns[:disabled] ? "" : "
          dragover@window->file-drop#dragover
          drop@window->file-drop#drop
          dragenter@window->file-drop#dragenter
          dragleave@window->file-drop#dragleave
        "),

        "file-drop-title-value" => "Drop to add a screenshot.",
        "file-drop-global-paste-value" => "true"
      }.compact do |form| %>

    <div class="grant-upload__dropzone" id="upload_screenshot_form">
      <%= form.file_field :screenshot,
                          multiple: true,
                          include_hidden: false,
                          required: true,
                          class: "display-none",
                          accept: "image/*,image/heic,.pdf",
                          direct_upload: true,
                          data: {
                            "file-drop-target" => "fileInput",
                            "action"           => "change->form#submit"
                          } %>

      <%= inline_icon "photo", size: 28, class: "grant-upload__dropzone-icon" %>

      <%= form.label :screenshot, class: "btn #{"bg-success" if local_assigns[:success]} #{"bg-error" if local_assigns[:error]}", id: "upload-screenshot-button", disabled: false, data: (local_assigns[:success] || local_assigns[:error] ? { controller: "reset-after", reset_after_text_value: "Upload screenshot", reset_after_status_class: "bg-success bg-error" } : {}) do %>
        <%= inline_icon "cloud-upload" %>
        <% if local_assigns[:success] || local_assigns[:error] %>
          <span id="upload-screenshot-button-text" data-reset-after-target="label"><%= local_assigns[:success] || local_assigns[:error] %></span>
        <% else %>
          <span>Upload screenshot</span>
        <% end %>
      <% end %>

      <p class="m-0 muted center">or drag, drop, or paste it here</p>
    </div>

  <% end %>
</div>
