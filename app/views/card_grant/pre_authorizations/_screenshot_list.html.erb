<%# locals: (screenshots:) %>

<div id="screenshot_list" class="grant-upload__list">
    <% if screenshots.any? %>
        <% screenshots.each do |screenshot| %>
            <%= link_to url_for(screenshot), target: :_blank, rel: "noopener", class: "grant-upload__thumb" do %>
                <%= image_tag screenshot, alt: screenshot.filename.to_s %>
            <% end %>
        <% end %>
    <% else %>
        <p class="grant-upload__empty muted m-0">No screenshots uploaded yet</p>
    <% end %>
</div>
