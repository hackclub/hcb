<% title "Grant to #{@card_grant.user.name}" %>
<%= render "events/nav", selected: :transfers if organizer_signed_in? %>
<%= render "users/nav", selected: :home unless organizer_signed_in? %>

<%= turbo_stream_from @pre_authorization %>

<% draft = @pre_authorization.draft? %>

<%# The hero doubles as the page header: same grant summary the grantee sees on
    the grant itself, with the pre-authorization step called out underneath. %>
<% hero_footer = capture do %>
  <div class="flex items-baseline flex-wrap justify-between gap-x-4 gap-y-1">
    <div class="flex items-baseline flex-wrap gap-x-2">
      <h3 class="m-0 p-0">Pre-authorization</h3>
      <p class="m-0 muted">Before you can start spending, tell us what you're planning&nbsp;to&nbsp;buy.</p>
    </div>
    <%= render partial: "card_grant/pre_authorizations/status_badge", locals: { pre_authorization: @pre_authorization, organizer: false } %>
  </div>
<% end %>

<%= render partial: "card_grants/hero", locals: { card_grant: @card_grant, footer: hero_footer, actions: false } %>

<% if @pre_authorization.authorized? %>
  <%= render "application/callout", type: "success", title: "Your card grant has been approved!" do %>
    <p class="m-0">You're all set — your card is ready to spend.</p>
    <%= link_to "View card details", card_grant_path(@card_grant), class: "btn bg-success mt-3" %>
  <% end %>
<% end %>

<% if @pre_authorization.fraudulent? && @pre_authorization.unauthorized? %>
  <%= render "application/callout", type: "error", title: "This grant has been flagged" do %>
    <p class="m-0">
      Your card grant was flagged because it doesn't meet the given requirements.
      Please reach out to <%= @card_grant.event.name %> for support.
    </p>
  <% end %>
<% end %>

<% if @card_grant.instructions.present? %>
  <%= render "application/callout", title: "Instructions from #{@card_grant.event.name}", type: "info" do %>
    <p class="m-0">
      <%= MarkdownService.instance.render(@card_grant.instructions) %>
    </p>
  <% end %>
<% end %>

<%= render partial: "card_grant/pre_authorizations/organizer_info", locals: { pre_authorization: @pre_authorization, link_to_pre_authorization: false } %>

<%= render "card_grants/section_heading", icon: "1", title: "Link to the product page" %>
<p class="muted mt-0 mb-3">
  Submit a link to the product you're looking to purchase. We'll use this to verify that the item is in line with the purpose of the grant.
</p>

<%= form_with model: @pre_authorization, id: "pre_authorization_form", url: card_grant_pre_authorizations_path(@card_grant), method: :patch, data: { turbo: true } do |form| %>
  <div class="card">
    <% if draft %>
      <div class="field flex items-center justify-between m-0">
        <%= form.label :product_url, "Product page URL" %>
        <%= form.text_field :product_url, required: true, placeholder: "https://example.com/product" %>
      </div>
    <% else %>
      <div class="grant-row">
        <span class="grant-row__label">
          <%= inline_icon "link", size: 20 %>
          Product page
        </span>
        <% if @pre_authorization.product_url.present? %>
          <%= link_to @pre_authorization.product_url, @pre_authorization.product_url, target: :_blank, rel: "noopener", class: "grant-row__value" %>
        <% else %>
          <span class="grant-row__value muted">Not provided</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%= render "card_grants/section_heading", icon: "2", title: "Screenshot of your cart" %>
<p class="muted mt-0 mb-3">
  Upload a screenshot of your cart showing the item you want to purchase. Make sure it includes the total cost, as well as any taxes, fees, and shipping costs. This helps us verify the total amount you need to spend.
</p>

<section class="card grant-upload">
  <div class="grant-upload__grid">
    <% if draft %>
      <%= render partial: "card_grant/pre_authorizations/screenshot_form", locals: { turbo: true } %>
    <% end %>

    <%= render partial: "card_grant/pre_authorizations/screenshot_list", locals: {
          screenshots: @pre_authorization.screenshots.attachments
        } %>
  </div>

  <%= render partial: "card_grant/pre_authorizations/screenshot_count", locals: {
        count: @pre_authorization.screenshots.count,
        card_grant: @card_grant,
        disabled: !draft
      } %>
</section>

<%= render "card_grants/section_heading", icon: "3", title: "Submit for review" %>

<div class="card grant-submit mb-20">
  <p class="m-0 muted">
    Once you've provided the product link and uploaded the screenshot, our review process will screen your submission and activate your grant.
  </p>

  <% if draft %>
    <input type="submit" class="btn" value="Submit for review" form="pre_authorization_form">
  <% elsif @pre_authorization.submitted? %>
    <input type="submit" class="btn bg-warning" value="Submitted" form="pre_authorization_form" disabled>
  <% end %>
</div>
