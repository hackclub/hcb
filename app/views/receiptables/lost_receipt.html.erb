<% title "Lost receipt statement" %>
<% page_sm %>

<h1>Lost receipt statement</h1>

<% frame_id = "lost_receipt_#{@receiptable.class.name.underscore.tr('/', '_')}_#{@receiptable.id}" %>
<% charged = @receiptable.try(:amount_cents)&.abs %>

<%= turbo_frame_tag frame_id, target: "_top" do %>
  <%# paste stops here so the page's paste-to-upload-a-receipt handler ignores text pasted into this form %>
  <%= form_with model: @statement, scope: :lost_receipt_statement, namespace: frame_id, url: receiptable_mark_no_or_lost_path(receiptable_type: @receiptable.class, receiptable_id: @receiptable.id), data: { turbo: false, controller: "lost-receipt", action: "input->lost-receipt#update paste->lost-receipt#update:stop" } do |form| %>
    <%= form_errors @statement, "statement" %>
    <%= hidden_field_tag :s, params[:s], id: nil %>
    <%= hidden_field_tag :return_to, params[:return_to], id: nil, data: { lost_receipt_target: "returnTo" } %>

    <h3 class="mt-0 mb-2">Purchase details</h3>
    <div class="card mb-4 flex flex-col gap-3">
      <div class="sm:flex items-center justify-between">
        <%= form.label :merchant %>
        <%= form.text_field :merchant, required: true, class: "!max-w-full sm:!max-w-[250px]" %>
      </div>
      <div class="sm:flex items-center justify-between">
        <%= form.label :date, "Purchase date" %>
        <%= form.date_field :date, required: true, max: Date.current.iso8601, class: "!max-w-full sm:!max-w-[250px]" %>
      </div>
      <div>
        <%= form.label :purpose, "What was this purchase for?" %>
        <%= form.text_area :purpose, required: true, rows: 2, placeholder: "Snacks for our weekly club meeting", class: "!max-w-full mt-1" %>
      </div>
    </div>

    <h3 class="mb-2">Items</h3>
    <div class="card mb-4">
      <span class="muted block mb-2">List tax, tips, and fees as their own items.</span>
      <div class="flex flex-col gap-2" data-lost-receipt-target="items">
        <%= form.fields_for :items do |item_form| %>
          <%= render "receiptables/lost_receipt_item", form: item_form %>
        <% end %>
      </div>
      <template data-lost-receipt-target="template">
        <%= form.fields_for :items, LostReceipt::Item.new(quantity: 1), child_index: "NEW_ITEM" do |item_form| %>
          <%= render "receiptables/lost_receipt_item", form: item_form %>
        <% end %>
      </template>
      <div class="flex items-center justify-between mt-3">
        <button type="button" class="btn btn-small bg-muted" data-action="lost-receipt#add" data-lost-receipt-target="addButton">
          <%= inline_icon "plus", size: 20 %>
          Add item
        </button>
        <p class="m-0">
          Total <output class="bold" data-lost-receipt-target="total" aria-live="polite">$0.00</output>
          <% if charged %><span class="muted">of <%= render_money charged %></span><% end %>
        </p>
      </div>
    </div>

    <h3 class="mb-2">Confirmation</h3>
    <div class="card mb-4 flex flex-col gap-3">
      <div class="sm:flex items-center justify-between">
        <%= form.label :signer_name, "Your full name" %>
        <%= form.text_field :signer_name, required: true, autocomplete: "name", class: "!max-w-full sm:!max-w-[250px]" %>
      </div>
      <div class="field field--checkbox !items-start mb-0">
        <%= form.check_box :confirmed, required: true, class: "mt-1 shrink-0" %>
        <%= form.label :confirmed, LostReceipt::Statement::CONFIRMATION %>
      </div>
    </div>

    <%= tag.button type: "submit", class: "gap-2 btn w-full bg-blue mt-2", data: { disable_with: "Submitting..." } do %>
      Submit statement
      <%= inline_icon "send" %>
    <% end %>
    <p class="muted text-sm text-center mt-3 mb-0">Lost receipt statements are reviewed by HCB operations. We'll contact you if we need more details.</p>
  <% end %>
<% end %>
