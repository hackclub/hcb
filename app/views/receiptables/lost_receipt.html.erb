<% title "Lost receipt statement" %>
<% charged = @receiptable.try(:amount_cents)&.abs %>
<% subtitle [@receiptable.try(:memo), (render_money(charged) if charged)].compact.join(" · ") %>

<%= render "receiptables/lost_receipt_steps", form: true %>

<%= form_with model: @statement, scope: :lost_receipt_statement, url: receiptable_mark_no_or_lost_path(receiptable_type: @receiptable.class, receiptable_id: @receiptable.id), data: { turbo: false, controller: "lost-receipt", lost_receipt_charged_value: charged, action: "input->lost-receipt#update" } do |form| %>
  <%= form_errors @statement, "statement" %>
  <%= hidden_field_tag :s, params[:s], id: nil %>
  <%= hidden_field_tag :return_to, @return_to, id: nil %>
  <%= hidden_field_tag :continue, 1, id: nil %>

  <% event = @statement.receiptable.try(:event) %>
  <div class="paper-receipt__printer">
    <div class="paper-receipt">
      <span class="paper-receipt__stamp" aria-hidden="true">LOST</span>
      <span class="paper-receipt__coffee" aria-hidden="true"></span>

      <div class="paper-receipt__head">
        <%= image_tag "logo-production.svg", width: 36, height: 36, alt: "" %>
        <strong>HCB</strong>
        Statement in lieu of<br>
        a receipt that got away
        <small><%= Time.current.strftime("%m/%d/%Y %l:%M %p") %> · Cashier: <%= current_user&.first_name.presence || "You" %></small>
      </div>
      <hr>

      <div data-scroll-seek-target="section">
        <div class="paper-receipt__row">
          <%= form.label :merchant %>
          <%= form.text_field :merchant, required: true %>
        </div>
        <div class="paper-receipt__row">
          <%= form.label :date, "Bought on" %>
          <%= form.date_field :date, required: true, max: Date.current.iso8601 %>
        </div>
        <%= form.label :purpose, "What was it for?", class: "uppercase block mt-2" %>
        <%= form.text_area :purpose, required: true, rows: 2, placeholder: "Snacks for our weekly club meeting" %>
      </div>
      <hr>

      <div data-scroll-seek-target="section">
        <div class="paper-receipt__columns" aria-hidden="true">
          <span>Qty</span><span>Item</span><span>Each</span><span></span>
        </div>
        <div data-lost-receipt-target="items">
          <%= form.fields_for :items do |item_form| %>
            <%= render "receiptables/lost_receipt_item", form: item_form %>
          <% end %>
        </div>
        <template data-lost-receipt-target="template">
          <%= form.fields_for :items, LostReceipt::Item.new(quantity: 1), child_index: "NEW_ITEM" do |item_form| %>
            <%= render "receiptables/lost_receipt_item", form: item_form %>
          <% end %>
        </template>
        <button type="button" class="paper-receipt__add" data-action="lost-receipt#add" data-lost-receipt-target="addButton">+ Add item</button>
        <hr>

        <div class="paper-receipt__row paper-receipt__total">
          <span>Total</span>
          <span>$<output data-lost-receipt-target="total" aria-live="polite">0.00</output></span>
        </div>
        <% if charged %>
          <div class="paper-receipt__row">
            <span>Card was charged</span>
            <span><%= render_money charged %></span>
          </div>
        <% end %>
        <div class="paper-receipt__row">
          <span>Items</span>
          <span data-lost-receipt-target="count">1</span>
        </div>
        <p class="paper-receipt__mismatch" role="status" data-lost-receipt-target="mismatch" hidden></p>
        <p class="paper-receipt__balanced" aria-hidden="true">ADDS UP</p>
      </div>
      <hr>

      <div data-scroll-seek-target="section">
        <div class="flex items-start gap-2">
          <%= form.check_box :confirmed, required: true, class: "mt-1 shrink-0" %>
          <%= form.label :confirmed, LostReceipt::Statement::CONFIRMATION %>
        </div>
        <% if (sentence = @statement.required_acknowledgement) %>
          <%= form.label :acknowledgement, "Now type this out. Yes, all of it.", class: "uppercase block mt-3" %>
          <span class="paper-receipt__sentence"><%= sentence %></span>
          <%= form.text_area :acknowledgement, required: true, rows: 4, autocomplete: "off", spellcheck: false, data: { lost_receipt_target: "acknowledgement", sentence: } %>
        <% end %>
        <div class="paper-receipt__signature">
          <%= form.label :signer_name, "Sign: X", class: "uppercase shrink-0" %>
          <%# Not prefilled or autofilled: typing the name is the signature. %>
          <%# Only a signed-in user's own name is put in the page; the emailed link is checked on the server. %>
          <%= form.text_field :signer_name, required: true, autocomplete: "off", placeholder: current_user&.full_name, aria: { label: "Type your full name to sign" }, data: { lost_receipt_target: "signature", name: current_user&.full_name } %>
        </div>
      </div>

      <div class="paper-receipt__barcode" aria-hidden="true"></div>
      <div class="paper-receipt__foot">
        <%= @receiptable.try(:hcb_code) || @receiptable.to_global_id %>
        <% if event %>
          <p>Lost receipt no. <%= event.lost_receipt_filings.count + 1 %> for <%= event.name %></p>
        <% end %>
        <p>No returns. No refunds. No more losing receipts.</p>
        <p>*** Please keep the next one ***</p>
      </div>
    </div>
  </div>

  <%= tag.button type: "submit", class: "gap-2 btn w-full bg-blue mt-2", data: { disable_with: "Submitting...", lost_receipt_target: "submit" } do %>
    Submit statement
    <%= inline_icon "send" %>
  <% end %>
  <p class="muted mt-3 text-center text-sm">Lost receipt statements are reviewed by HCB operations. We'll contact you if we need more details.</p>
<% end %>
