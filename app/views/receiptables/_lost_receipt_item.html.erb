<div class="flex flex-wrap items-center gap-2" data-lost-receipt-target="item" data-index="<%= form.index %>">
  <%= form.text_field :description, required: true, placeholder: "Description", class: "!max-w-full basis-full sm:basis-0 flex-1 min-w-0", aria: { label: "Description" } %>
  <div class="flex-1 sm:flex-none sm:w-20 min-w-0">
    <%= form.number_field :quantity, required: true, min: 1, max: 10_000, step: 1, placeholder: "Qty", class: "!max-w-full", aria: { label: "Quantity" }, data: { amount: "quantity" } %>
  </div>
  <div class="flex items-center input py-0 !max-w-full flex-1 sm:flex-none sm:w-32 min-w-0">
    <span class="bold muted">$</span>
    <%= form.number_field :unit_amount, value: form.object.unit_amount_cents.nil? ? nil : form.object.unit_amount.to_s, required: true, min: 0, max: 1_000_000, step: "0.01", placeholder: "0.00", class: "!border-0 !shadow-none !max-w-full !min-w-full", aria: { label: "Price each, in US dollars" }, data: { amount: "price", controller: "truncate-decimal", action: "truncate-decimal#truncate" } %>
  </div>
  <button type="button" class="pop shrink-0" aria-label="Remove item" data-action="lost-receipt#remove" data-lost-receipt-target="removeButton">
    <%= inline_icon "view-close", size: 24 %>
  </button>
</div>
