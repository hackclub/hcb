<div class="paper-receipt__item" data-lost-receipt-target="item" data-index="<%= form.index %>">
  <%= form.number_field :quantity, required: true, min: 1, max: 10_000, step: 1, aria: { label: "Quantity" }, data: { amount: "quantity" } %>
  <%= form.text_field :description, required: true, placeholder: "Drip coffee", aria: { label: "Description" } %>
  <span class="paper-receipt__price">
    $<%= form.number_field :unit_amount, value: form.object.unit_amount_cents.nil? ? nil : form.object.unit_amount.to_s, required: true, min: 0, max: 1_000_000, step: "0.01", placeholder: "5.00", aria: { label: "Price each" }, data: { amount: "price", controller: "truncate-decimal", action: "truncate-decimal#truncate" } %>
  </span>
  <button type="button" class="paper-receipt__remove" aria-label="Remove item" data-action="lost-receipt#remove" data-lost-receipt-target="removeButton">
    <%= inline_icon "delete", size: 20 %>
  </button>
</div>
