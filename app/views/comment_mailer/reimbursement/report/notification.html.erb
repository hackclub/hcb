<% report = @commentable %>

<%= @comment.user.name %> <%= @comment.action_text %> on <i><%= report.name %></i> in <i><%= report.event.name %></i>:

<blockquote><%= MarkdownService.instance.render(@comment.content, record: @comment, location: :email) %></blockquote>

<%= link_to "View and reply to this comment", reimbursement_report_url(report, hash: "comment-#{@comment.hashid}"), class: "info" %> on HCB, or send a reply to this email.

<p>
  <small>
    <%= link_to "Manage the comments you get notified for.", my_settings_url %>
  </small>
</p>
