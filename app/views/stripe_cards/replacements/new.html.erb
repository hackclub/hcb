<%= turbo_frame_tag @flow.frame_id do %>
  <% submit_data = @flow.requires_confirmation?(@step) ? { form_disable_target: "submitButton" } : {} %>
  <%# The reason step renders its own reason inputs when the cardholder picks one %>
  <% picks_reason = @flow.chooses_reason? && @step == "reason" %>

  <%# Ordering from a dispute redirects on to the dispute form on another site,
      which Turbo can't follow, so that submits as a regular form %>
  <% form_data = if @flow.last_step?(@step)
                   @flow.dispute ? { turbo: "false" } : { turbo_frame: "_top" }
                 else
                   {}
                 end %>

  <%= form_with url: @flow.last_step?(@step) ? stripe_card_replacement_path(@stripe_card) : new_stripe_card_replacement_path(@stripe_card),
                method: @flow.last_step?(@step) ? :post : :get,
                data: { **form_data, controller: ("form-disable" if @flow.requires_confirmation?(@step)) }.compact do %>
    <%= hidden_field_tag :dispute, @flow.dispute.hashid, id: nil if @flow.dispute %>
    <% if @flow.last_step?(@step) %>
      <%= hidden_field_tag :reason, @flow.reason, id: nil %>
    <% else %>
      <%= hidden_field_tag :flow, @flow.key, id: nil %>
      <%= hidden_field_tag :step, @flow.next_step(@step), id: nil %>
      <%= hidden_field_tag :reason, @flow.reason, id: nil unless picks_reason %>
    <% end %>

    <div class="flex items-center gap-3 mb-4">
      <div class="flex gap-1 flex-1" aria-hidden="true">
        <% @flow.steps.each_with_index do |_, index| %>
          <div class="h-1 flex-1 rounded-full <%= index < @flow.step_number(@step) ? "bg-primary" : "bg-gray-200 dark:bg-gray-700" %>"></div>
        <% end %>
      </div>
      <p class="text-sm muted m-0 whitespace-nowrap">Step <%= @flow.step_number(@step) %> of <%= @flow.steps.size %></p>
    </div>

    <%= render StripeCard::ReplacementFlow::STEP_PARTIALS.fetch(@step), flow: @flow, stripe_card: @stripe_card %>

    <div class="flex items-center justify-between gap-2 mt-6">
      <% if @flow.previous_step(@step) %>
        <%= link_to new_stripe_card_replacement_path(@stripe_card, **@flow.params(step: @flow.previous_step(@step))), class: "btn bg-muted" do %>
          <%= inline_icon "view-back" %>
          Back
        <% end %>
      <% elsif @step == "compromised" %>
        <%= link_to dispute_hcb_code_path(@flow.dispute), class: "btn bg-muted", data: { turbo: false } do %>
          <%= inline_icon "flag-fill" %>
          No, just dispute the transaction
        <% end %>
      <% else %>
        <span></span>
      <% end %>

      <% if @flow.last_step?(@step) %>
        <%= button_tag type: :submit, name: nil, class: "btn bg-primary", data: submit_data do %>
          <%= inline_icon "card-add" %>
          Order replacement card
        <% end %>
      <% else %>
        <%= button_tag type: :submit, name: nil, class: "btn bg-primary", data: submit_data do %>
          Continue
          <%= inline_icon "view-forward" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
