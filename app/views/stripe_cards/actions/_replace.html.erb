<%# locals: (stripe_card:, flow:, label:, icon:) %>

<% if policy(stripe_card).replace? %>
  <% flow = StripeCard::ReplacementFlow.new(stripe_card:, flow:) %>
  <% src = new_stripe_card_replacement_path(stripe_card, **flow.params) %>

  <%= link_to src,
              class: "btn btn--list-item",
              data: { behavior: "modal_trigger", modal: flow.dom_id(:modal) } do %>
    <%= inline_icon icon %>
    <div>
      <p><strong><%= label %></strong></p>
    </div>
  <% end %>

  <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="<%= flow.dom_id(:modal) %>">
    <%= modal_header flow.title %>
    <%= turbo_frame_tag flow.frame_id, src:, loading: :lazy do %>
      <%= render "application/loading_container", klass: "py-8" %>
    <% end %>
  </section>
<% end %>
