<%# locals: (stripe_card:, label: "", subtitle: "", variant: "list_item") %>

<% control = variant.to_s == "control" %>

<% if stripe_card&.stripe_status == 'inactive' %>
  <% defrost_tooltip = subtitle.presence || "Instantly re-freeze #{stripe_card.user == current_user ? "your" : stripe_card.user.possessive_name} card anytime" %>
  <% defrost_subtitle = policy(stripe_card).defrost? ? defrost_tooltip : "You don't have permission to perform this action" %>
  <% if control %>
    <%= button_to defrost_stripe_card_path(stripe_card),
                  method: :post,
                  form_class: "contents",
                  class: "grant-action",
                  disabled: !policy(stripe_card).defrost?,
                  data: { turbo: true, turbo_frame: "_top" } do %>
      <%# `label`/`subtitle` describe freezing, so the frozen state has its own copy. %>
      <%= render "card_grants/control", title: "Card frozen", description: policy(stripe_card).defrost? ? "Defrost it to start spending again" : "You don't have permission to perform this action", cta: "Defrost" %>
    <% end %>
  <% else %>
    <%= button_to defrost_stripe_card_path(stripe_card),
                  method: :post,
                  form_class: "contents",
                  class: "btn btn--list-item",
                  disabled: !policy(stripe_card).defrost?,
                  data: { turbo: true, turbo_frame: "_top" } do %>
      <%= inline_icon "freeze" %>
      <div>
        <strong>Defrost</strong>
        <p class="text-sm opacity-60"><%= defrost_subtitle %></p>
      </div>
    <% end %>
  <% end %>
<% elsif stripe_card&.stripe_status == 'active' %>
  <% freeze_tooltip = subtitle.presence || label.presence || "Instantly freeze #{stripe_card.user == current_user ? "your" : stripe_card.user.possessive_name} card anytime" %>
  <% freeze_subtitle = policy(stripe_card).freeze? ? freeze_tooltip : "You don't have permission to perform this action" %>
  <% if control %>
    <%= button_to freeze_stripe_card_path(stripe_card),
                  method: :post,
                  form_class: "contents",
                  class: "grant-action",
                  disabled: !policy(stripe_card).freeze?,
                  data: { turbo: true, turbo_frame: "_top" } do %>
      <%= render "card_grants/control", title: label.presence || "Freeze", description: freeze_subtitle, cta: "Freeze" %>
    <% end %>
  <% else %>
    <%= button_to freeze_stripe_card_path(stripe_card),
                  method: :post,
                  form_class: "contents",
                  class: "btn btn--list-item",
                  disabled: !policy(stripe_card).freeze?,
                  data: { turbo: true, turbo_frame: "_top" } do %>
      <%= inline_icon "freeze" %>
      <div>
        <strong>Freeze</strong>
        <p class="text-sm opacity-60"><%= freeze_subtitle %></p>
      </div>
    <% end %>
  <% end %>
<% elsif !stripe_card&.canceled? %>
  <% if control %>
    <button type="button" class="grant-action" disabled>
      <%= render "card_grants/control", title: "Freeze", description: "This card cannot be frozen because it has not been activated", cta: "Freeze" %>
    </button>
  <% else %>
    <button type="button" class="btn btn--list-item" disabled>
      <%= inline_icon "freeze" %>
      <div>
        <strong>Freeze</strong>
        <p class="text-sm opacity-60">This card cannot be frozen because it has not been activated</p>
      </div>
    </button>
  <% end %>
<% end %>
