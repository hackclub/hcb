<%# locals: (count: 6) %>

<article class="mixed-grid grid--spacious motion-safe:animate-pulse" aria-busy="true" aria-label="Loading cards">
  <% count.times do %>
    <div>
      <div class="stripe-card stripe-card--skeleton mt1">
        <span class="block h-5 w-3/4 rounded-full bg-snow dark:bg-dark"></span>
        <span class="flex justify-between items-center">
          <span class="block h-4 w-1/3 rounded-full bg-snow dark:bg-dark"></span>
          <span class="block h-4 w-1/6 rounded-full bg-snow dark:bg-dark"></span>
        </span>
      </div>
      <span class="block h-4 w-1/3 mx-auto mt2 rounded-full bg-smoke dark:bg-darkless"></span>
    </div>
  <% end %>
</article>
