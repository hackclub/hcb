<%# locals: (count:, first_column: "Name") %>

<article class="table-container motion-safe:animate-pulse" aria-busy="true" aria-label="Loading cards">
  <table class="stripe-cards-table">
    <thead>
      <tr>
        <th><%= first_column %></th>
        <th>Number</th>
        <th>Type</th>
        <th>Status</th>
        <th>Issued on</th>
      </tr>
    </thead>
    <tbody>
      <% count.times do %>
        <tr>
          <% %w[w-1/2 w-3/4 w-1/2 w-1/2 w-2/3].each do |width| %>
            <td><span class="block h-4 my-1 <%= width %> rounded-full bg-smoke dark:bg-darkless"></span></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</article>
