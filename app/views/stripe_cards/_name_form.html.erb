<%= form_with(model: @card) do |form| %>
  <div class="field">
    <%= form.label :name %>

    <div class="flex gap-3 items-stretch">
      <%= form.text_field :name, placeholder: "Online Retailers" %>
      <% if @card.name.present? %>
        <%# Submits the form below, so Enter in the name field still saves. %>
        <button class="btn bg-error px-3 tooltipped tooltipped--s overflow-visible" aria-label="Clear name" type="submit" form="clear_card_name">
          <%= inline_icon "delete", class: "!m-0" %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit "Save" %>
  </div>
<% end %>

<% if @card.name.present? %>
  <%= form_with(model: @card, id: "clear_card_name") do |form| %>
    <%= form.hidden_field :name, value: "" %>
  <% end %>
<% end %>
