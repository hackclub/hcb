<%# locals: (event:, payee:, destination: "payments", selected: nil) %>

<% cancel_path = selected ? new_recipient_transfer_path(destination, event, payee_id: payee.hashid) : new_recipient_transfer_path(destination, event) %>

<div data-scroll-seek-target="section">
  <h3 class="mb-2">Edit recipient</h3>
  <div class="card mb-4">
    <%= form_with(model: payee, url: event_payee_path(event_id: event.slug, id: payee.hashid), method: :patch, local: true) do |form| %>
      <%= hidden_field_tag :destination, destination %>
      <div class="flex flex-col gap-3">
        <div>
          <%= form.label :display_name, "Name" %>
          <%= form.text_field :display_name, value: payee.display_name, class: "!max-w-full", required: true %>
        </div>
        <div data-controller="payee-email-check"
             data-payee-email-check-url-value="<%= check_email_event_payees_path(event_id: event.slug, exclude_payee_id: payee.hashid) %>">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, value: payee.email, class: "!max-w-full", required: true, data: { action: "input->payee-email-check#check" } %>
          <div data-payee-email-check-target="warning" hidden>
            <%= render "application/callout", type: "warning", icon: "important", title: "This email is already on another recipient", class: "mt-0 mb-0" do %>
              This email already belongs to <strong data-payee-email-check-target="names"></strong>.
              Keep them separate only if this is a distinct legal entity — for example, the same
              person paid through a different business.
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex gap-2 mt-4">
        <%= link_to "Cancel", cancel_path, class: "btn", data: { turbo_frame: "_top" } %>
        <%= form.submit "Save changes", class: "btn bg-blue" %>
      </div>
    <% end %>
  </div>
</div>
