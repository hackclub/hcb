<% title "Tax information for payment" %>

<h1>Who's receiving this payment?</h1>

<p>
  Before <%= @payee.event.name %> can pay you, we need to know what
  legal entity is receiving this payment for tax purposes.
</p>

<p>
  If you're getting paid on behalf of a business, create a new
  legal entity or choose one you've already created. Otherwise,
  choose yourself.
</p>

<div class="grid grid-cols-3 gap-5">
  <% @legal_entities.each do |le| %>
    <div class="card">
      <p class="text-lg font-bold my-0"><%= le.name %></p>
      <p class="text-muted my-0"><%= le.entity_type.humanize %></p>

      <div class="tooltipped" aria-label="<%= le.tin_banned? ? "This legal entity is banned" : nil %>">
        <%= button_to "Choose", set_legal_entity_payee_path(@payee),
          class: "btn mt-5 w-full",
          params: { legal_entity_id: le.id },
          disabled: le.tin_banned? %>
      </div>
    </div>
  <% end %>

  <%= link_to "Create new legal entity",
              "#",
              class:"btn h-full flex flex-col justify-center",
              data: { behavior: "modal_trigger", modal: "create_le" } %>
</div>

<section id="create_le" class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog">
  <%= modal_header "Create a new legal entity" %>

  <p>Enter the name of the business you're being paid on behalf of.</p>

  <%= form_with url: legal_entities_path, method: :post do |form| %>
    <%= form.hidden_field :payee_id, value: @payee.id %>

    <div class="field">
      <%= form.label :name, "Name" %>
      <%= form.text_field :name, required: true %>
    </div>

    <div class="field">
      <%= form.label :entity_type, "Recipient type" %>
      <%= form.select :entity_type,
          options_for_select([
                                ["An unincorporated business", "business"],
                                ["A corporation", "corporation"]
                              ]),
          required: true %>
    </div>

    <%= form.submit "Create" %>
  <% end %>
</section>
