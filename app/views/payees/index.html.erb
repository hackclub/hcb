<% destination = params[:destination].presence || "payments" %>

<%= turbo_frame_tag :payee_results do %>
  <div class="card px-0 pt-2 pb-0">
  <div class="flex items-center gap-2 px-4 pb-2 pt-1">
    <%= form_with(url: event_payees_path(event_id: @event.slug), method: :get, class: "flex-1", data: { turbo_frame: "payee_results_list", controller: "form" }) do |form| %>
      <%= hidden_field_tag :destination, destination %>
      <%= form.hidden_field :payee_id, value: params[:payee_id] %>
      <div class="input input-group max-w-none">
        <%= inline_icon "search" %>
        <%= form.text_field :q, value: params[:q], placeholder: "Search recipients...", autofocus: true, class: "bg-transparent", autocomplete: "off", data: { action: "input->form#submitDebounced" } %>
      </div>
    <% end %>
    <button type="button" class="btn shrink-0" data-action="payee-picker#showAdding">
      <%= inline_icon "plus" %>
      New
    </button>
  </div>

  <%= turbo_frame_tag :payee_results_list do %>
    <% is_email_query = params[:q].present? && ValidatesEmailFormatOf.validate_email_format(params[:q]).nil? %>
    <% if @payees.any? %>
      <div class="flex items-center justify-between px-5 pt-2 pb-1 text-sm muted">
        <span><%= pluralize(@payees.total_count, params[:q].present? ? "result" : "recipient") %></span>
        <% if @payees.total_pages > 1 %>
          <nav class="flex items-center gap-2" aria-label="Pagination">
            <%= pop_icon_to "view-back", path_to_prev_page(@payees) || "#", icon_size: 20, class: "!w-7 !h-7", disabled: @payees.first_page?, "aria-label": "Previous page" %>
            <span class="tabular-nums"><%= @payees.current_page %> of <%= @payees.total_pages %></span>
            <%= pop_icon_to "view-forward", path_to_next_page(@payees) || "#", icon_size: 20, class: "!w-7 !h-7", disabled: @payees.last_page?, "aria-label": "Next page" %>
          </nav>
        <% end %>
      </div>
      <% @payees.each do |payee| %>
        <div class="btn btn--list-item border-t rounded-none relative">
          <%= link_to "", new_recipient_transfer_path(destination, @event, payee_id: payee.hashid), class: "absolute inset-0", data: { turbo_frame: "_top" }, "aria-label": "Select #{payee.display_name}" %>
          <%= avatar_for_email payee.email, size: 40, class: "rounded-full w-10 h-10 shrink-0" %>
          <div class="flex-1 min-w-0">
            <p class="font-medium truncate"><%= payee.display_name %></p>
            <% legal_name = payee.legal_entity&.name.presence %>
            <% legal_name = nil if legal_name == payee.display_name %>
            <p class="text-sm muted truncate"><%= "#{legal_name} • " if legal_name %><%= payee.email %></p>
          </div>
          <% if payee.managed? %>
            <span class="badge bg-muted shrink-0 relative z-[1] tooltipped tooltipped--w" aria-label="<%= payee.legal_entity.managing_event.name %> entered this recipient's payout information on their behalf">Managed</span>
          <% end %>
          <% if params[:payee_id].to_s == payee.hashid %>
            <span class="badge bg-success shrink-0">Selected</span>
          <% end %>

          <% if policy(payee).update? || policy(payee).archive? %>
            <div data-controller="menu" data-menu-placement-value="bottom-end" class="shrink-0 relative" style="z-index: 1">
              <%= pop_icon_to "more", "#",
                    class: "align-middle muted", "aria-label": "Recipient options",
                    data: { turbo: false, "menu-target": "toggle", action: "menu#toggle click@document->menu#close keydown@document->menu#keydown" } %>
              <div class="menu__content menu__content--2 h5 menu__content--compact" data-menu-target="content">
                <% if policy(payee).update? %>
                  <%= link_to new_recipient_transfer_path(destination, @event, payee_id: payee.hashid, edit_payee: true), class: "flex items-center", data: { turbo_frame: "_top" } do %>
                    <%= inline_icon "edit", size: 24 %>
                    Edit recipient
                  <% end %>
                <% end %>
                <% if policy(payee).archive? %>
                  <%= link_to archive_event_payee_path(event_id: @event.slug, id: payee.hashid, destination:), class: "flex items-center", data: { turbo_method: :post, turbo_frame: "_top", turbo_confirm: "Archive #{payee.display_name}? They'll be hidden from the recipient list." } do %>
                    <%= inline_icon "delete", size: 24 %>
                    Archive recipient
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% elsif params[:q].present? %>
      <div class="px-4 pt-4 pb-6">
        <div class="center w-full">
          <p class="muted mb-3">No recipients match "<%= params[:q] %>"</p>
          <button
              type="button"
              class="btn"
              data-action="payee-picker#showAddingFromSearch" data-payee-picker-query-param="<%= params[:q] %>"
              data-payee-picker-is-email-param="<%= is_email_query %>">
            <%= inline_icon "plus", size: 16 %>
            Add "<%= params[:q] %>" as a new recipient
          </button>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if destination == "payments" %>
    <%= link_to new_disbursement_path(source_event_id: @event.slug), class: "flex items-center gap-2 px-5 py-3 text-sm muted no-underline border-0 border-t border-solid border-smoke dark:border-slate", data: { turbo_frame: "_top" } do %>
      <%= inline_icon "bank-account", size: 20 %>
      Paying another HCB organization?
      <span class="ml-auto font-medium text-blue">HCB transfer &rarr;</span>
    <% end %>
  <% end %>
  </div>
<% end %>
