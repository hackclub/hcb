<%# locals: (ach_transfer:, recipient: (ach_transfer.payment_recipient.to_safe_hash if ach_transfer.payment_recipient&.event&.== ach_transfer.event) || {}, initial_recipient_id: recipient[:id].to_s, initial_editing: ach_transfer.account_number.present?, initial_email: recipient[:email].to_s, initial_bank_name: recipient[:bank_name].to_s, initial_routing_number: recipient[:routing_number].to_s, initial_masked_account_number: recipient[:masked_account_number].to_s) %>
<%# herb:slots client %>
<%# herb:state (selected_payment_recipient_id: initial_recipient_id, selected_editing: initial_editing, selected_email: initial_email, selected_bank_name: initial_bank_name, selected_routing_number: initial_routing_number, selected_masked_account_number: initial_masked_account_number) %>

<% disabled = !policy(ach_transfer.event).create_transfer? %>

<%= form_with(model: ach_transfer, local: true, url: event_ach_transfers_path(ach_transfer.event), data: {
                controller: "input payment-recipient",
                payment_recipient_scope_value: "ach_transfer",
                payment_recipient_recipient_value: recipient.to_json,
                payment_recipient_shown_value: %w[email bank_name routing_number masked_account_number].to_json,
              }) do |form| %>

  <%= form_errors(ach_transfer, "ACH transfer", "We couldn't send this") %>

  <input type="hidden" name="<%= form.field_name(:payment_recipient_id) %>" id="<%= form.field_id(:payment_recipient_id) %>" value="<%= selected_payment_recipient_id %>" autocomplete="off">

  <% if Rails.env.development? %>
    <pre data-payment-recipient-target="debug" class="fixed left-2 bottom-2 min-w-60 hidden lg:block"><%= "Debug info:\n\n#{JSON.pretty_generate(recipient)}" %></pre>
  <% end %>

  <div data-scroll-seek-target="section">
  <h3 class="mb-2">Recipient details</h3>
  <div class="card mb-4 relative flex flex-col gap-3">
    <div id="ach_transfer_name_field" data-controller="menu text-filter" data-menu-content-id-value="payment-recipient-search" data-menu-append-to-value="#ach_transfer_name_field" data-text-filter-empty-class="display-none">
      <%= form.label :recipient_name, "Legal name" %>
      <span class="muted mb-1 block">May be used for tax purposes. Match the name on the recipient's account.</span>
      <%= form.text_field :recipient_name,
                          placeholder: "Max Kern",
                          required: true,
                          disabled:,
                          class: "!max-w-full",
                          role: "combobox",
                          "aria-controls": "#payment-recipient-search",
                          data: {
                            action: "
                              keydown.enter->text-filter#selectFirst
                              click->menu#open
                              focus->menu#open
                              click@document->menu#close
                              keydown@document->menu#keydown
                              input->text-filter#query
                              input->payment-recipient#clear
                            ",
                            menu_target: "toggle",
                            payment_recipient_target: "name",
                          } %>

      <% saved_recipients = ach_transfer.event.payment_recipients.where(payment_model: "AchTransfer") %>
      <% if organizer_signed_in? && saved_recipients.any? %>
        <div class="menu__content menu__content--2" data-menu-target="content" role="listbox" style="width: 24rem">
          <% saved_recipients.each do |payment_recipient| %>
            <div data-name="<%= payment_recipient.name %>" class="flex items-center" data-payment-recipient="<%= payment_recipient.hashid %>">
              <button type="button" class="menu__action flex justify-between flex-auto mr1" data-action="input#focus menu#close payment-recipient#select" data-payment-recipient-recipient-param="<%= payment_recipient.to_safe_json %>">
                <span class="truncate"><%= payment_recipient.name %></span>
                <span class="muted ml1">••••<%= payment_recipient.account_number.slice(-4, 4) %></span>
              </button>
              <%= link_to event_payment_recipient_path(ach_transfer.event, payment_recipient), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to remove this ACH recipient?", turbo_confirm_danger: true } do %>
                <%= inline_icon "view-close", size: 24, class: "align-middle" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <%= form.label :payment_for, "What's this payment for?" %>
      <span class="muted mb-1 block">This is to help HCB keep record of our transactions.</span>
      <%= form.text_field :payment_for, class: "!max-w-full", placeholder: "Shipment of potions", required: true, disabled:, data: { input_target: "input" } %>
    </div>

    <%# Not submitted while a saved recipient is picked, so the server fills them in from it. %>
    <fieldset class="contents" data-payment-recipient-target="editable" hidden="<%= selected_payment_recipient_id.present? && !selected_editing %>" disabled="<%= selected_payment_recipient_id.present? && !selected_editing %>">
      <div>
        <%= form.label :recipient_email, class: "mb-1" %>
        <%= form.email_field :recipient_email, class: "!max-w-full", placeholder: "fionah@gmail.com", required: true, disabled: disabled %>
      </div>
    </fieldset>

    <div class="flex items-center" hidden="<%= selected_payment_recipient_id.empty? || selected_editing %>">
      <label>Recipient email</label>
      <input disabled class="!text-muted bg-transparent" type="text" value="<%= selected_email %>">
    </div>
  </div>
  </div>

  <div data-scroll-seek-target="section">
  <h3 class="mb-2">Payment details</h3>
  <div class="card mb-4 relative">
    <fieldset class="contents" data-payment-recipient-target="editable" hidden="<%= selected_payment_recipient_id.present? && !selected_editing %>" disabled="<%= selected_payment_recipient_id.present? && !selected_editing %>">
      <div class="flex flex-col gap-3">
        <div class="sm:flex items-center justify-between">
          <%= form.label :bank_name %>
          <%= form.text_field :bank_name, class: "!max-w-[250px]", placeholder: "Name of the bank", required: true, disabled: disabled %>
        </div>

        <div
          data-controller="external-validation"
          data-external-validation-url-value="<%= validate_routing_number_ach_transfers_path %>">
          <div class="sm:flex items-center justify-between">
            <%= form.label :routing_number %>
            <%= form.text_field :routing_number, placeholder: "123456789", required: true, disabled:, class: "fs-mask !max-w-[250px]", data: { action: "input->external-validation#validate" } %>
          </div>
          <span class="muted text-sm mt-1 block muted text-center bg-gray-100 dark:bg-neutral-700 rounded-sm py-2 empty:hidden" data-external-validation-target="hint"></span>
        </div>

        <div class="sm:flex items-center justify-between">
          <%= form.label :account_number %>
          <%= form.text_field :account_number, placeholder: "0913338883", required: true, disabled:, class: "fs-mask !max-w-[250px]" %>
        </div>
      </div>
    </fieldset>

    <div hidden="<%= selected_payment_recipient_id.empty? || selected_editing %>">
      <button type="button" class="text-muted cursor-pointer select-none tooltipped tooltipped--w bg-transparent border-none absolute top-3 right-3" aria-label="Edit payment details" data-action="payment-recipient#edit" data-payment-recipient-focus-param="ach_transfer_bank_name">
        <%= inline_icon "pen", size: 18 %>
      </button>

      <div class="sm:flex items-center"><label>Bank name</label><input disabled class="!text-muted bg-transparent" type="text" value="<%= selected_bank_name %>"></div>
      <div class="sm:flex items-center"><label>Routing number</label><input disabled class="!text-muted bg-transparent" type="text" value="<%= selected_routing_number %>"></div>
      <div class="sm:flex items-center"><label>Account number</label><input disabled class="!text-muted bg-transparent" type="text" value="<%= selected_masked_account_number %>"></div>
    </div>
  </div>

  <div class="card mb-4 relative flex flex-col gap-3">
    <div class="flex justify-between items-center">
      <%= form.label :amount_money, "Amount" %>
      <div class="flex items-center">
        <div class="input flex gap-2 items-center py-0">
          <span class="bold muted">$</span>
          <%= form.number_field :amount_money, placeholder: "500.00", step: 0.01, min: 0.01, required: true, disabled:, data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad" }, class: "!p-0 !border-none !shadow-none min-h-auto" %>
        </div>
      </div>
    </div>

    <div class="sm:flex items-center justify-between">
      <div>
        <%= form.label :invoiced_at, "Invoice date" %>
        <span class="muted">When were you invoiced for this payment?</span>
      </div>
      <%= form.date_field :invoiced_at, disabled:, style: "max-width: 190px", max: Date.current %>
    </div>

    <%= render "events/transfers/notify_recipient", form:, disabled: disabled %>
    <%= render "events/transfers/attach_receipt", form:, disabled: disabled %>
  </div>
  </div>

  <% admin_tool do %>
    <div data-scroll-seek-target="section">
    <h3 class="mb-2">Admin</h3>
    <div class="card mb-4 relative">
      <div class="field">
        <%= form.label :scheduled_on, "Schedule for" %>
        <%= form.date_select :scheduled_on, prompt: true, order: [:month, :day, :year], start_year: Date.today.year %>
        <p class="h5 muted mt0 mb1">Leave blank to send instantly</p>
      </div>
      <p class="h5 muted mt0 mb1">See <%= link_to "this page", "https://column.com/docs/ach/timing", target: "_blank" %> for ACH timing details.</p>
    </div>
    </div>
  <% end %>

  <%= tag.button type: "submit", class: "gap-2 btn w-full bg-blue mt-2", disabled: do %>
    Send transfer
    <%= inline_icon "send" %>
  <% end %>
<% end %>
