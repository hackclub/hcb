<%# locals: (form:, disabled:, excluded_fields: [], model: WiseTransfer) %>

<% (WiseTransfer::AVAILABLE_CURRENCIES + [nil]).each do |currency| %>
  <template x-if="currency == '<%= currency.nil? ? "null" : currency %>'">
    <div>
      <% model.information_required_for(currency.nil? ? nil : currency).each do |field| %>
        <% unless (field[:key]).in?(excluded_fields) %>
        <div class="field <%= "flex flex-row-reverse items-center justify-end gap-2" if field[:type] == :check_box %>" <% unless field[:type] == :segmented_date %> x-on:change="<%= field[:key] %> = <%= field[:type] == :check_box ? "$event.target.checked" : "$event.target.value" %>" <% end %> <% if field[:conditional] %> x-show="<%= field[:conditional] %>" <% end %>>
          <%= form.label field[:key], field[:label], (field[:label_options] || {}) %>
          <% if field[:type] == :select %>
            <%= form.select field[:key], options_for_select(field[:options].to_a), disabled:, prompt: "Select one...", "x-bind:required": "#{field[:conditional] || "true"} && #{field[:required].nil? || field[:required]}" %>
          <% elsif field[:type] == :segmented_date %>
            <% current_value = form.object.try(field[:key]) %>
            <% picker_id = "#{form.object_name}-#{field[:key]}".parameterize %>
            <div data-controller="menu" class="relative">
              <div class="input input-group cursor-text" data-menu-target="toggle" data-action="click->menu#toggle click@document->menu#close keydown@document->menu#keydown">
                <div data-controller="segmented-data-input" data-segmented-data-input-initial-value="<%= current_value %>" data-segmented-data-input-picker-id-value="<%= picker_id %>" class="flex items-center flex-1">
                  <input type="text" inputmode="numeric" maxlength="2" placeholder="MM" class="segment w-7 text-center outline-none" data-segmented-data-input-target="month" data-action="input->segmented-data-input#onMonthInput keydown->segmented-data-input#onKeydown">
                  <span class="text-gray-300">/</span>
                  <input type="text" inputmode="numeric" maxlength="2" placeholder="DD" class="segment w-7 text-center outline-none" data-segmented-data-input-target="day" data-action="input->segmented-data-input#onDayInput keydown->segmented-data-input#onKeydown">
                  <span class="text-gray-300">/</span>
                  <input type="text" inputmode="numeric" maxlength="4" placeholder="YYYY" class="segment w-11 text-center outline-none" data-segmented-data-input-target="year" data-action="input->segmented-data-input#onYearInput keydown->segmented-data-input#onKeydown">
                  <%= form.hidden_field field[:key], data: { "segmented-data-input-target": "hidden" }, "x-bind:required": "#{field[:conditional] || "true"} && #{field[:required].nil? || field[:required]}" %>
                </div>
                <%= inline_icon "calendar", size: 16, class: "ml-auto text-gray-400" %>
              </div>
              <div class="menu__content p-2" data-menu-target="content">
                <div data-controller="date-range-picker" data-date-range-picker-mode-value="single" data-date-range-picker-initial-start-value="<%= current_value %>" data-picker-id="<%= picker_id %>"></div>
              </div>
            </div>
          <% else %>
            <%= form.send(field[:type], field[:key], placeholder: field[:placeholder], pattern: field[:pattern], disabled:, "x-bind:required": "#{field[:conditional] || "true"} && #{field[:required].nil? || field[:required]}") %>
          <% end %>
          <% if field[:description].present? || field[:refer_to].present? %>
            <div class=" muted mt1 ">
              <%= field[:description] %>
              <% if field[:refer_to] %>
                <%= link_to "Refer to this document", field[:refer_to], target: "_blank" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <% end %>
      <% end %>
    </div>
  </template>
<% end %>

<% unsupported_account_type_reasons = HasWiseRecipient::UNSUPPORTED_ACCOUNT_TYPES.keys.index_with { |type| HasWiseRecipient.unsupported_account_type_reason(type) } %>
<template x-if="<%= unsupported_account_type_reasons.keys.to_json %>.includes(account_type)">
  <div class="flex items-start gap-1 warning mb2">
    <%= inline_icon "important", size: 20, class: "flex-shrink-0" %>
    <span x-text="<%= unsupported_account_type_reasons.to_json %>[account_type]"></span>
  </div>
</template>
