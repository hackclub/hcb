<%= turbo_frame_tag :subscriptions do %>
  <h2 class="heading h2 leading-[1.5] mt2 ml0 pt1 pb1 pl2 pr2">Previous transactions for this subscription</h2>

  <div class="table-container mb4">
    <table>
      <tbody data-behavior="transactions">
        <% @hcb_codes.order(created_at: :desc).each do |hcb_code| %>
          <%# Rows are their own drop targets: the page's upload form takes drops anywhere in the window. %>
          <% receipt_upload_button = @receipt_upload && ReceiptablePolicy.new(current_user, hcb_code.ledger_item).upload? %>
          <% if hcb_code.canonical_transactions.any? %>
            <%= render partial: "canonical_transactions/canonical_transaction", locals: { ct: hcb_code, force_display_details: true, show_tags: true, receipt_upload_button: } %>
          <% else %>
            <%= render partial: "canonical_pending_transactions/canonical_pending_transaction", collection: hcb_code.canonical_pending_transactions, as: :pt, locals: { show_tags: true, receipt_upload_button: } %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <hr>
<% end %>
