<% title "Create an invoice" %>
<% page_xs %>
<%= render "events/nav" %>

<h1>Send an Invoice</h1>

<% if @event.invoices.none? %>
  <%= render "application/callout", type: "info", title: "We recommend sending yourself an invoice for $1 to understand what your sponsors will see." %>
<% else %>
  <p class="h5 leading-[1.25] muted mt0 mb2">
    Invoices can be paid with a card or bank transfer (ACH / Wire). If your
    sponsor wants to pay via a mailed check instead, please reach out to the
    HCB team and we'll help you coordinate the receival of the check.
    <%= help_message %>
  </p>
<% end %>

<%= render "invoices/form", invoice: @invoice, sponsor: @sponsor %>
