<%# locals: (description:, feature_flag:, id:, name:, classes: nil, disable_warning: nil, event: nil, footer: nil, fully_shipped: nil, unlisted: nil, user: nil) %>

<%# leaving current_user just so we don't get a NilClassPolicy error ever %>
<% disabled = !policy(event || user || current_user).update? %>

<% if !unlisted || !defined?(@shown_private_feature_previews) || @shown_private_feature_previews&.include?(id) || Flipper.enabled?(feature_flag, event || user) %>
  <div class="card pb0 mb3" id="<%= id %>">
    <div class="card__banner card__banner--top flex justify-between items-center <%= classes&.any? ? classes.join(" ") : "feature-generic" %>">
      <h3 class="h1 pt2 pb2 my0 color-black"><%= name %></h3>
      <% if fully_shipped || Flipper.enabled?(feature_flag) %>
        <%# Feature is enabled for all users, don't include a choice %>
        <div class="actions tooltipped tooltipped--w inline-block mt1" aria-label="This feature is now generally available!">
          <span class="btn bg-success btn-small disabled">Shipped!</span>
        </div>
      <% elsif Flipper.enabled?(feature_flag, event || user) %>
        <%= button_to(
              "Disable",
              disable_feature_path(
                feature: feature_flag,
                event_id: event&.id,
                user_id: user&.id
              ),
              data: { turbo_confirm: disable_warning, turbo_frame: "_top" },
              class: "btn bg-accent",
              disabled:
            ) %>
      <% else %>
        <%= button_to(
              "Enable",
              enable_feature_path(
                feature: feature_flag,
                event_id: event&.id,
                user_id: user&.id
              ),
              data: { turbo_frame: "_top" },
              class: "btn bg-info",
              disabled:
            ) %>
      <% end %>
    </div>
    <p class="m-0 mb-4">
      <%= sanitize(description) %>
    </p>
    <% if footer.present? %>
      <section class="card__banner card__darker secondary border-top mt-4">
        <p class="m-0">
          <%= sanitize(footer, attributes: %w(href data-turbo-action data-turbo-method)) %>
        </p>
      </section>
    <% end %>
  </div>
<% end %>
