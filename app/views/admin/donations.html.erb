<% title "Donations" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: donations_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= form.text_field :ip_address, value: params[:ip_address], placeholder: "IP Address" %>
    <%= form.text_field :user_agent, value: params[:user_agent], placeholder: "User Agent" %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :deposited, label: "Deposited", checked: @deposited %>
    <%= render "admin/filters/toggle", form:, name: :in_transit, label: "In transit", checked: @in_transit %>
    <%= render "admin/filters/toggle", form:, name: :failed, label: "Failed", checked: @failed %>
    <%= render "admin/filters/toggle", form:, name: :missing_payout, label: "Missing payout", checked: @missing_payout %>
    <%= render "admin/filters/toggle", form:, name: :missing_fee_reimbursement, label: "Missing fee reimbursement", checked: @missing_fee_reimbursement %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Recipient</th>
      <th>Anonymous</th>
      <th>Tax-Deductible</th>
      <th>Amount</th>
      <th>Status</th>
      <th>PayoutId</th>
      <th>FeeReimbursementId</th>
      <th>IP Address</th>
      <th>User Agent</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @donations.each do |donation| %>
      <tr class="<%= "shade-cyan" if donation.in_transit? %>">
        <td><%= donation.id %></td>
        <td>
          <%= donation.created_at.strftime("%Y-%m-%d") %>
          <% if donation.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td>
          <%= link_to donation_path(donation), data: admin_popover_data_for(donation) do %>
            <%= donation.event.name.upcase %>: <%= donation.name(show_anonymous: true) %>
          <% end %>
        </td>
        <td><%= donation.anonymous? %></td>
        <td><%= donation.tax_deductible? %></td>
        <td><%= render_money_amount(donation.amount) %></td>
        <td><%= donation.aasm_state.upcase %></td>
        <td><%= donation.payout_id %></td>
        <td><%= donation.fee_reimbursement_id %></td>
        <td><%= donation.ip_address %></td>
        <td><%= donation.user_agent %></td>
        <td>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @donations, entry_name: "donations" %>
  </div>
  <%= paginate @donations %>
</div>

</div>
