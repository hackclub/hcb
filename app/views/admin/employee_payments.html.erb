<% title "Payments" %>

<%= form_with method: :get, class: "card filter-form flex flex-col gap-2.5 p-3" do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="flex items-center mb2 flex-col sm:flex-row">
  <div class="flex-grow">
    <%= page_entries_info @payments, entry_name: "employee payments" %>
  </div>
</div>

<%= render "employees/payments", payments: @payments, show_stats: false %>

<%= paginate @payments %>
