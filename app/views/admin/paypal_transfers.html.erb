<% title "PayPal Transfers" %>

<%= form_with local: true, class: "card admin-filters", url: paypal_transfers_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Event</th>
      <th>Recipient</th>
      <th class="w-32">Amount</th>
      <th>Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @paypal_transfers.each do |paypal_transfer| %>
      <tr class="<%= "admin-bg-pending" if paypal_transfer.pending? %>">
        <td><%= paypal_transfer.id %></td>
        <td><%= paypal_transfer.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= paypal_transfer.event.name %></td>
        <td><%= paypal_transfer.recipient_name %></td>
        <td><%= render_money(paypal_transfer.amount) %></td>
        <td><%= paypal_transfer.aasm.human_state %></td>
        <td>
          <div class="flex items-center gap-2">
            <%= pop_icon_to "external", hcb_code_path(paypal_transfer.hcb_code), "aria-label": "View", data: admin_popover_data_for(paypal_transfer) %>
            <%= link_to "Process", paypal_transfer_process_admin_path(paypal_transfer), class: "btn", data: admin_process_popover_data(paypal_transfer) %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @paypal_transfers, entry_name: "transfers" %>
  </div>
  <%= paginate @paypal_transfers %>
</div>

</div>
