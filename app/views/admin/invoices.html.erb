<% title "Invoices" %>

<%= form_with local: true, class: "card admin-filters", url: invoices_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :open, label: "Open", checked: @open %>
    <%= render "admin/filters/toggle", form:, name: :paid, label: "Paid", checked: @paid %>
    <%= render "admin/filters/toggle", form:, name: :missing_payout, label: "Missing payout", checked: @missing_payout %>
    <%= render "admin/filters/toggle", form:, name: :missing_fee_reimbursement, label: "Missing fee reimbursement", checked: @missing_fee_reimbursement %>
    <%= render "admin/filters/toggle", form:, name: :past_due, label: "Past due", checked: @past_due %>
    <%= render "admin/filters/toggle", form:, name: :voided, label: "Voided", checked: @voided %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Recipient</th>
      <th>Stripe Invoice Number</th>
      <th class="w-32">Amount</th>
      <th class="w-24">Status</th>
      <th class="w-32">FeeReimbursementId</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @invoices.each do |invoice| %>
      <tr class="<%= "admin-bg-pending" if invoice.open? %>">
        <td><%= invoice.id %></td>
        <td>
          <%= invoice.created_at.strftime("%Y-%m-%d") %>
          <% if invoice.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td>
          <%= link_to invoice_path(invoice), data: admin_popover_data_for(invoice) do %>
            <%= invoice.event.name.upcase %>: <%= invoice.sponsor.name %>
          <% end %>
        </td>
        <td><%= link_to invoice.number, invoice.stripe_dashboard_url %></td>
        <td><%= render_money_amount(invoice.amount_due) %></td>
        <td><%= invoice.status.upcase %></td>
        <td><%= invoice.fee_reimbursement_id %></td>
        <td>
          <%= link_to "Process", invoice_process_admin_path(invoice.id), class: "btn", data: admin_process_popover_data(invoice) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @invoices, entry_name: "invoices" %>
  </div>
  <%= paginate @invoices %>
</div>

</div>
