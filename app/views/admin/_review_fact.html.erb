<%# A label/value row on an admin process screen. `value` may be a string or
    already-safe markup (a link_to, a safe_join, …). Pass `copy` to offer the
    value on the clipboard. %>
<%# locals: (label:, value:, copy: nil, fs_exclude: false) %>
<div class="details__row <%= "fs-exclude" if fs_exclude %>">
  <strong><%= label %></strong>
  <span class="min-w-0 break-words"><%= value %></span>
  <% if copy.present? %>
    <div class="right muted pointer tooltipped tooltipped--n"
         aria-label="Copy <%= label.to_s.downcase %>"
         data-controller="clipboard"
         data-clipboard-text-value="<%= copy %>"
         data-action="click->clipboard#copy">
      <%= inline_icon "copy", size: 20 %>
    </div>
  <% end %>
</div>
