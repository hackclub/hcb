<%# Maps an incoming transaction onto the Wise transfer whose funds it returns. %>
<%# locals: (canonical_transaction:, wise_transfer:) %>
<% form_id = "wise-return-#{SecureRandom.hex(4)}" %>
<% report = wise_transfer&.reimbursement_payout_holding&.report %>
<% reimbursement_warning = if report
                             "This will also cancel the associated reimbursement report \"#{report.name}\" and return its payout holding to #{report.event.name}."
                           elsif wise_transfer.nil?
                             "If it paid out a reimbursement, the associated reimbursement report will also be cancelled and its payout holding returned to the organization."
                           end %>
<% confirm = ["Map this transaction as funds returned from #{wise_transfer ? "Wise transfer ##{wise_transfer.id}" : "the selected Wise transfer"} and mark it as failed?", reimbursement_warning].compact.join(" ") %>
<%# For the combobox path the warning is added client-side from the picked option (see wise_return_controller.js). %>
<% confirm = [confirm, wise_transfer&.duplicate_refund_warning].compact.join("\n\n") %>

<%= form_with model: false, local: true, url: set_wise_transfer_return_path(canonical_transaction), method: :post, class: "mb-0" do |form| %>
  <% if wise_transfer %>
    <%= form.hidden_field :wise_transfer_id, value: wise_transfer.id %>
    <%= form.text_field :reason, id: "#{form_id}-reason", value: wise_transfer.return_reason, placeholder: "Failure reason", required: true, style: "width: 300px;", class: "!max-w-full" %>
    <div class="mt-3">
      <%= form.submit "Map as return of Wise transfer ##{wise_transfer.id}", class: "!mb-0", data: { "turbo-confirm": confirm } %>
      <%= link_to "View Wise transfer ##{wise_transfer.id}", wise_transfer_process_admin_path(wise_transfer), class: "ml-2", target: "_blank" %>
      <%= link_to "View report", reimbursement_report_path(report), class: "ml-2", target: "_blank" if report %>
    </div>
  <% else %>
    <div data-controller="wise-return" data-action="combobox:change->wise-return#pick">
      <div class="flex flex-row items-center gap-2">
        <%= combobox_tag :wise_transfer_id,
                         wise_transfer_return_search_admin_index_path(canonical_transaction_id: canonical_transaction.id),
                         id: "#{form_id}-wise-transfer-id",
                         placeholder: "Search Wise transfers",
                         class: "!w-[300px] !max-w-full" %>
        <%= form.submit "Set", class: "!my-0", data: { "turbo-confirm": confirm, wise_return_target: "submit" } %>
      </div>
      <%= form.text_field :reason, id: "#{form_id}-reason", placeholder: "Failure reason", required: true, style: "width: 300px;", class: "!max-w-full mt-2", data: { wise_return_target: "input" } %>
    </div>
  <% end %>
<% end %>
