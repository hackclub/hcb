<% title "PayPal transfer ##{@paypal_transfer.id}" %>

<% transfer = @paypal_transfer %>
<% hcb_code = transfer.local_hcb_code %>
<% state, state_badge = if transfer.pending?
                          ["Pending review", "bg-pending"]
                        elsif transfer.rejected? || transfer.failed?
                          ["Failed", "bg-error"]
                        else
                          [transfer.aasm.current_state.to_s.humanize, "bg-muted"]
                        end %>

<%= turbo_frame_tag(admin_process_frame_id(transfer)) do %>
  <div class="fields flex flex-col gap-4 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-start">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 lg:col-span-full">
      <span class="text-[1.75rem] font-bold leading-[1.1] tabular-nums"><%= render_money transfer.amount %></span>
      <span class="badge <%= state_badge %> ml-0"><%= state %></span>
      <% if transfer.event.balance_available_v2_cents.negative? %>
        <span class="badge bg-error ml-0">⚠️ Negative org balance</span>
      <% end %>
      <span class="flex-grow"></span>
      <% transaction_popover = admin_popover_data_for(transfer) %>
      <%= link_to hcb_code_path(transfer.hcb_code), class: "btn btn-small bg-muted flex-shrink-0", target: ("_blank" if transaction_popover.empty?), data: transaction_popover do %>
        <%= inline_icon "payment-transfer" %>
        Transaction (<%= pluralize(hcb_code.comments.count, "comment") %>)
      <% end %>
    </div>

    <div class="flex flex-col gap-4 min-w-0">
      <section class="card flex flex-col gap-3.5 overflow-visible">
        <h3 class="eyebrow m-0">Transfer</h3>

        <div class="details m0">
          <% organization = safe_join([link_to(transfer.event.name, transfer.event, target: "_top"), tag.span("balance #{render_money transfer.event.balance_available_v2_cents}", class: "muted")], " · ") %>
          <%= render "admin/review_fact", label: "Organization", value: organization %>
          <%= render "admin/review_fact", label: "Payee", value: transfer.recipient_name, copy: transfer.recipient_name %>
          <%= render "admin/review_fact", label: "PayPal email", value: transfer.recipient_email, copy: transfer.recipient_email %>
          <%= render "admin/review_fact", label: "Payment for", value: transfer.payment_for %>
          <%= render "admin/review_fact", label: "Memo", value: transfer.memo %>
          <%= render "admin/review_fact", label: "Requested", value: format_datetime(transfer.created_at) %>

          <% if transfer.reimbursement_payout_holding.present? %>
            <% report = transfer.reimbursement_payout_holding.report %>
            <%= render "admin/review_fact", label: "Reimbursement", value: link_to(report.name, report, target: "_top") %>
          <% end %>

          <% if transfer.employee_payment.present? %>
            <%= render "admin/review_fact", label: "Employee", value: transfer.employee_payment.employee.user.name %>
            <%= render "admin/review_fact", label: "Employee org", value: transfer.employee_payment.employee.event.name %>
          <% end %>
        </div>
      </section>

      <%= render "admin/review_receipts", hcb_code: %>
    </div>

    <div class="flex flex-col gap-4 min-w-0">
      <% if transfer.may_mark_approved? %>
        <section class="card flex flex-col gap-3.5 overflow-visible">
          <h3 class="eyebrow m-0">Send</h3>

          <span class="block text-[0.8125rem] leading-snug opacity-60">
            HCB doesn't send PayPal transfers programmatically — send it yourself, then record it here.
          </span>

          <div class="flex flex-wrap items-center gap-2">
            <%= button_to "💸 Approve and send", approve_paypal_transfer_path(transfer), method: :post, class: "btn bg-success", form_class: "contents",
                  data: { turbo_frame: "_top", turbo_confirm: "Have you manually sent this transfer? HCB doesn't programmatically send PayPal transfers." } %>
          </div>
        </section>
      <% end %>

      <% if transfer.may_mark_rejected? %>
        <%= render "admin/review_reject", url: reject_paypal_transfer_path(transfer) %>
      <% end %>

      <% if transfer.may_mark_failed? %>
        <section class="card flex flex-col gap-3.5 overflow-visible">
          <h3 class="eyebrow m-0">Failed</h3>
          <span class="block text-[0.8125rem] leading-snug opacity-60">Use this if PayPal rejected or returned the payment.</span>

          <div>
            <%= button_to "Mark as failed", mark_failed_paypal_transfer_path(transfer), class: "btn btn--destroy", form_class: "contents", data: { turbo_frame: "_top" } %>
          </div>
        </section>
      <% end %>

      <% unless transfer.may_mark_approved? || transfer.may_mark_rejected? || transfer.may_mark_failed? %>
        <section class="card flex flex-col gap-3.5 overflow-visible">
          <p class="m0">
            This transfer is <strong><%= transfer.aasm.current_state.to_s.humanize(capitalize: false) %></strong> — there's nothing to process.
          </p>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
