<% title "Disbursements" %>

<% content_for(:admin_actions) do %>
  <%= link_to disbursement_new_admin_index_path, class: "btn bg-primary" do %>
    <%= inline_icon "plus" %>
    New disbursement
  <% end %>
<% end %>

<%= form_with local: true, class: "card admin-filters", url: disbursements_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= render "admin/date_range_filter", start_date: @start_date, end_date: @end_date %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :reviewing, label: "Reviewing", checked: @reviewing %>
    <%= render "admin/filters/toggle", form:, name: :pending, label: "Pending", checked: @pending %>
    <%= render "admin/filters/toggle", form:, name: :processing, label: "Processing", checked: @processing %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Recipient</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @disbursements.each do |disbursement| %>
      <tr class="<%= "admin-bg-transit" if disbursement.pending? %><%= "admin-bg-pending" if disbursement.reviewing? %>">
        <td><%= disbursement.id %></td>
        <td><%= disbursement.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to disbursement_path(disbursement), data: admin_popover_data_for(disbursement) do %>
            <%= disbursement.source_event.name.upcase %>: <%= disbursement.name %>
          <% end %>
        </td>
        <td><%= render_money_amount(disbursement.amount) %></td>
        <td>
          <%= disbursement.aasm.human_state %>
          <% if disbursement.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td>
          <% if disbursement.pending? %>
            AUTOMATED
          <% end %>

          <% if disbursement.reviewing? %>
            <%= link_to "Process", disbursement_process_admin_path(disbursement), class: "btn" %>
          <% else %>
            <%= pop_icon_to "external", disbursement_process_admin_path(disbursement), "aria-label": "View" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

  <div class="table-footer">
    <div class="flex-grow">
      <%= page_entries_info @disbursements, entry_name: "disbursements" %>
    </div>
    <%= paginate @disbursements %>
  </div>
</div>
