<% title "Account Numbers" %>

<%= form_with method: :get, class: "card admin-filters" do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= form.select :account_number_type, [["All", "0"], ["Deposit only", "1"], ["Spend + Deposit", "2"]], selected: @account_number_type %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Event</th>
      <th>Account Number</th>
      <th>Routing Number</th>
      <th>Deposit Only</th>
    </tr>
  </thead>
  <tbody>
    <% events_by_id = Event.with_deleted.where(id: @account_numbers.map(&:event_id)).index_by(&:id) %>
    <% @account_numbers.each do |an| %>
      <tr>
        <td><%= an.id %></td>
        <td>
          <% event = events_by_id[an.event_id] %>
          <%= link_to event_path(event) do %>
            <%= event.name.upcase %>
          <% end %>
          (#<%= event.id %>)
          <% if event.deleted? %>
            <em>(deleted)</em>
          <% end %>
        </td>
        <td><%= an.account_number %></td>
        <td><%= an.routing_number %></td>
        <td><%= an.deposit_only ? "✅" : "🚫" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @account_numbers, entry_name: "Account Number" %>
  </div>
  <%= paginate @account_numbers %>
</div>

</div>
