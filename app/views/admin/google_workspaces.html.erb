<% title "Google Workspaces" %>

<%= form_with local: true, class: "card admin-filters", url: google_workspaces_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :needs_ops_review, label: "Needs ops review", checked: @needs_ops_review %>
    <%= render "admin/filters/toggle", form:, name: :configuring, label: "Configuring", checked: @configuring %>
    <%= render "admin/filters/toggle", form:, name: :verification_error, label: "Verification error", checked: @verification_error %>
    <%= render "admin/filters/toggle", form:, name: :revocation_present, label: "Has revocation", checked: @revocation_present %>
    <%= render "admin/filters/toggle", form:, name: :pending_deletion, label: "Revoked, ready for deletion", checked: @pending_deletion %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<%= form_with(model: false, local: true, url: google_workspaces_verify_all_admin_index_path, method: :post) do |form| %>
  <%= form.submit "Attempt to verify all currently verifying domains", class: "btn btn-default mt-2" %>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-16">ID</th>
      <th class="w-32">Date</th>
      <th>Name</th>
      <th class="w-32">OU ID</th>
      <th>OU Path</th>
      <th>VerificationKey</th>
      <th class="w-32">Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @g_suites.each do |g_suite| %>
      <tr class="<%= "admin-bg-red;" if g_suite.deleted_at.present? %> <%= "admin-bg-pending" if g_suite.needs_ops_review? %>">
        <td><%= g_suite.id %></td>
        <td><%= g_suite.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= link_to "#{g_suite.event.name.upcase}: #{g_suite.domain}", event_g_suite_overview_path(event_id: g_suite.event.slug) %></td>
        <td><%= g_suite.remote_org_unit_id %></td>
        <td><%= g_suite.remote_org_unit_path %></td>
        <td><%= g_suite.verification_key %></td>
        <td><%= g_suite.revocation.present? ? g_suite.revocation.pending? ? "Pending Revocation".upcase : "Ready for Deletion".upcase : g_suite.aasm_state.upcase %></td>
        <td>
          <% if g_suite.needs_ops_review? %>
            <%= link_to("Process", google_workspace_process_admin_path(g_suite), class: "btn") %>
          <% elsif g_suite.revocation.present? && g_suite.revocation.revoked? %>
            <%= link_to("Process", google_workspace_process_admin_path(g_suite), class: "btn") %>
          <% elsif g_suite.dkim_key.nil? %>
            <%= link_to("DKIM", google_workspace_process_admin_path(g_suite), class: "btn") %>
          <% else %>
            <%= pop_icon_to "external", google_workspace_process_admin_path(g_suite), "aria-label": "View" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @g_suites, entry_name: "Google Workspaces" %>
  </div>
  <%= paginate @g_suites %>
</div>

</div>
