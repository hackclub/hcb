<% title "Sponsors" %>

<%= form_with local: true, class: "card admin-filters", url: sponsors_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :open, label: "Open", checked: @open %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Name</th>
      <th>StripeCustomerId</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @sponsors.each do |sponsor| %>
      <tr>
        <td><%= sponsor.id %></td>
        <td><%= sponsor.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= sponsor.event.name.upcase %>: <%= sponsor.name %></td>
        <td><%= link_to sponsor.stripe_customer_id, sponsor.stripe_dashboard_url %></td>
        <td>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @sponsors, entry_name: "sponsors" %>
  </div>
  <%= paginate @sponsors %>
</div>

</div>
