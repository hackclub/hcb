<% title "Wire ##{@wire.id}" %>

<% wire = @wire %>
<% hcb_code = wire.local_hcb_code %>
<% state, state_badge = if wire.pending?
                          ["Pending review", "bg-pending"]
                        elsif wire.rejected? || wire.failed?
                          ["Failed", "bg-error"]
                        else
                          [wire.aasm.current_state.to_s.humanize, "bg-muted"]
                        end %>

<%= turbo_frame_tag(admin_process_frame_id(wire)) do %>
  <div class="admin-review">
    <div class="admin-review__hero">
      <span class="admin-review__amount"><%= Money.from_cents(wire.amount_cents, wire.currency).format %></span>
      <span class="badge <%= state_badge %> ml-0"><%= state %></span>
      <% if wire.event.balance_available_v2_cents.negative? %>
        <span class="badge bg-error ml-0">⚠️ Negative org balance</span>
      <% end %>
      <% if wire.event.financially_frozen? %>
        <span class="badge bg-error ml-0">❄️ Financially frozen</span>
      <% end %>
      <span class="flex-grow"></span>
      <% if wire.column_id.present? %>
        <%= link_to("https://dashboard.column.com/app/transfers/edit/intl-wire/#{wire.column_id}", class: "btn btn-small bg-none !bg-[#4575CD] hover:saturate-[125%] transition-all !text-white flex-shrink-0", target: "_blank") do %>
          <%= inline_icon "column" %>
          Column
        <% end %>
      <% end %>
      <% transaction_popover = admin_popover_data_for(wire) %>
      <%= link_to hcb_code_path(wire.hcb_code), class: "btn btn-small bg-muted flex-shrink-0", target: ("_blank" if transaction_popover.empty?), data: transaction_popover do %>
        <%= inline_icon "payment-transfer" %>
        Transaction (<%= pluralize(hcb_code.comments.count, "comment") %>)
      <% end %>
    </div>

    <div class="admin-review__column">
      <section class="card admin-form__section">
        <h3 class="admin-form__title">Transfer</h3>

        <dl class="admin-review__facts m0">
          <% organization = safe_join([link_to(wire.event.name, wire.event, target: "_top"), tag.span("balance #{render_money wire.event.balance_available_v2_cents}", class: "muted")], " · ") %>
          <%= render "admin/review_fact", label: "Organization", value: organization %>
          <%= render "admin/review_fact", label: "Payee", value: wire.recipient_name, copy: wire.recipient_name %>
          <%= render "admin/review_fact", label: "Email", value: wire.recipient_email, copy: wire.recipient_email %>
          <%= render "admin/review_fact", label: "Payment for", value: wire.payment_for %>
          <%= render "admin/review_fact", label: "Memo", value: wire.memo %>
          <%= render "admin/review_fact", label: "Requested", value: format_datetime(wire.created_at) %>
        </dl>
      </section>

      <section class="card admin-form__section">
        <h3 class="admin-form__title">Bank details</h3>

        <dl class="admin-review__facts m0">
          <%= render "admin/review_fact", label: "BIC / SWIFT", value: wire.bic_code, copy: wire.bic_code, fs_exclude: true %>
          <%= render "admin/review_fact", label: "Account number", value: wire.account_number, copy: wire.account_number, fs_exclude: true %>
          <%= render "admin/review_fact", label: "Currency", value: wire.currency %>

          <% address = [wire.address_line1, wire.address_line2, wire.address_city, wire.address_state, wire.address_postal_code, wire.recipient_country].compact_blank %>
          <%= render "admin/review_fact", label: "Address", value: address.join(", "), copy: address.join(", ") %>

          <% wire.recipient_information&.each do |key, value| %>
            <% if value.present? %>
              <%= render "admin/review_fact", label: key.humanize, value: value, copy: value %>
            <% end %>
          <% end %>
        </dl>

        <div>
          <%= button_to "Edit wire", edit_wire_path(wire), method: :get, class: "btn btn-default", form_class: "contents", data: { turbo_frame: "_top" } %>
        </div>
      </section>

      <%= render "admin/review_receipts", hcb_code: %>
    </div>

    <div class="admin-review__column">
      <% if wire.pending? %>
        <section class="card admin-form__section">
          <h3 class="admin-form__title">Send</h3>

          <div class="field">
            <label class="bold">Transaction category</label>
            <%= render partial: "hcb_codes/transaction_category_form", locals: { model: hcb_code.ct || hcb_code.pt } %>
          </div>

          <%= form_with(model: false, local: true, url: send_wire_path(wire), method: :post, class: "admin-form__section", data: { turbo_frame: "_top" }) do |form| %>
            <label class="admin-form__option">
              <%= form.check_box :charge_fee %>
              <span>
                <strong>Charge a $25 transfer fee</strong>
                <span class="admin-form__hint">Billed to <%= wire.event.name %>.</span>
              </span>
            </label>

            <div>
              <%= button_tag "💸 Approve and send automatically", name: nil, class: "btn bg-success",
                    data: { turbo_confirm: "This will automatically send the wire. You don't need to send it manually!" } %>
            </div>
          <% end %>

          <span class="admin-form__hint">Already sent it yourself? Record it instead:</span>

          <div>
            <%= button_to "🔧 Approve as manually sent", approve_wire_path(wire), method: :post, class: "btn bg-warning", form_class: "contents",
                  data: { turbo_frame: "_top", turbo_confirm: "Have you manually sent this wire? This option requires you send this wire." } %>
          </div>
        </section>

        <%= render "admin/review_reject", url: reject_wire_path(wire), noun: "wire" %>
      <% else %>
        <section class="card admin-form__section">
          <p class="m0">
            This wire <%= wire.failed? ? "" : "is " %><strong><%= wire.aasm.current_state.to_s.humanize(capitalize: false) %></strong><% if wire.failed? %><%= wire.return_reason.presence ? ": #{wire.return_reason}" : " for an unknown reason" %><% end %>.
          </p>

          <% unless wire.failed? %>
            <div>
              <%= button_to "Reject as failed", reject_wire_path(wire), class: "btn btn--destroy", form_class: "contents", data: { turbo_frame: "_top" } %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
