<% title "Wise transfer ##{@wise_transfer.id}" %>

<% transfer = @wise_transfer %>
<% hcb_code = transfer.local_hcb_code %>
<% approver = transfer.last_user_change_to(aasm_state: :approved) %>

<%= turbo_frame_tag(admin_process_frame_id(transfer)) do %>
  <div class="admin-review">
    <div class="admin-review__hero">
      <span class="admin-review__amount"><%= Money.from_cents(transfer.amount_cents, transfer.currency).format %></span>
      <% if transfer.event.balance_available_v2_cents.negative? %>
        <span class="badge bg-error ml-0">⚠️ Negative org balance</span>
      <% end %>
      <% if transfer.event.financially_frozen? %>
        <span class="badge bg-error ml-0">❄️ Financially frozen</span>
      <% end %>
      <span class="flex-grow"></span>
      <%= link_to(transfer.wise_url || "https://wise.com/send", class: "btn btn-small bg-none !bg-[#9fe870] hover:brightness-90 transition-all text-[#163300] flex-shrink-0", target: "_blank") do %>
        <%= inline_icon "wise" %>
        <%= transfer.wise_id.present? ? "Wise ##{transfer.wise_id}" : "Open Wise" %>
      <% end %>
      <% transaction_popover = admin_popover_data_for(transfer) %>
      <%= link_to hcb_code_path(transfer.hcb_code), class: "btn btn-small bg-muted flex-shrink-0", target: ("_blank" if transaction_popover.empty?), data: transaction_popover do %>
        <%= inline_icon "payment-transfer" %>
        Transaction (<%= pluralize(hcb_code.comments.count, "comment") %>)
      <% end %>
    </div>

    <div class="admin-review__full">
      <div class="admin-review__states">
        <% WiseTransfer.aasm.states.map(&:default_display_name).each do |state| %>
          <span class="badge h4 <%= state.downcase == transfer.aasm_state ? "bg-#{transfer.status_color}" : "bg-transparent text-slate border-solid border-[0.5px] border-smoke" %>"><%= state.humanize %></span>
        <% end %>
      </div>
    </div>

    <div class="admin-review__column">
      <section class="card admin-form__section">
        <h3 class="admin-form__title">Transfer</h3>

        <dl class="admin-review__facts m0">
          <% organization = safe_join([link_to(transfer.event.name, transfer.event, target: "_top"), tag.span("balance #{render_money transfer.event.balance_available_v2_cents}", class: "muted")], " · ") %>
          <%= render "admin/review_fact", label: "Organization", value: organization %>
          <%= render "admin/review_fact", label: "Payment for", value: transfer.payment_for %>
          <%= render "admin/review_fact", label: "Requested", value: format_datetime(transfer.created_at) %>
          <%= render "admin/review_fact", label: "Amount (#{transfer.currency})", value: Money.from_cents(transfer.amount_cents, transfer.currency).format %>

          <% if transfer.quoted_usd_amount_cents.present? %>
            <%= render "admin/review_fact", label: "Quoted (USD)", value: render_money(transfer.quoted_usd_amount_cents) %>
          <% end %>
          <% if transfer.usd_amount_cents.present? %>
            <%= render "admin/review_fact", label: "Final (USD)", value: render_money(transfer.usd_amount_cents) %>
          <% end %>
          <% if approver.present? %>
            <%= render "admin/review_fact", label: "Approved by", value: user_mention(approver) %>
          <% end %>
          <% if transfer.wise_id.present? %>
            <%= render "admin/review_fact", label: "Wise ID", value: link_to(transfer.wise_id, transfer.wise_url, target: "_blank"), copy: transfer.wise_id %>
          <% end %>
        </dl>
      </section>

      <section class="card admin-form__section">
        <h3 class="admin-form__title">Recipient</h3>

        <dl class="admin-review__facts m0">
          <% payee = transfer.recipient_name %>
          <% payee = safe_join([payee, link_to("view on Wise", transfer.wise_recipient_url, target: "_blank")], " · ") if transfer.wise_recipient_url %>
          <%= render "admin/review_fact", label: "Payee", value: payee, copy: transfer.recipient_name %>
          <%= render "admin/review_fact", label: "Email", value: transfer.recipient_email, copy: transfer.recipient_email %>

          <% address = [transfer.address_line1, transfer.address_line2, transfer.address_city, transfer.address_state, transfer.address_postal_code, transfer.recipient_country].compact_blank %>
          <%= render "admin/review_fact", label: "Address", value: address.join(", "), copy: address.join(", ") %>

          <% WiseTransfer.recipient_information_accessors&.each do |key| %>
            <% value = transfer.recipient_information[key].presence || transfer.read_attribute(key.to_sym).presence %>
            <% if value.present? %>
              <%= render "admin/review_fact", label: key.humanize, value: value, copy: value, fs_exclude: true %>
            <% end %>
          <% end %>
        </dl>
      </section>

      <%= render "admin/review_receipts", hcb_code: %>
    </div>

    <div class="admin-review__column">
      <% if transfer.pending? %>
        <section class="card admin-form__section">
          <h3 class="admin-form__title">Approve</h3>

          <span class="admin-form__hint">
            You're only checking the transfer's purpose and documentation here — the balance check
            happens after approval.
          </span>

          <div class="admin-review__actions">
            <%= button_to "💸 Approve and self-assign", approve_wise_transfer_path(transfer), method: :post, class: "btn bg-success", form_class: "contents", data: { turbo_frame: "_top" } %>
          </div>
        </section>

        <%= render "admin/review_reject", url: reject_wise_transfer_path(transfer) %>
      <% elsif transfer.approved? %>
        <section class="card admin-form__section">
          <h3 class="admin-form__title">Metadata</h3>

          <div class="field">
            <label class="bold">Transaction category</label>
            <%= render partial: "hcb_codes/transaction_category_form", locals: { model: hcb_code.ct || hcb_code.pt } %>
          </div>

          <%= form_with(model: transfer, local: true, url: wise_transfer_path(transfer), method: :patch, class: "admin-form__section", data: { turbo_frame: "_top" }) do |form| %>
            <div class="field">
              <%= form.label :wise_recipient_id, "Wise recipient ID" %>
              <%= form.text_field :wise_recipient_id, placeholder: "https://wise.com/recipients/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" %>
            </div>

            <div><%= button_tag "Save", name: nil, class: "btn btn-default" %></div>
          <% end %>
        </section>

        <section class="card admin-form__section" x-data="{ amount: null, pending_amount: <%= transfer.quoted_usd_amount_cents %>, balance: <%= transfer.event.balance_available_v2_cents %> }">
          <h3 class="admin-form__title">Send</h3>

          <%= form_with(model: transfer, local: true, url: wise_transfer_path(transfer), method: :patch, class: "admin-form__section", data: { turbo_frame: "_top" }) do |form| %>
            <div class="field">
              <%= form.label :usd_amount, "Amount (USD)" %>
              <div class="input input-group">
                <span class="admin-form__prefix">$</span>
                <%= form.number_field :usd_amount, placeholder: "500.00", step: 0.01, required: true, class: "bg-transparent", "@change": "amount = +$event.target.value * 100", "@keyup": "amount = +$event.target.value * 100", data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad" } %>
              </div>
            </div>

            <p x-show="amount && balance >= (amount - pending_amount)" class="m0 bold flex items-center gap-2">
              <%= inline_icon "checkmark", class: "text-green" %>
              Sufficient funds available
            </p>
            <p x-show="amount && balance < (amount - pending_amount)" class="m0 bold flex items-center gap-2">
              <%= inline_icon "important", class: "text-red" %>
              Insufficient funds, please reject this transfer
            </p>

            <div>
              <%= button_tag "🏦 Update amount", name: nil, class: "btn btn-default" %>
              <span class="admin-form__hint">Updates the pending amount.</span>
            </div>
          <% end %>

          <%= form_with(model: transfer, local: true, url: mark_sent_wise_transfer_path(transfer), method: :post, class: "admin-form__section", data: { turbo_frame: "_top" }) do |form| %>
            <div class="field">
              <%= form.label :wise_id, "Wise ID / URL" %>
              <%= form.text_field :wise_id, placeholder: "https://wise.com/transactions/activities/by-resource/TRANSFER/XXXXXXXX", disabled: transfer.usd_amount_cents.nil?, onpaste: "var urlPrefix = 'https://wise.com/transactions/activities/by-resource/TRANSFER/'; var clipboardData = event.clipboardData.getData('Text'); clipboardData.startsWith(urlPrefix) ? (event.preventDefault(), event.target.value = clipboardData.substring(urlPrefix.length)) : null" %>
            </div>

            <div><%= button_tag "💸 Mark as sent", name: nil, disabled: transfer.usd_amount_cents.nil?, class: "btn bg-success" %></div>
          <% end %>
        </section>

        <%= render "admin/review_reject", url: reject_wise_transfer_path(transfer) %>
      <% else %>
        <section class="card admin-form__section">
          <p class="m0">
            This transfer <%= transfer.failed? ? "" : "is " %><strong><%= transfer.aasm.current_state.to_s.humanize(capitalize: false) %></strong><% if transfer.failed? %><%= transfer.return_reason.presence ? ": #{transfer.return_reason}" : " for an unknown reason" %><% end %>.
          </p>
        </section>
      <% end %>

      <% if transfer.may_mark_failed? %>
        <section class="card admin-form__section">
          <h3 class="admin-form__title">Fail</h3>

          <%= form_with(model: false, local: true, url: mark_failed_wise_transfer_path(transfer), method: :post, class: "admin-form__section", data: { turbo_frame: "_top" }) do |form| %>
            <div class="field">
              <%= form.label :reason, "Failure reason" %>
              <span class="admin-form__hint">Markdown supported.</span>
              <%= form.text_area :reason, rows: 3 %>
            </div>

            <div>
              <%= button_tag "Mark as failed", name: nil, class: "btn btn--destroy", data: { turbo_confirm: "Mark as failed?", turbo_confirm_danger: true } %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="admin-review__full">
      <section class="card admin-form__section">
        <h3 class="admin-form__title">How to send a Wise transfer</h3>

        <ol class="admin-review__steps">
          <li>Approve and self-assign, so nobody else processes it at the same time.</li>
          <li>Enter the transfer in Wise, then update the USD amount here to run the balance check.</li>
          <li>Complete the transfer in Wise and paste the Wise transfer ID back in.</li>
        </ol>
      </section>
    </div>
  </div>
<% end %>
