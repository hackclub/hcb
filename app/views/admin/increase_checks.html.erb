<% title "Checks" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: increase_checks_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :exclude_reimbursements, label: "Exclude reimbursements", checked: @exclude_reimbursements %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Event</th>
      <th>Recipient</th>
      <th class="w-32">Amount</th>
      <th>Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @checks.each do |check| %>
      <tr class="<%= "shade-yellow" if check.pending? %>">
        <td><%= check.id %></td>
        <td><%= check.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= check.event.name %></td>
        <td><%= check.recipient_name %></td>
        <td><%= render_money(check.amount) %></td>
        <td><%= check.aasm.human_state %><%= " - #{check.increase_status&.humanize}" if check.approved? %></td>
        <td>
          <div class="flex items-center gap-2">
            <%= link_to "Process", increase_check_process_admin_path(check), class: "btn", data: admin_process_popover_data(check) %>
            <%= pop_icon_to "external", hcb_code_path(check.hcb_code), "aria-label": "View", data: admin_popover_data_for(check) %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @checks, entry_name: "check" %>
  </div>
  <%= paginate @checks %>
</div>

</div>
