<% title "Tax1099 Import" %>

<h1>Tax1099 → TaxBandits import</h1>

<%# admin.css, unlike application.css, has no global [hidden] rule, so a utility
    class like `block` or `flex` would otherwise override the hidden attribute
    this page toggles. %>
<style>
  [data-controller="tax1099-import"] [hidden] {
    display: none !important;
  }
</style>

<div
  data-controller="tax1099-import"
  data-tax1099-import-create-url-value="<%= admin_tax1099_imports_path %>"
  data-tax1099-import-legal-entities-url-value="<%= legal_entities_admin_tax1099_imports_path %>"
  data-tax1099-import-fields-value="<%= @fields.map { _1[:key] }.to_json %>"
  data-tax1099-import-imported-row-keys-value="<%= @imported_row_keys.to_json %>"
  data-tax1099-import-us-states-value="<%= @us_states.to_json %>"
  data-tax1099-import-country-codes-by-name-value="<%= @country_codes_by_name.to_json %>">
  <div class="card mb-4">
    <h2 class="mt-0">Load the Tax1099 export</h2>
    <%# Same picker as comment attachments (file_upload_controller.js). %>
    <div data-controller="file-upload" data-file-upload-placeholder-value="Choose Tax1099 CSV">
      <input
        type="file"
        accept=".csv,text/csv"
        data-file-upload-target="input"
        data-tax1099-import-target="csvInput"
        data-action="change->tax1099-import#loadCsv">
      <button data-file-upload-target="preview" type="button"></button>
      <div data-file-upload-target="clear"></div>
    </div>

    <p class="mt-2" style="color: var(--hcb-primary)" data-tax1099-import-target="csvError" hidden></p>
  </div>

  <div class="mb-3 flex items-center gap-2" data-tax1099-import-target="summary" hidden>
    <span class="badge bg-muted" data-tax1099-import-target="summaryTotal"></span>
    <span class="badge bg-success" data-tax1099-import-target="summaryImported"></span>
    <span class="badge bg-muted" data-tax1099-import-target="summarySkipped"></span>
    <span class="badge bg-muted" data-tax1099-import-target="summaryHidden" hidden></span>
  </div>

  <div data-tax1099-import-target="rows"></div>

  <%# Cloned once per CSV row. Inert while it lives in the template, so none of
      these inputs are submitted or picked up as Stimulus targets. %>
  <template data-tax1099-import-target="rowTemplate">
    <div class="card mb-3" data-row>
      <%# A div, not a <header>: admin.scss styles every bare header as the
          full-bleed page banner. %>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="badge bg-muted" data-row-number></span>
        <strong data-row-title></strong>
        <span class="badge bg-muted" data-status>Not imported</span>
        <button type="button" class="ml-auto" data-action="click->tax1099-import#toggleRow" data-toggle>
          Review
        </button>
      </div>

      <div data-body hidden class="mt-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @fields.each do |field| %>
            <%= tag.label class: "block", data: { only_for: field[:only_for]&.join(" ") } do %>
              <%# A field only shown for the forms that require it is just marked
                  required; one shown for every form names the forms that need it. %>
              <% required_mark = if field[:required] == true || field[:required] == field[:only_for]
                                   " *"
                                 elsif field[:required]
                                   " * (#{field[:required].join(", ")})"
                                 end %>
              <span class="flex items-center gap-1 mb-1">
                <%= field[:label] %><%= required_mark %>
                <% if field[:hint] %>
                  <span class="info tooltipped tooltipped--e tooltipped--lg h-[18px]" aria-label="<%= field[:hint] %>">
                    <%= inline_icon "info", size: 18 %>
                  </span>
                <% end %>
              </span>

              <% case field[:key] %>
              <% when :form_type %>
                <select class="w-full max-w-sm" data-field="form_type" data-action="change->tax1099-import#formTypeChanged">
                  <option value="">— pick one —</option>
                  <% @form_types.each do |form_type| %>
                    <option value="<%= form_type %>"><%= form_type %></option>
                  <% end %>
                </select>
              <% when :ch3_status %>
                <select class="w-full max-w-sm" data-field="ch3_status">
                  <option value="">— pick one —</option>
                  <% @ch3_statuses.each do |status| %>
                    <option value="<%= status %>"><%= status.humanize %></option>
                  <% end %>
                </select>
              <% when :ftin_not_legally_required %>
                <input type="checkbox" data-field="ftin_not_legally_required" value="1">
              <% when :country %>
                <%# A code or a name; a name is turned into its code when the row is
                    loaded, and by the server. %>
                <input type="text" class="w-full max-w-sm" data-field="country" autocomplete="off">
              <% when :tin_type %>
                <select class="w-full max-w-sm" data-field="tin_type" data-action="change->tax1099-import#entityShapeChanged">
                  <% @tin_types.each do |tin_type| %>
                    <option value="<%= tin_type %>"><%= tin_type %></option>
                  <% end %>
                </select>
              <% when :federal_tax_classification %>
                <select class="w-full max-w-sm" data-field="federal_tax_classification" data-action="change->tax1099-import#entityShapeChanged">
                  <option value="">— pick one —</option>
                  <% @federal_tax_classifications.each do |classification| %>
                    <option value="<%= classification %>"><%= classification %></option>
                  <% end %>
                </select>
              <% when :email %>
                <input type="email" class="w-full" data-field="email" autocomplete="off"
                       data-action="change->tax1099-import#entityShapeChanged">
              <% when :tin %>
                <%# Never prefilled by the browser and never remembered by it. %>
                <input type="text" class="w-full" data-field="tin" autocomplete="off" spellcheck="false">
              <% when :completed_on %>
                <input type="date" class="w-full" data-field="completed_on" max="<%= Time.zone.today.iso8601 %>">
              <% else %>
                <input type="text" class="w-full" data-field="<%= field[:key] %>" autocomplete="off">
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div class="mt-3" data-legal-entity-picker hidden>
          <label class="block">
            <span class="block mb-1">
              This payee already has legal entities of this form's type. Which one does it belong to? *
            </span>
            <select class="w-full max-w-sm" data-legal-entity-select></select>
          </label>
        </div>

        <div class="mt-3">
          <span class="block mb-1">Signed form PDF *</span>
          <%# Same picker as comment attachments (file_upload_controller.js). %>
          <div data-controller="file-upload" data-file-upload-placeholder-value="Attach signed form">
            <input type="file" accept="application/pdf,.pdf" data-pdf
                   data-file-upload-target="input"
                   data-action="change->tax1099-import#pdfChanged">
            <button data-file-upload-target="preview" type="button"></button>
            <div data-file-upload-target="clear"></div>
          </div>
        </div>

        <p class="mt-2" data-message hidden></p>

        <div class="flex items-center gap-2 mt-3">
          <button type="button" data-action="click->tax1099-import#import" data-import>
            Import to TaxBandits
          </button>
          <button type="button" class="bg-muted" data-action="click->tax1099-import#skip" data-skip>
            Skip this row
          </button>
        </div>
      </div>
    </div>
  </template>
</div>
