<% title "Create an organization from Airtable" %>

<% content_for(:admin_actions) do %>
  <%= link_to "Create manually", event_new_admin_index_path, class: "btn" %>
<% end %>

<%= form_with(model: false, local: true, url: event_create_from_airtable_admin_index_path, class: "fields flex flex-col gap-4 max-w-[46rem]") do |form| %>
  <section class="card flex flex-col gap-3.5 overflow-visible">
    <div class="field">
      <%= form.label :airtable_record_id, "Airtable record ID" %>
      <span class="block text-[0.8125rem] leading-snug opacity-60">
        From the applications table. The name, country and tags come from the record, and the
        Airtable row is updated with the new HCB account URL.
      </span>
      <%= form.text_field :airtable_record_id, placeholder: "recXXXXXXXXXXXXXX", value: params[:airtable_record_id], required: true, autofocus: true %>
    </div>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_tag "Create organization", name: nil, class: "btn bg-success" %>
    <%= link_to "Cancel", events_admin_index_path, class: "font-medium text-muted no-underline hover:text-blue focus:text-blue" %>
  </div>
<% end %>
