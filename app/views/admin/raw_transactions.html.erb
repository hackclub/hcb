<% title "Raw Transactions" %>

<% content_for(:admin_actions) do %>
  <%= link_to "New Raw Transaction", raw_transaction_new_admin_index_path, class: "btn bg-primary" %>
<% end %>

<%= form_with local: true, class: "card admin-filters", url: raw_transactions_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= form.collection_select(:unique_bank_identifier, @bank_identifiers, :to_s, :to_s, { include_blank: "All bank accounts", selected: @unique_bank_identifier }) %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Bank Identifier</th>
      <th>Date</th>
      <th>Memo</th>
      <th>Amount</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @raw_transactions.each do |rt| %>
      <tr class="<%= "admin-bg-pending" unless rt.hashed_transactions.present? %>">
        <td><%= rt.id %></td>
        <td><%= rt.unique_bank_identifier %></td>
        <td><%= rt.date_posted %></td>
        <td><%= rt.memo %></td>
        <td><%= rt.amount %></td>
        <td>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @raw_transactions, entry_name: "transactions" %>
  </div>
  <%= paginate @raw_transactions %>
</div>
</div>
