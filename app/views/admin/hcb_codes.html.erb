<% title "HCB Codes" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: hcb_codes_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= form.select :has_receipt, [["Any receipt status", "all"], ["Has receipt", "yes"], ["Missing receipt", "no"], ["Lost receipt", "lost"]], selected: @has_receipt %>
    <%= render "admin/date_range_filter", start_date: @start_date, end_date: @end_date %>
    <%= render "admin/filters/actions", form:, export_count: @hcb_codes.total_count, export_params: @params %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>HCB Code</th>
      <th>Event</th>
      <th>User</th>
      <th>Amount</th>
      <th>Pending TXs</th>
      <th>Canonical TXs</th>
      <th>Comments</th>
      <th>Receipts</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @hcb_codes.each do |hcb_code| %>
      <tr>
        <td>
          <%= hcb_code.created_at.strftime("%Y-%m-%d") %>
          <% if hcb_code.has_pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td><%= link_to hcb_code.memo, url_for(hcb_code), data: admin_popover_data_for(hcb_code) %></td>
        <td><%= link_to hcb_code.event&.name, hcb_code.event %></td>
        <td>
          <% if hcb_code.stripe_card? && hcb_code.card&.user %>
           <%= link_to hcb_code.card.user.name, hcb_code.card.user %>
          <% end %>
        </td>
        <td><%= render_money hcb_code.amount %></td>
        <td>
          <% hcb_code.canonical_pending_transactions.each do |cpt| %>
            <% if cpt.event %>
              <%= link_to cpt.id, canonical_pending_transaction_path(cpt) %>
            <% else %>
              <%= cpt.id %>
            <% end %>
          <% end %>
        </td>
        <td>
          <% hcb_code.canonical_transactions.each do |ct| %>
            <% if ct.event.present? %>
              <%= link_to ct.id, canonical_transaction_path(ct) %>
            <% else %>
              <%= ct.id %>
            <% end %>
          <% end %>
        </td>
        <td>
          <% hcb_code.comments.each do |c| %>
            <%= c.id %>
          <% end %>
        </td>
        <td>
          <% hcb_code.receipts.each do |r| %>
            <%= r.id %>
          <% end %>
        </td>
        <td>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @hcb_codes, entry_name: "HCB codes" %>
  </div>
  <%= paginate @hcb_codes %>
</div>
</div>
