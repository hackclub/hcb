<% title "Recurring Donations" %>

<%= form_with local: true, class: "card admin-filters", url: recurring_donations_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :active, label: "Active", checked: @active %>
    <%= render "admin/filters/toggle", form:, name: :canceled, label: "Canceled", checked: @canceled %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Donor</th>
      <th>Anonymous</th>
      <th>Tax-Deductible</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Cancel</th>
    </tr>
  </thead>
  <tbody>
    <% @donations.each do |donation| %>
      <tr class="<%= "admin-bg-transit" if donation.active? %>">
        <td><%= donation.id %></td>
        <td><%= donation.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to recurring_donation_path(donation.url_hash) do %>
            <%= donation.event.name.upcase %>: <%= donation.name(show_anonymous: true) %>
          <% end %>
        </td>
        <td><%= donation.anonymous? %></td>
        <td><%= donation.tax_deductible? %></td>
        <td><strong><%= render_money(donation.amount) %></strong>/month</td>
        <td><%= donation.stripe_status.humanize %></td>
        <td><%= link_to "Cancel donation", cancel_recurring_donation_path(donation.url_hash), data: { turbo_method: :post, turbo_confirm: "Are you sure you'd like to cancel this donation to #{donation.event.name}?", turbo_confirm_danger: true } if !donation.canceled? %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @donations, entry_name: "donations" %>
  </div>
  <%= paginate @donations %>
</div>

</div>
