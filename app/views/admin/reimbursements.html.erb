<% title "Reimbursements" %>

<%= form_with local: true, class: "card admin-filters", url: reimbursements_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :pending, label: "Awaiting review", checked: @pending %>
    <%= render "admin/filters/toggle", form:, name: :failed, label: "Payout holding failed", checked: @failed %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Organization</th>
      <th>Title</th>
      <th>User</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @reports.each do |report| %>
      <tr class="<%= "admin-bg-pending" if report.reimbursement_requested? %> <%= "admin-bg-orange" if report.id.in?(@unprocessed_wise_report_ids) %> <%= "admin-bg-warning" if report.payout_holding&.failed? %>">
        <td class="w-16"><%= report.id %></td>
        <td class="w-32"><%= report.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <% if report.event %>
            <%= link_to event_path(report.event) do %>
              <%= report.event.name.upcase %>
            <% end %>
          <% else %>
            None
          <% end %>
        </td>
        <td class="max-w-lg">
          <%= link_to reimbursement_report_path(report) do %>
            <%= report.name %>
          <% end %>
        </td>
        <td>
          <%= report.user.name %> (<%= report.user.id %>)
        </td>
        <td class="w-24"><%= report.amount.format %></td>
        <td>
          <%= report.admin_status_text %>
          <% if report.reimbursement_requested? %>
            <br>
            <small>
              since <%= format_date report.reimbursement_requested_at %>
            </small>
          <% end %>
        </td>
        <td>
          <%= pop_icon_to "external", reimbursement_report_path(report), "aria-label": "View" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @reports, entry_name: "reports" %>
  </div>
  <%= paginate @reports %>
</div>

</div>
