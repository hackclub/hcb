<% title "ACH transfer ##{@ach_transfer.id}" %>

<% transfer = @ach_transfer %>
<% hcb_code = transfer.local_hcb_code %>
<% state, state_badge = if transfer.pending?
                          ["Pending review", "bg-pending"]
                        elsif transfer.rejected?
                          ["Rejected", "bg-error"]
                        else
                          [transfer.aasm_state.to_s.humanize, "bg-muted"]
                        end %>

<%= turbo_frame_tag(admin_process_frame_id(transfer)) do %>
  <div class="fields flex flex-col gap-4 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-start">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 lg:col-span-full">
      <span class="text-[1.75rem] font-bold leading-[1.1] tabular-nums"><%= render_money transfer.amount %></span>
      <span class="badge <%= state_badge %> ml-0"><%= state %></span>
      <% if transfer.event.balance_available_v2_cents.negative? %>
        <span class="badge bg-error ml-0">⚠️ Negative org balance</span>
      <% end %>
      <span class="flex-grow"></span>
      <% if transfer.column_id.present? %>
        <%= link_to("https://dashboard.column.com/app/transfers/edit/ach/#{transfer.column_id}", class: "btn btn-small bg-none !bg-[#4575CD] hover:saturate-[125%] transition-all !text-white flex-shrink-0", target: "_blank") do %>
          <%= inline_icon "column" %>
          Column
        <% end %>
      <% end %>
      <% transaction_popover = admin_popover_data_for(transfer) %>
      <%= link_to hcb_code_path(transfer.hcb_code), class: "btn btn-small bg-muted flex-shrink-0", target: ("_blank" if transaction_popover.empty?), data: transaction_popover do %>
        <%= inline_icon "payment-transfer" %>
        Transaction (<%= pluralize(hcb_code.comments.count, "comment") %>)
      <% end %>
    </div>

    <div class="flex flex-col gap-4 min-w-0">
      <section class="card flex flex-col gap-3.5 overflow-visible">
        <h3 class="eyebrow m-0">Transfer</h3>

        <div class="details m0">
          <% organization = safe_join([link_to(transfer.event.name, transfer.event, target: "_top"), tag.span("balance #{render_money transfer.event.balance_available_v2_cents}", class: "muted")], " · ") %>
          <%= render "admin/review_fact", label: "Organization", value: organization %>

          <% if transfer.creator %>
            <%= render "admin/review_fact", label: "Submitted by", value: user_mention(transfer.creator) %>
          <% end %>

          <%= render "admin/review_fact", label: "Payee", value: transfer.recipient_name, copy: transfer.recipient_name %>

          <% if transfer.recipient_tel.present? %>
            <%= render "admin/review_fact", label: "Payee phone", value: transfer.recipient_tel, copy: transfer.recipient_tel %>
          <% end %>

          <%= render "admin/review_fact", label: "Payment for", value: transfer.payment_for %>

          <% if transfer.invoiced_at.present? %>
            <%= render "admin/review_fact", label: "Invoice date", value: transfer.invoiced_at.strftime("%B %-d, %Y") %>
          <% end %>

          <%= render "admin/review_fact", label: "Bank", value: transfer.bank_name %>
          <%= render "admin/review_fact", label: "Account number", value: transfer.account_number, copy: transfer.account_number, fs_exclude: true %>
          <%= render "admin/review_fact", label: "Routing number", value: transfer.routing_number, copy: transfer.routing_number, fs_exclude: true %>

          <%# safe_join, not interpolation: format_datetime returns a <time> tag. %>
          <% speed = [transfer.same_day? ? "💨 Same-day" : "⌛ Standard"] %>
          <% if transfer.pending? %>
            <%# button_to, not a data-turbo-method link: this only POSTs if Turbo
                intercepts the click, and a plain GET has no matching route. %>
            <% speed << button_to("toggle", toggle_speed_ach_transfer_path(transfer), method: :post, form_class: "inline", class: "link-button") %>
            <% speed << tag.span(safe_join(["arrives ", format_datetime(transfer.estimated_arrival)]), class: "muted") %>
          <% end %>
          <%= render "admin/review_fact", label: "Speed", value: safe_join(speed, " · ") %>

          <% if transfer.employee_payment.present? %>
            <%= render "admin/review_fact", label: "Employee", value: transfer.employee_payment.employee.user.full_name %>
            <%= render "admin/review_fact", label: "Employee org", value: transfer.employee_payment.employee.event.name %>
          <% end %>

          <% if transfer.processor %>
            <%= render "admin/review_fact", label: "Processed by", value: user_mention(transfer.processor) %>
          <% end %>
        </div>
      </section>

      <%= render "admin/review_receipts", hcb_code: %>
    </div>

    <div class="flex flex-col gap-4 min-w-0">
      <% if transfer.pending? %>
        <% verb = transfer.scheduled_on.present? ? "Approve" : "Send" %>

        <section class="card flex flex-col gap-3.5 overflow-visible">
          <h3 class="eyebrow m-0"><%= verb %></h3>

          <div class="field">
            <label class="bold">Transaction category</label>
            <%= render partial: "hcb_codes/transaction_category_form", locals: { model: hcb_code.ct || hcb_code.pt } %>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <%= form_with(model: false, local: true, url: ach_approve_admin_path(transfer), method: :post, class: "contents", data: { turbo_frame: "_top" }) do %>
              <%= button_tag "#{verb} transfer", name: nil, class: "btn bg-success",
                    data: { turbo_confirm: "Are you sure? Once an ACH transfer is sent, it cannot be un-sent." } %>
            <% end %>

            <% unless transfer.scheduled_on.present? %>
              <%= form_with(model: false, local: true, url: ach_send_realtime_admin_path(transfer), method: :post, class: "contents", data: { turbo_frame: "_top" }) do %>
                <%= button_tag "⚡ Send in realtime", name: nil, class: "btn btn-default",
                      data: { turbo_confirm: "Are you sure? Once a realtime transfer is sent, it cannot be un-sent. Realtime transfers incur a $1 fee from Column, that will be covered by HCB." } %>
              <% end %>
            <% end %>
          </div>

          <% if transfer.scheduled_on.present? %>
            <span class="block text-[0.8125rem] leading-snug opacity-60">
              Once approved, this transfer sends automatically on <%= transfer.scheduled_on.strftime("%B %-d, %Y") %>.
            </span>
          <% end %>
        </section>

        <%= render "admin/review_reject", url: ach_reject_admin_path(transfer) %>
      <% else %>
        <section class="card flex flex-col gap-3.5 overflow-visible">
          <p class="m0">
            <% if transfer.rejected? %>
              This transfer was rejected — it can't be approved.
            <% else %>
              This transfer has already been sent — it can't be approved or rejected.
            <% end %>
          </p>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
