<% title "Transfer ##{@disbursement.id}" %>

<% disbursement = @disbursement %>
<% transactions = disbursement.transactions_helper %>
<% state_badge = disbursement.rejected? ? "bg-error" : (disbursement.reviewing? ? "bg-pending" : "bg-muted") %>

<%= turbo_frame_tag(admin_process_frame_id(disbursement)) do %>
  <div class="admin-review">
    <div class="admin-review__hero">
      <span class="admin-review__amount"><%= render_money disbursement.amount %></span>
      <span class="badge <%= state_badge %> ml-0"><%= disbursement.state_text %></span>
      <span class="flex-grow"></span>
      <% if disbursement.local_hcb_code %>
        <%= link_to hcb_code_path(disbursement.local_hcb_code), class: "btn btn-small bg-muted flex-shrink-0", data: admin_popover_data_for(disbursement) do %>
          <%= inline_icon "payment-transfer" %>
          Transaction
        <% end %>
      <% end %>
    </div>

    <div class="admin-review__column">
      <section class="card admin-form__section">
        <h3 class="admin-form__title">Transfer</h3>

        <dl class="admin-review__facts m0">
          <% from = link_to(disbursement.source_event.name, disbursement.source_event, target: "_top") %>
          <% from += tag.span(" ❄️ frozen", class: "warning bold") if disbursement.source_event.financially_frozen? %>
          <%= render "admin/review_fact", label: "From", value: from %>

          <% to = link_to(disbursement.destination_event.name, disbursement.destination_event, target: "_top") %>
          <% to += tag.span(" ❄️ frozen", class: "warning bold") if disbursement.destination_event.financially_frozen? %>
          <%= render "admin/review_fact", label: "To", value: to %>

          <%= render "admin/review_fact", label: "Memo", value: disbursement.name %>
          <%= render "admin/review_fact", label: "Requested by", value: user_mention(disbursement.requested_by) %>

          <% fulfiller = disbursement.fulfilled_by ? user_mention(disbursement.fulfilled_by) : tag.span("Nobody yet — this could be you! ✨", class: "muted") %>
          <%= render "admin/review_fact", label: (disbursement.rejected? ? "Rejected by" : "Fulfilled by"), value: fulfiller %>
        </dl>
      </section>
    </div>

    <div class="admin-review__column">
      <% if disbursement.rejected? %>
        <section class="card admin-form__section">
          <p class="m0">This transfer was rejected — there's nothing to process.</p>
        </section>
      <% elsif disbursement.pending? %>
        <%= render "admin/review_reject", url: disbursement_reject_admin_path(disbursement) %>
      <% else %>
        <section class="card admin-form__section">
          <h3 class="admin-form__title">Approve</h3>

          <span class="admin-form__hint">
            This transfer is held for human review.
            <% if disbursement.scheduled_on.present? %>
              Once approved, it sends automatically on <%= disbursement.scheduled_on.strftime("%B %-d, %Y") %>.
            <% end %>
          </span>

          <div class="admin-review__actions">
            <%= form_with(model: false, local: true, url: disbursement_approve_admin_path(disbursement), method: :post, class: "contents", data: { turbo_frame: "_top" }) do %>
              <%= button_tag "Approve transfer", name: nil, class: "btn bg-success" %>
            <% end %>
          </div>
        </section>

        <%= render "admin/review_reject", url: disbursement_reject_admin_path(disbursement) %>
      <% end %>
    </div>

    <div class="admin-review__full">
      <section class="card admin-form__section">
        <h3 class="admin-form__title">Source transactions</h3>
        <%= render "hcb_codes/transactions_table", canonical_transactions: transactions.settled_source, canonical_pending_transactions: transactions.pending_source, popovers: true %>
      </section>

      <section class="card admin-form__section">
        <h3 class="admin-form__title">Destination transactions</h3>

        <% if transactions.settled_destination.empty? && transactions.pending_destination.empty? %>
          <span class="admin-form__hint">Not created yet. When they are, they'll use this category:</span>

          <%= form_for(disbursement, url: disbursement_set_transaction_categories_path(disbursement), method: :post, data: { controller: "form" }, html: { class: "m-0" }) do |f| %>
            <% categories = TransactionCategory::Definition::ALL.map { |_, d| [d.label, d.slug] } %>
            <%= select_tag f.field_name(:destination_transaction_category_slug), options_for_select(categories, disbursement.destination_transaction_category&.slug), include_blank: "None", data: { action: "change->form#submit" }, class: "m-0" %>
          <% end %>
        <% else %>
          <%= render "hcb_codes/transactions_table", canonical_transactions: transactions.settled_destination, canonical_pending_transactions: transactions.pending_destination, popovers: true %>
        <% end %>
      </section>
    </div>
  </div>
<% end %>
