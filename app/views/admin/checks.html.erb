<% title "Checks" %>

<%= form_with local: true, class: "card admin-filters", url: checks_admin_index_path, method: :get do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= render "admin/date_range_filter", start_date: @start_date, end_date: @end_date %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :in_transit, label: "In transit", checked: @in_transit %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Event</th>
      <th>Recipient</th>
      <th>Check Number</th>
      <th class="w-32">Amount</th>
      <th>Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @checks.each do |check| %>
      <tr class="<%= "admin-bg-pending" if check.in_transit? %> <%= "admin-bg-transit" if check.in_transit_and_processed? %>">
        <td><%= check.id %></td>
        <td>
          <%= check.created_at.strftime("%Y-%m-%d") %>
          <% if check.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td><%= check.event.name.upcase %></td>
        <td><%= check.recipient_name %></td>
        <td><%= check.check_number || "-----" %></td>
        <td><%= render_money_amount(check.amount) %></td>
        <td><%= check.aasm_state.upcase %></td>
        <td>
          <%= pop_icon_to "external", check_path(check), "aria-label": "View", data: admin_popover_data_for(check) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @checks, entry_name: "check" %>
  </div>
  <%= paginate @checks %>
</div>
</div>
