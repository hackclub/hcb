<% title "Organization Balances" %>

<%= form_with local: true, action: :balances, method: :get, class: "card admin-filters", data: { "turbo": "false" } do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
  </div>

  <%= render "admin/events_filter", form:, actions: false %>

  <div class="admin-filters__grid">
    <%= render layout: "admin/filters/field", locals: { label: "Start date" } do %>
      <%= form.date_field :start_date, value: @start_date %>
    <% end %>
    <%= render layout: "admin/filters/field", locals: { label: "End date" } do %>
      <%= form.date_field :end_date, value: @end_date %>
    <% end %>
  </div>

  <div class="admin-filters__row">
    <div class="admin-filters__actions">
      <% if request.query_parameters.except("page").any? %>
        <%= link_to "Clear", request.path, class: "admin-filters__clear" %>
      <% end %>
      <%= button_tag("Export CSV", value: "csv", name: "format", disable_with: false, formtarget: "_blank", class: "btn") %>
      <%= button_tag("Export JSON", value: "json", name: "format", disable_with: false, formtarget: "_blank", class: "btn") %>
      <%= button_tag("Export CSV (breakdown)", value: "true", name: "monthly_breakdown", type: "submit", formaction: "/admin/balances.csv", disable_with: false, formtarget: "_blank", class: "btn") %>
      <%= form.submit "Search", class: "btn bg-info" %>
    </div>
  </div>
<% end %>

<p><%= pluralize(@count, "result") %></p>

<div class="table-container">
<table>
  <thead>
  <tr>
    <% @headers.each do |header| %>
      <th><%= header %></th>
    <% end %>
  </tr>
  </thead>
  <tbody>
    <% @rows.each do |row| %>
    <tr>
      <td><%= row[0] %></td>
      <td><a href="<%= event_path(row[0]) %>"><%= row[1] %></a></td>
      <td><%= row[2] %></td>
      <td><%= row[3] %></td>
      <td><%= row[4] %></td>

      <% if !row[5] && !row[6] %>
        <td colspan="2">All&nbsp;time</td>
      <% else %>
        <td><%= row[5] %></td>
        <td><%= row[6] %></td>
      <% end %>

    </tr>
  <% end %>
  </tbody>
</table>
<% if @count.zero? %>
  <%= blankslate "No events." %>
<% end %>
</div>
