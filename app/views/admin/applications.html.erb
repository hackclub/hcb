<% title "Applications (HCB)" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: applications_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :include_archived, label: "Include archived", checked: @include_archived %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table class="min-w-0">
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Project Name</th>
      <th>User</th>
      <th>Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @applications.each do |application| %>
      <tr class="<%= "shade-yellow" if application.submitted? %> <%= "shade-cyan" if application.approved? %>">
        <td><%= application.id %></td>
        <td><%= application.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= application.name %></td>
        <td><%= user_mention(application.user) %></td>
        <td><%= application.aasm.human_state %></td>
        <td class="text-nowrap">
          <%= pop_icon_to "external", submission_application_path(application), "aria-label": "View" %>
          <%= link_to "Airtable", airtable_application_path(application), target: "_blank" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @applications, entry_name: "applications" %>
  </div>
  <%= paginate @applications %>
</div>

</div>
