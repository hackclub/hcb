<% title "Create an organization" %>

<% content_for(:admin_actions) do %>
  <%= link_to event_new_from_airtable_admin_index_path, class: "btn" do %>
    Create from Airtable
  <% end %>
<% end %>

<%= form_with(local: true, url: event_create_admin_index_path, class: "fields flex flex-col gap-4 max-w-[46rem]") do |form| %>
  <section class="card flex flex-col gap-3.5 overflow-visible">
    <h3 class="eyebrow m-0">Organization</h3>

    <div class="field">
      <%= form.label :name, "Name" %>
      <%= form.text_field :name, placeholder: "Hack Club Bank", value: params[:name], required: true, autofocus: true %>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-x-4 gap-y-3.5">
      <div class="field">
        <%= form.label :country %>
        <%= form.collection_select :country, Event.countries_for_select, :first, :last, selected: params[:country] %>
      </div>

      <div class="field">
        <%= form.label :plan, "Plan" %>
        <%= form.select(:plan, Event::Plan.available_plans.map { |p| [p.new.label, p.name] }, selected: params[:plan]) %>
      </div>
    </div>

    <div class="field">
      <%= form.label :tags, "Tags" %>
      <span class="block text-[0.8125rem] leading-snug opacity-60">Optional. Used for reporting and partner filtering.</span>
      <%# Mirrors what a multi-select would send, so `tags` is always present. %>
      <%= hidden_field_tag "tags[]", "", id: nil %>
      <div class="flex flex-wrap gap-2 mt-1">
        <% EventTag::Tags::ALL.each do |tag| %>
          <label class="checkbox-pill">
            <%= check_box_tag "tags[]", tag, Array(params[:tags]).include?(tag), id: nil %>
            <%= tag %>
          </label>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card flex flex-col gap-3.5 overflow-visible" data-controller="form-hide-field" data-form-hide-field-condition-value="false">
    <h3 class="eyebrow m-0">Organizer</h3>

    <div class="field">
      <%= form.label :organizer_email, "Email address" %>
      <span class="block text-[0.8125rem] leading-snug opacity-60">Leave blank to create the organization without inviting anyone.</span>
      <%= form.email_field :organizer_email, placeholder: "orpheus@hackclub.com", value: params[:organizer_email] %>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-x-4 gap-y-3.5">
      <div class="field">
        <%= form.label :is_signee, "Contract" %>
        <%= form.select :is_signee,
              [["📃 Will sign the contract", "true"], ["❌ Won't sign the contract", "false"]],
              { selected: "true" },
              { required: true, data: { form_hide_field_target: "select", action: "form-hide-field#toggle" } } %>
      </div>

      <div class="field" data-form-hide-field-target="field">
        <%= form.label :cosigner_email, "Cosigner email" %>
        <%= form.email_field :cosigner_email, placeholder: "Required if the organizer is under 18" %>
      </div>
    </div>

    <label class="checkbox-card">
      <%= form.check_box :include_videos %>
      <span>
        <strong>Include onboarding videos</strong>
        <span class="block text-[0.8125rem] leading-snug opacity-60">Sends the getting-started videos along with the contract.</span>
      </span>
    </label>
  </section>

  <section class="card flex flex-col gap-3.5 overflow-visible">
    <h3 class="eyebrow m-0">Internal</h3>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(13rem,1fr))] gap-x-4 gap-y-3.5">
      <div class="field">
        <%= form.label :point_of_contact_id, "Point of contact" %>
        <%= form.collection_select :point_of_contact_id, User.admin.all, :id, :email, selected: @current_user.id %>
      </div>

      <div class="field">
        <%= form.label :risk_level, "Risk level" %>
        <%= form.collection_select :risk_level, Event.risk_levels.map { |k, _v| [k.humanize.capitalize, k] }, :last, :first, { include_blank: "Unset" }, selected: params[:risk_level] %>
      </div>
    </div>
  </section>

  <section class="card flex flex-col gap-3.5 overflow-visible">
    <h3 class="eyebrow m-0">Settings</h3>

    <label class="checkbox-card">
      <%= form.check_box :is_public, { checked: true } %>
      <span>
        <strong>Transparent</strong>
        <span class="block text-[0.8125rem] leading-snug opacity-60">Publishes the organization's ledger on its public page.</span>
      </span>
    </label>

    <label class="checkbox-card">
      <%= form.check_box :approved, { checked: true } %>
      <span>
        <strong>Approved</strong>
        <span class="block text-[0.8125rem] leading-snug opacity-60">Unapproved organizations can't move money.</span>
      </span>
    </label>

    <label class="checkbox-card">
      <%= form.check_box :demo_mode %>
      <span>
        <strong>Playground mode</strong>
        <span class="block text-[0.8125rem] leading-snug opacity-60">For trying HCB out. No real money, and the organization can be upgraded later.</span>
      </span>
    </label>
  </section>

  <div class="flex flex-wrap items-center gap-3">
    <%# button_tag, not form.submit: `.bg-success` ties on specificity with the
        dark-mode `input[type=submit]` rule and loses on source order. %>
    <%= button_tag "Create organization", name: nil, class: "btn bg-success" %>
    <%= link_to "Cancel", events_admin_index_path, class: "font-medium text-muted no-underline hover:text-blue focus:text-blue" %>
  </div>
<% end %>
