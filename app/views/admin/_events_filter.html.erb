<%# locals: (form:, actions: true) %>
<div class="filter-form__grid">
  <%= render "admin/filters/select", form:, name: :transparent, label: "Transparent",
        choices: [["Both", "both"], ["Not transparent", "not_transparent"], ["Transparent", "transparent"]],
        options: { selected: @transparent } %>

  <%= render "admin/filters/select", form:, name: :omitted, label: "Omitted",
        choices: [["Both", "both"], ["Not omitted", "not_omitted"], ["Omitted", "omitted"]],
        options: { selected: @omitted } %>

  <%= render "admin/filters/select", form:, name: :demo_mode, label: "Demo",
        choices: [["Both", "both"], ["Full", "full"], ["Demo", "demo"]],
        options: { selected: @demo_mode } %>

  <%= render "admin/filters/select", form:, name: :active, label: "Active",
        choices: [["Both", "both"], ["Inactive", "inactive"], ["Active", "active"]],
        options: { selected: @active } %>

  <%= render "admin/filters/select", form:, name: :hidden, label: "Hidden",
        choices: [["Both", "both"], ["Not hidden", "not_hidden"], ["Hidden", "hidden"]],
        options: { selected: @hidden } %>

  <%= render "admin/filters/select", form:, name: :funded, label: "Funded",
        choices: [["Both", "both"], ["Not funded", "not_funded"], ["Funded", "funded"]],
        options: { selected: @funded } %>

  <%= render "admin/filters/select", form:, name: :organized_by, label: "Organized by",
        choices: [["Anyone", "anyone"], ["Teenagers", "teenagers"], ["Hack Clubbers", "hack_clubbers"], ["Adults", "adults"]],
        options: { selected: @organized_by } %>

  <%= render "admin/filters/select", form:, name: :country, label: "Country",
        choices: { 'Outside US': 9999 }.merge(Event.countries),
        options: { include_blank: "All", selected: @country } %>

  <%= render layout: "admin/filters/field", locals: { label: "Point of contact" } do %>
    <%= combobox_tag :point_of_contact_id, user_search_admin_index_path, placeholder: "Anyone", value: @point_of_contact&.to_combobox_display %>
  <% end %>

  <%= render layout: "admin/filters/field", locals: { label: "Activity since" } do %>
    <%= form.date_field :activity_since, value: @activity_since_date %>
  <% end %>

  <%= render "admin/filters/select", form:, name: :plan, label: "Current plan",
        choices: Event::Plan.available_plans.map { |p| [p.new.label, p.name] },
        options: { include_blank: "All", selected: @plan } %>

  <%= render "admin/filters/select", form:, name: :tagged_with, label: "Tagged with",
        choices: EventTag.all.map { |t| [t.full_name, t.id] },
        options: { include_blank: "Anything", selected: @tagged_with } %>

  <%= render "admin/filters/select", form:, name: :risk_level, label: "Risk level",
        choices: Event.risk_levels.map { |k, v| [k.humanize.capitalize, v] }.append(%w[Unset unset]),
        options: { include_blank: "Any", selected: @risk_level } %>

  <%= render "admin/filters/select", form:, name: :sort_by, label: "Sort by",
        choices: [["Balance ascending", "balance_asc"], ["Balance descending", "balance_desc"], ["Date descending", "date_desc"]],
        options: { selected: @sort_by } %>
</div>

<div class="flex flex-wrap items-center gap-2">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 py-1.5 px-2 rounded-md shadow-border bg-[rgba(200,200,200,0.08)]">
    <span class="eyebrow m-0 pl-0.5 opacity-55">State</span>
    <%= render "admin/filters/toggle", form:, name: :pending, label: "Pending", checked: @pending %>
    <%= render "admin/filters/toggle", form:, name: :unapproved, label: "Unapproved", checked: @unapproved %>
    <%= render "admin/filters/toggle", form:, name: :approved, label: "Approved", checked: @approved %>
    <%= render "admin/filters/toggle", form:, name: :rejected, label: "Rejected", checked: @rejected %>
    <%= render "admin/filters/toggle", form:, name: :engaged, label: "Engaged only", checked: @engaged %>
  </div>

  <% if actions %>
    <%= render "admin/filters/actions", form: %>
  <% end %>
</div>
