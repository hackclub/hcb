<%# locals: (form:, label: "Search", export_count: nil, export_params: nil) %>
<div class="admin-filters__actions">
  <% if request.query_parameters.except("page").any? %>
    <%= link_to "Clear", request.path, class: "admin-filters__clear" %>
  <% end %>

  <% unless export_count.nil? %>
    <% export_query = (export_params&.to_h || request.query_parameters).except("format", "page").to_query %>
    <%= link_to "#{url_for(format: :csv, only_path: true)}?#{export_query}", class: "btn #{"disabled" if export_count.zero?}" do %>
      <%= inline_icon "download", size: 20 %>
      Export <%= pluralize export_count, "record" %>
    <% end %>
  <% end %>

  <%= form.submit label, class: "btn bg-info" %>
</div>
