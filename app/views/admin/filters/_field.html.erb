<%# Layout partial: wraps an arbitrary control in an eyebrow-labelled field. %>
<%# locals: (label:) %>
<label class="flex flex-col gap-1 min-w-0 text-inherit">
  <span class="eyebrow m-0 block leading-none whitespace-nowrap overflow-hidden text-ellipsis"><%= label %></span>
  <%= yield %>
</label>
