<% title "Pending Ledger" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: pending_ledger_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :unsettled, label: "Unsettled", checked: @unsettled %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Memo</th>
      <th>Amount</th>
      <th>HCB Code</th>
      <th>Event</th>
      <th>Category</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @canonical_pending_transactions.each do |cpt| %>
      <tr class="<%= "shade-yellow" if cpt.unsettled? %>">
        <td><%= cpt.id %></td>
        <td>
          <%= cpt.date %>
          <% if cpt.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td>
          <% if cpt.event %>
            <%= link_to cpt.memo, cpt.local_hcb_code, data: admin_popover_data_for(cpt) %>
          <% else %>
            <%= cpt.memo %>
          <% end %>
        </td>
        <td><%= cpt.amount %></td>
        <td><%= cpt.hcb_code %></td>
        <td><%= cpt.event.try(:id) %></td>
        <td>
          <%= render(
                partial: "hcb_codes/transaction_category_form",
                locals: { model: cpt, admin_context: true }
              ) %>
        </td>
        <td>
          <%#= link_to "Process", transaction_admin_path(cpt) unless cpt.event.present? %>
          <%#= link_to "View", transaction_admin_path(cpt) if cpt.event.present? %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @canonical_pending_transactions, entry_name: "transactions" %>
  </div>
  <%= paginate @canonical_pending_transactions %>
</div>

</div>
