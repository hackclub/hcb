<% title "Wise Transfers" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: wise_transfers_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= form.collection_select(:status, WiseTransfer.aasm.states, :name, :human_name, { include_blank: "All statuses", selected: @status }) %>
    <%= render "admin/date_range_filter", start_date: @start_date, end_date: @end_date %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :exclude_reimbursements, label: "Exclude reimbursements", checked: @exclude_reimbursements %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th class="w-32">Date</th>
      <th>Event</th>
      <th>Recipient</th>
      <th class="w-32">Amount</th>
      <th>Status</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @wise_transfers.each do |wise_transfer| %>
      <tr class="<%= "shade-yellow" if wise_transfer.pending? %> <%= "shade-cyan" if wise_transfer.approved? %>">
        <td><%= wise_transfer.id %></td>
        <td><%= wise_transfer.created_at.strftime("%Y-%m-%d") %></td>
        <td><%= wise_transfer.event.name %></td>
        <td><%= wise_transfer.recipient_name %></td>
        <td><%= Money.from_cents(wise_transfer.amount_cents, wise_transfer.currency).format %></td>
        <td><%= wise_transfer.aasm.human_state %></td>
        <td>
          <div class="flex items-center gap-2">
            <%= pop_icon_to "external", hcb_code_path(wise_transfer.hcb_code), "aria-label": "View", data: admin_popover_data_for(wise_transfer) %>
            <%= link_to "Process", wise_transfer_process_admin_path(wise_transfer), class: "btn", data: admin_process_popover_data(wise_transfer) %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @wise_transfers, entry_name: "transfers" %>
  </div>
  <%= paginate @wise_transfers %>
</div>

</div>
