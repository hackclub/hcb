<% title "ACH Transfers" %>

<%= form_with local: true, class: "card filter-form flex flex-col gap-2.5 p-3", url: ach_admin_index_path, method: :get do |form| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "events/filters/search", form: %>
    <%= render "admin/filters/event", event: @event %>
    <%= render "admin/date_range_filter", start_date: @start_date, end_date: @end_date %>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= render "admin/filters/toggle", form:, name: :pending, label: "Pending", checked: @pending %>
    <%= render "admin/filters/toggle", form:, name: :exclude_reimbursements, label: "Exclude reimbursements", checked: @exclude_reimbursements %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Recipient</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Confirmation No.</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @ach_transfers.each do |ach| %>
      <tr class="<%= "shade-yellow" if ach.pending? %> <%= "shade-cyan" if ach.in_transit? %>">
        <td><%= ach.id %></td>
        <td><%= ach.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to ach_transfer_path(ach), data: admin_popover_data_for(ach) do %>
            <%= ach.event.name.upcase %>: <%= ach.recipient_name.upcase %>
          <% end %>
        </td>
        <td><%= render_money_amount(ach.amount) %></td>
        <td>
          <%= ach.aasm_state.upcase %>
          <% if ach.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td><%= ach.confirmation_number %></td>
        <td>
          <%= link_to "Process", ach_start_approval_admin_path(ach), class: "btn", data: admin_process_popover_data(ach) if ach.pending? %>
          <%= pop_icon_to "external", ach_start_approval_admin_path(ach), "aria-label": "View" unless ach.pending? %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @ach_transfers, entry_name: "ACH transfers" %>
  </div>
  <%= paginate @ach_transfers %>
</div>
</div>
