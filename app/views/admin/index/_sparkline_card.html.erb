<%# locals: (title:, value:, series:, color:, format: "money") %>
<div class="card card--breakdown p-0 flex flex-col overflow-hidden"
     data-controller="admin-sparkline"
     data-admin-sparkline-data-value="<%= series.to_json %>"
     data-admin-sparkline-format-value="<%= format %>">
  <div class="p-4 pb-2 flex flex-col gap-1">
    <span class="muted uppercase text-sm" style="font-weight: 700">
      <%= title %> <span data-admin-sparkline-target="period">today</span>
    </span>
    <span class="stat__value tabular-nums" data-admin-sparkline-target="value"><%= value %></span>
  </div>

  <div class="flex-grow" style="min-height: 16px"></div>

  <svg data-admin-sparkline-target="graph"
       class="w-full block"
       width="320"
       height="80"
       fill="none"
       stroke="<%= color %>"
       stroke-width="2.5"
       stroke-linecap="round"
       stroke-linejoin="round"></svg>
</div>
