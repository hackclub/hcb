<% title "Ledger Items" %>

<%= form_with local: true, url: ledger_items_admin_index_path, method: :get, class: "card admin-filters" do |form| %>
  <div class="admin-filters__row">
    <%= render "events/filters/search", form: %>
    <%= form.text_field :amount, value: params[:amount], placeholder: "Amount (¢)" %>
  </div>
  <div class="admin-filters__row">
    <%= render "admin/filters/toggle", form:, name: :unmapped, label: "Unmapped", checked: @unmapped %>
    <%= render "admin/filters/toggle", form:, name: :nonzero, label: "Non-zero", checked: @nonzero %>
    <%= render "admin/filters/actions", form: %>
  </div>
<% end %>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th class="w-32">ID</th>
      <th class="w-32">Date</th>
      <th>Memo</th>
      <th class="w-40">Type</th>
      <th class="w-24">Amount</th>
      <th class="w-16">CTs</th>
      <th class="w-16">CPTs</th>
      <th class="w-24">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @ledger_items.each do |ledger_item| %>
      <tr>
        <td><%= ledger_item.id %></td>
        <td><%= ledger_item.datetime.to_date %></td>
        <td><%= link_to ledger_item.memo, ledger_item_path(ledger_item), data: admin_popover_data_for(ledger_item) %></td>
        <td><%= ledger_item.humanized_type %></td>
        <td class="nowrap"><%= ledger_item.amount.format %></td>
        <td><%= ledger_item.canonical_transactions.size %></td>
        <td><%= ledger_item.canonical_pending_transactions.size %></td>
        <td>
          <%= link_to "View", ledger_item_path(ledger_item) %>
          <% if ledger_item.hcb_code.present? %>
            <br>
            <%= link_to "HCB Code", hcb_code_path(ledger_item.hcb_code), data: admin_popover_data_for(ledger_item.hcb_code) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @ledger_items.empty? %>
  <%= blankslate "No ledger items" %>
<% end %>

<div class="table-footer">
  <div class="flex-grow">
    <%= page_entries_info @ledger_items, entry_name: "ledger items" %>
  </div>
  <%= paginate @ledger_items %>
</div>
</div>
