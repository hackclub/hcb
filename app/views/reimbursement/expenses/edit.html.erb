<% title "Edit Expense on #{@expense.report.name}" %>
<% @event = @expense.report.event %>
<% page_md %>
<%= render "events/nav", selected: :reimbursements, event: @event, home_size: @home_size unless @use_user_nav %>
<%= render "users/nav", selected: :reimbursements, activities: @activities, before: @before, home_size: @home_size, user: @user if @use_user_nav %>

<div class="mt4">
  <h2 class="heading mt0 flex">
    Edit Expense on <%= @expense.report.name %>
  </h2>
</div>

<div class="mt2">
  <%= render "reimbursement/expenses/expense", expense: @expense, event: @event, ledger_instance: @ledger_instance %>
</div>
