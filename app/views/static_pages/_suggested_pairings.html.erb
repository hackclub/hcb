<%# locals: (pairings:, current_slide: 0, initial_slide: current_slide + 1, total: pairings.length) %>
<%# herb:slots client %>
<%# herb:state (dismissed: false, slide: initial_slide, last_slide: total) %>
<%= turbo_frame_tag "suggested_pairings" do %>
  <% if pairings.any? %>
    <div class="card carousel__wrapper mt2" style="overflow: unset; border: 1px solid var(--ai);" hidden="<%= dismissed %>">
      <div style="margin: -16px; padding: 16px; margin-bottom: 0px; border-radius: 0.5rem 0.5rem 0rem 0rem;" class="bg-snow dark:bg-dark">
        <span tabindex="0" role="button" aria-label="Dismiss" data-herb-set="click->dismissed=true keydown.return->dismissed=true" class="pointer">
          <%= inline_icon "view-close", size: 28, class: "pop modal__close muted  m0" %>
        </span>
        <div style="display: flex; padding-right: 32px;">
          <h2 class="h2 mt0 mb0 pb0 border-none ai"><%= inline_icon "rep", size: 36, style: "margin: -8px; margin-right: 0px;" %> Suggested pairing</h2>
          <span style="flex-grow: 1;"></span>
          <span style="line-height: 0px; display: flex; align-items: center;">
            <span>
              <span class="carousel__number"><%= slide %></span>&nbsp;of&nbsp;<%= pairings.length %>
            </span>
          </span>

        </div>
      </div>

      <div class="carousel">
        <button type="button" class="carousel__button carousel__button--left pop" aria-label="Previous suggestion" hidden="<%= slide == 1 %>" data-herb-decrement="slide">
          <%= inline_icon "view-back", size: 40 %>
        </button>
        <div class="carousel__items">
          <% pairings.each_with_index do |pairing, i| %>
            <%# herb:key pairing.id %>
            <%= render "static_pages/suggested_pairing_slide", pairing:, i:, position: i + 1, state: { slide: slide } %>
          <% end %>
        </div>
        <button type="button" class="carousel__button carousel__button--right pop" aria-label="Next suggestion" hidden="<%= slide == last_slide %>" data-herb-increment="slide">
          <%= inline_icon "view-back", size: 40 %>
        </button>
      </div>
    </div>
  <% end %>
<% end %>
