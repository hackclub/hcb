<%# locals: (disbursement:, event: nil, source_event: nil) %>

<% disabled = source_event.present? && !policy(source_event).create_transfer? %>

<% repayable_url = repayable_transactions_disbursements_path %>
<% repayable_src = disbursement.destination_event ? repayable_transactions_disbursements_path(destination_event_id: disbursement.destination_event.public_id) : repayable_url %>

<%= form_with(model: disbursement, local: true, url: disbursements_path, html: { "x-data" => "{fee: null, event_id: null}" }, data: { controller: "transfer-type", transfer_type_repayable_url_value: repayable_url, action: "combobox:change->transfer-type#comboboxChanged submit->transfer-type#submit" }) do |form| %>
  <%= form_errors(disbursement, "Disbursements") %>

  <div data-scroll-seek-target="section">
    <h3 class="mb-2">Transfer details</h3>
    <div class="card mb-4 relative">
      <div class="field">
        <%= form.label :name, "What is the transfer for?" %>
        <span class="muted block mb-1">This is to help HCB keep record of our transactions.</span>
        <%= form.text_field :name, placeholder: "Donating extra funds to another organization", maxlength: 60, required: true, class: "!max-w-full", disabled: %>
      </div>

      <%= render "events/transfers/attach_receipt", form:, disabled: %>
    </div>
  </div>

  <div data-scroll-seek-target="section" data-controller="swap-organizations">
    <h3 class="mb-2">Payment details</h3>
    <div class="card mb-4 relative overflow-visible">
      <div class="flex gap-2">
        <%= render partial: "disbursements/select_organization", locals: { form: form, field_name: "source_event_id", disabled: disabled, label: "From", sending: true } %>
        <button type="button"
                class="pop self-center mt-2"
                title="Swap organizations"
                aria-label="Swap organizations"
                <%= "disabled" if disabled %>
                data-action="swap-organizations#swap">
          <%= inline_icon "transfers-horizontal", size: 20 %>
        </button>
        <%= render partial: "disbursements/select_organization", locals: { form: form, field_name: "event_id", disabled: disabled, label: "To", source_event: source_event } %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.label :amount, "Amount" %>
        <div class="flex items-center input py-0 max-w-[150px]">
          <span class="bold muted">$</span>
          <%= form.number_field :amount, class: "!border-0 !shadow-none !max-w-full !min-w-full", value: (disbursement&.amount.nil? ? nil : (disbursement&.amount.to_f / 100)), placeholder: "500.00", step: 0.01, min: 0.01, required: true, disabled:, data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad", transfer_type_target: "amount" } %>
        </div>
      </div>
    </div>
  </div>

  <div data-scroll-seek-target="section">
    <h3 class="mb-2">What kind of transfer is this?</h3>
    <%# Disabled until a recipient is picked: repayments list the recipient's transactions. %>
    <fieldset class="card mb-4 relative overflow-visible m-0 min-w-0 transition-opacity disabled:opacity-50" data-transfer-type-target="section" <%= "disabled" unless disbursement.destination_event %>>
      <p class="muted mt-0 mb-3" data-transfer-type-target="hint" <%= "hidden" if disbursement.destination_event %>>Choose who you're sending to first.</p>

      <div class="flex flex-col gap-2">
        <% [
             ["repayment", "reimbursement", "Repayment", "Paying the other organization back for an expense they covered for you, like supplies bought on their card."],
             ["payment", "payment", "Payment", "Paying the other organization for something they provided, like tickets, a venue, or services."],
             ["transfer", "transfers-horizontal", "Transfer", "Sharing funds, like sending leftover money to another organization or funding a sub-organization."]
           ].each do |value, icon, title, description| %>
          <div>
            <%= form.radio_button :transfer_type, value, required: true, disabled:, class: "peer sr-only", data: { action: "transfer-type#select" } %>
            <%= form.label :transfer_type, value:, class: "flex items-center gap-4 m-0 p-4 rounded-lg border-2 border-solid border-smoke dark:border-slate cursor-pointer transition-colors hover:bg-blue/5 peer-checked:border-blue peer-checked:bg-blue/10 peer-focus-visible:ring-2 peer-focus-visible:ring-blue peer-disabled:cursor-not-allowed" do %>
              <span class="flex items-center justify-center shrink-0 w-11 h-11 rounded-full bg-blue/10 text-blue">
                <%= inline_icon icon, size: 26, class: "m-0" %>
              </span>
              <span class="flex flex-col gap-0.5 text-left">
                <strong class="text-base"><%= title %></strong>
                <span class="muted text-sm"><%= description %></span>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div data-transfer-type-target="panel" data-type="payment" hidden>
        <div class="field mt-4 mb-0">
          <%= form.label :payment_category_slug, "What are you paying for?" %>
          <%= form.select(
                :payment_category_slug,
                TransactionCategory::Definition::ALL.values.reject { |d| d.hq_only? && !admin_signed_in? }.map { |d| [d.label, d.slug] },
                { include_blank: "Choose a category" },
                required: true,
                class: "!max-w-full"
              ) %>
        </div>
      </div>

      <div data-transfer-type-target="panel" data-type="repayment" hidden>
        <div class="field mt-4 mb-0">
          <%= form.label :repaid_ledger_item_id, "Which of their transactions are you repaying?" %>
          <%= combobox_tag form.field_name(:repaid_ledger_item_id), repayable_src,
                           class: "!max-w-full",
                           data: { transfer_type_target: "repaymentCombobox" } %>
        </div>
      </div>
    </fieldset>
  </div>

  <div data-scroll-seek-target="section">
    <% if admin_signed_in? %>
      <% admin_tool do %>
        <h3 class="mb-2">Admin</h3>

        <div class="field field--checkbox">
          <%= form.check_box :should_charge_fee, checked: true %>
          <%= form.label :should_charge_fee do %>
            Charge fiscal sponsorship fee?
          <% end %>
        </div>

        <% category_select = ->(field) {
             form.select(
               field,
               options_for_select(
                 TransactionCategory::Definition::ALL.map { |_, d| [d.label, d.slug] }
               ),
               include_blank: "Based on transfer type"
             )
           } %>

        <div class="field">
          <%= form.label(:source_transaction_category_slug, "Source transaction category") %>
          <%= category_select.call(:source_transaction_category_slug) %>
        </div>

        <div class="field">
          <%= form.label(:destination_transaction_category_slug, "Destination transaction category") %>
          <%= category_select.call(:destination_transaction_category_slug) %>
        </div>

        <div class="field">
          <%= form.label :scheduled_on, "Schedule for" %>
          <%= form.date_select :scheduled_on, prompt: true, order: [:month, :day, :year], start_year: Date.today.year %>
          <p class="h5 muted mt0 mb1">Leave blank to send instantly</p>
        </div>
      <% end %>
    <% end %>

    <button type="submit" class="gap-2 btn w-full bg-blue mt-2" <%= "disabled" if disabled %>>
      Send transfer
      <%= inline_icon "send" %>
    </button>
  </div>
<% end %>
