<%# locals: (disbursement:, event: nil, source_event: nil, repaid_ledger_item: nil) %>

<% disabled = source_event.present? && !policy(source_event).create_transfer? %>

<%= form_with(model: disbursement, local: true, url: disbursements_path, html: { "x-data" => "{fee: null, event_id: null}" }, data: { controller: "transfer-type", transfer_type_repayment_picker_outlet: "#repayment_picker", action: "combobox:change->transfer-type#comboboxChanged repayment-picker:select@document->transfer-type#repaymentPicked submit->transfer-type#submit" }) do |form| %>
  <%= form_errors(disbursement, "Disbursements") %>

  <div data-scroll-seek-target="section">
    <h3 class="mb-2">Transfer details</h3>
    <div class="card mb-4 relative">
      <div class="field">
        <%= form.label :name, "What is the transfer for?" %>
        <span class="muted block mb-1">This is to help HCB keep record of our transactions.</span>
        <%= form.text_field :name, placeholder: "Donating extra funds to another organization", maxlength: 60, required: true, class: "!max-w-full", disabled:, data: { transfer_type_target: "name" } %>
      </div>

      <%= render "events/transfers/attach_receipt", form:, disabled: %>
    </div>
  </div>

  <div data-scroll-seek-target="section" data-controller="swap-organizations">
    <h3 class="mb-2">Payment details</h3>
    <div class="card mb-4 relative overflow-visible">
      <div class="flex gap-2">
        <%= render partial: "disbursements/select_organization", locals: { form: form, field_name: "source_event_id", disabled: disabled, label: "From", sending: true } %>
        <button type="button"
                class="pop self-center mt-2"
                title="Swap organizations"
                aria-label="Swap organizations"
                <%= "disabled" if disabled %>
                data-action="swap-organizations#swap">
          <%= inline_icon "transfers-horizontal", size: 20 %>
        </button>
        <%= render partial: "disbursements/select_organization", locals: { form: form, field_name: "event_id", disabled: disabled, label: "To", source_event: source_event } %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.label :amount, "Amount" %>
        <div class="flex items-center input py-0 max-w-[150px]">
          <span class="bold muted">$</span>
          <%= form.number_field :amount, class: "!border-0 !shadow-none !max-w-full !min-w-full", value: (disbursement&.amount.nil? ? nil : (disbursement&.amount.to_f / 100)), placeholder: "500.00", step: 0.01, min: 0.01, required: true, disabled:, data: { controller: "truncate-decimal", action: "truncate-decimal#truncate blur->truncate-decimal#pad", transfer_type_target: "amount" } %>
        </div>
      </div>
    </div>
  </div>

  <div data-scroll-seek-target="section">
    <h3 class="mb-2">What kind of transfer is this?</h3>
    <%# Disabled until a recipient is picked: repayments list the recipient's transactions. %>
    <fieldset class="card mb-4 relative overflow-visible m-0 min-w-0 transition-opacity disabled:opacity-50" data-transfer-type-target="section" <%= "disabled" unless disbursement.destination_event %>>
      <p class="muted mt-0 mb-3" data-transfer-type-target="hint" <%= "hidden" if disbursement.destination_event %>>Choose who you're sending to first.</p>
      <% repayable = disbursement.destination_event.nil? || policy(disbursement).repay? %>
      <p class="muted mt-0 mb-3" data-transfer-type-target="repaymentHint" <%= "hidden" if repayable %>>Only members of the organization you're sending to can repay its transactions.</p>

      <div class="flex flex-col gap-2">
        <% [
             ["repayment", "payment", "Repayment", "Paying the other organization back for an expense they covered for you, like supplies bought on their card."],
             ["transfer", "transfers-horizontal", "Internal transfer", "Sharing funds, like sending leftover money to another organization or funding a sub-organization."]
           ].each do |value, icon, title, description| %>
          <div>
            <%= form.radio_button :transfer_type, value,
                                  disabled: disabled || (value == "repayment" && !repayable),
                                  class: "peer sr-only",
                                  data: { action: "transfer-type#select", transfer_type_target: ("repaymentRadio" if value == "repayment") } %>
            <%= form.label :transfer_type, value:, class: "flex items-center gap-4 m-0 p-4 rounded-lg border-2 border-solid border-smoke dark:border-slate cursor-pointer transition-colors hover:bg-blue/5 peer-checked:border-blue peer-checked:bg-blue/10 peer-focus-visible:ring-2 peer-focus-visible:ring-blue peer-disabled:cursor-not-allowed peer-disabled:opacity-50" do %>
              <span class="flex items-center justify-center shrink-0 w-11 h-11 rounded-full bg-blue/10 text-blue">
                <%= inline_icon icon, size: 26, class: "m-0" %>
              </span>
              <span class="flex flex-col gap-0.5 text-left">
                <strong class="text-base"><%= title %></strong>
                <span class="muted text-sm"><%= description %></span>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div data-transfer-type-target="panel" data-type="repayment" hidden>
        <div class="field mt-4 mb-0">
          <label for="repayment_picker_trigger">Which of their transactions are you repaying?</label>
          <%= form.hidden_field :repaid_ledger_item_id,
                                value: repaid_ledger_item&.hashid,
                                data: { transfer_type_target: "repaidInput", amount: (format("%.2f", -repaid_ledger_item.amount_cents / 100.0) if repaid_ledger_item) } %>
          <div class="flex items-center gap-3 p-3 rounded-lg border border-solid border-smoke dark:border-slate" data-transfer-type-target="repaidCard">
            <div class="flex-1 min-w-0">
              <p class="muted m-0" data-transfer-type-target="repaidEmpty" <%= "hidden" if repaid_ledger_item %>>No transaction chosen yet.</p>
              <div data-transfer-type-target="repaidSummary" <%= "hidden" unless repaid_ledger_item %>>
                <strong class="block truncate" data-transfer-type-target="repaidMemo"><%= repaid_ledger_item&.memo %></strong>
                <span class="muted text-sm" data-transfer-type-target="repaidDate"><%= repaid_ledger_item&.datetime&.strftime("%b %e, %Y") %></span>
              </div>
            </div>
            <strong class="shrink-0" data-transfer-type-target="repaidAmount" <%= "hidden" unless repaid_ledger_item %>><%= repaid_ledger_item&.amount&.abs&.format %></strong>
            <button type="button" id="repayment_picker_trigger" class="btn btn-small shrink-0" data-behavior="modal_trigger" data-modal="repayment_picker">
              <span data-transfer-type-target="chooseLabel" <%= "hidden" if repaid_ledger_item %>>Choose</span>
              <span data-transfer-type-target="changeLabel" <%= "hidden" unless repaid_ledger_item %>>Change</span>
            </button>
          </div>
          <p class="text-sm text-red mt-1 mb-0" role="alert" data-transfer-type-target="repaidError" hidden>Choose the transaction you're repaying.</p>
        </div>
      </div>
    </fieldset>
  </div>

  <div data-scroll-seek-target="section">
    <% if admin_signed_in? %>
      <% admin_tool do %>
        <h3 class="mb-2">Admin</h3>

        <div class="field field--checkbox">
          <%= form.check_box :should_charge_fee, checked: true %>
          <%= form.label :should_charge_fee do %>
            Charge fiscal sponsorship fee?
          <% end %>
        </div>

        <% category_select = ->(field) {
             form.select(
               field,
               options_for_select(
                 TransactionCategory::Definition::ALL.map { |_, d| [d.label, d.slug] }
               ),
               include_blank: "Based on transfer type"
             )
           } %>

        <div class="field">
          <%= form.label(:source_transaction_category_slug, "Source transaction category") %>
          <%= category_select.call(:source_transaction_category_slug) %>
        </div>

        <div class="field">
          <%= form.label(:destination_transaction_category_slug, "Destination transaction category") %>
          <%= category_select.call(:destination_transaction_category_slug) %>
        </div>

        <div class="field">
          <%= form.label :scheduled_on, "Schedule for" %>
          <%= form.date_select :scheduled_on, prompt: true, order: [:month, :day, :year], start_year: Date.today.year %>
          <p class="h5 muted mt0 mb1">Leave blank to send instantly</p>
        </div>
      <% end %>
    <% end %>

    <button type="submit" class="gap-2 btn w-full bg-blue mt-2" <%= "disabled" if disabled %>>
      Send transfer
      <%= inline_icon "send" %>
    </button>
  </div>
<% end %>

<%= render "disbursements/repayment_picker", destination_event: disbursement.destination_event %>
