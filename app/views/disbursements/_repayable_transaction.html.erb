<%# locals: (item:) %>

<% date = item.datetime.strftime("%b %e, %Y") %>
<% amount = item.amount.abs.format %>

<%# Clicking anywhere on the row toggles it; the Select button is what's
    focusable, so Enter or Space toggles it from the keyboard. Its click bubbles
    up to the row's action. Every row is an expense, so they skip the red
    negative-amount shading and only selected rows are tinted. %>
<tr class="transaction cursor-pointer hover:bg-blue/5 has-[[aria-pressed=true]]:bg-green/10 dark:has-[[aria-pressed=true]]:bg-green/15"
    data-repayment-picker-target="row"
    data-action="click->repayment-picker#toggle"
    data-repayment-picker-id-param="<%= item.hashid %>"
    data-repayment-picker-memo-param="<%= item.memo %>"
    data-repayment-picker-date-param="<%= date %>"
    data-repayment-picker-amount-param="<%= format("%.2f", -item.amount_cents / 100.0) %>"
    data-repayment-picker-amount-label-param="<%= amount %>">
  <td class="transaction__icon hidden sm:table-cell">
    <div class="tooltipped tooltipped--e" aria-label="<%= item.humanized_type %>">
      <%= render "ledger/items/icon", ledger_item: item %>
    </div>
  </td>
  <td class="nowrap hidden sm:table-cell"><%= date %></td>
  <td class="transaction__memo transaction__memo--fluid">
    <div>
      <div class="flex-auto min-w-0 overflow-hidden text-ellipsis" title="<%= item.memo %>">
        <%= render "ledger/items/memo/memo_text", item: %>
      </div>
    </div>
  </td>
  <td class="nowrap text-right"><%= item.amount.format %></td>
  <td class="w-0 text-right">
    <button type="button" class="btn btn-small group sm:min-w-[6.5rem]" aria-pressed="false" aria-label="Select <%= item.memo %>, <%= amount %> on <%= date %>">
      <span class="group-aria-pressed:hidden">Select</span>
      <span class="hidden group-aria-pressed:inline-flex items-center gap-1"><%= inline_icon "checkmark", size: 20, class: "!m-0" %><span class="hidden sm:inline">Selected</span></span>
    </button>
  </td>
</tr>
