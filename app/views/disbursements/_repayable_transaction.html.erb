<%# locals: (item:) %>

<% date = item.datetime.strftime("%b %e, %Y") %>
<% amount = item.amount.abs.format %>

<tr class="transaction transaction--<%= item.sign %> cursor-pointer hover:bg-blue/5" data-action="click->transaction-selection#toggleRow">
  <td>
    <input type="checkbox"
           aria-label="Repay <%= item.memo %>, <%= amount %> on <%= date %>"
           data-transaction-selection-target="checkbox"
           data-action="change->transaction-selection#toggle"
           data-transaction-selection-id-param="<%= item.hashid %>"
           data-transaction-selection-memo-param="<%= item.memo %>"
           data-transaction-selection-date-param="<%= date %>"
           data-transaction-selection-amount-param="<%= format("%.2f", -item.amount_cents / 100.0) %>">
  </td>
  <td class="transaction__icon">
    <div class="tooltipped tooltipped--e" aria-label="<%= item.humanized_type %>">
      <%= render "ledger/items/icon", ledger_item: item %>
    </div>
  </td>
  <td><%= date %></td>
  <td class="transaction__memo transaction__memo--fluid min-w-[12rem]">
    <div>
      <div class="flex-auto min-w-0 overflow-hidden text-ellipsis" title="<%= item.memo %>">
        <%= render "ledger/items/memo/memo_text", item: %>
      </div>
    </div>
  </td>
  <td class="nowrap text-right"><%= item.amount.format %></td>
</tr>
