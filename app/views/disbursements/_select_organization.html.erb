<%# locals: (form:, field_name:, label:, disabled:, sending: false) %>

<% search_path = event_search_disbursements_path(sending: sending || nil) %>
<% empty_message = "No results." unless sending %>

<% association_name = field_name.to_s.sub(/_id$/, "") %>
<% selected_event = form.object.try(association_name) %>
<%# Keyed on `public_id` rather than `id`, to match what `event_search` returns. %>
<% selected = selected_event && {
     value: selected_event.public_id,
     label: combobox_display(selected_event)
   } %>

<div class="field flex-1">
  <%= form.label field_name, label %>
  <%= combobox_tag form.field_name(field_name), search_path,
                   selected: selected,
                   empty_message: empty_message,
                   disabled: disabled,
                   class: "!max-w-full",
                   data: { swap_organizations_target: "combobox" } %>
</div>
