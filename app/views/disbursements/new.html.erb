<% title "Send an HCB transfer" %>
<% @back_url = @source_event ? event_transfers_path(@source_event) : nil %>

<% content_for :sidebar_footer do %>
  <% if !admin_signed_in? && current_user.disbursement_source_events.none? %>
    <p class="h5 muted">It looks like you don't have any organizations to transfer from. You need to be a manager of an organization to send a transfer.</p>
  <% end %>
<% end %>

<% content_for :table_of_contents do %>
  <%= render "events/transfers/step_item", number: 1, label: "Transfer type" %>
  <%= render "events/transfers/step_item", number: 2, label: "Organizations" %>
  <%= render "events/transfers/step_item", number: 3, label: "Details" %>
  <% if admin_signed_in? %>
    <%= render "events/transfers/step_item", number: 4, label: "Admin" %>
  <% end %>
<% end %>

<%= render "disbursements/form", disbursement: @disbursement, event: @event, source_event: @source_event, repaid_ledger_items: @repaid_ledger_items.to_a %>
