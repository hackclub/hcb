<% title "Send an HCB transfer" %>
<% @back_url = @source_event ? event_transfers_path(@source_event) : nil %>

<% content_for :sidebar_footer do %>
  <% if @source_event && @destination_event %>
    <% admin_tool("my-2 p-2 px-3") do %>
      Make a transfer from <%= @destination_event.name %> to <%= @source_event.name %>? <%= link_to "Click here", new_disbursement_path(event_id: @source_event.id, source_event_id: @destination_event.id) %>.
    <% end %>
  <% elsif @source_event %>
    <% admin_tool("my-2 p-2 px-3") do %>
      Looking to make a transfer to <%= @source_event.name %>? <%= link_to "Click here", new_disbursement_path(event_id: @source_event.id) %>.
    <% end %>
  <% elsif @destination_event %>
    <% admin_tool("my-2 p-2 px-3")  do %>
      Looking to make a transfer from <%= @destination_event.name %>? <%= link_to "Click here", new_disbursement_path(source_event_id: @destination_event.id) %>.
    <% end %>
  <% end %>
<% end %>

<% content_for :table_of_contents do %>
  <%= render "events/transfers/step_item", number: 1, label: "Transfer details" %>
  <%= render "events/transfers/step_item", number: 2, label: "Payment details" %>
  <% if auditor_signed_in? || admin_signed_in? %>
    <%= render "events/transfers/step_item", number: 3, label: "Admin" %>
  <% end %>
<% end %>

<%= render "disbursements/form", disbursement: @disbursement, event: @event, source_event: @source_event %>
