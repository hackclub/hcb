<div class="flex items-center justify-between gap-x-2 py-2 first:pt-0 last:pb-0">
  <span class="bold flex items-center gap-x-1 min-w-0">
    <% if webauthn_credential.platform? %>
      <%= inline_icon "fingerprint", size: home_action_size, class: "flex-shrink-0", style: "padding: 3px" %>
    <% else %>
      <%= inline_icon "private-outline", size: home_action_size, class: "flex-shrink-0" %>
    <% end %>

    <% if webauthn_credential.name.present? %>
      <span class="truncate"><%= webauthn_credential.name %></span>
    <% else %>
      <span class="secondary">No name</span>
    <% end %>
  </span>
  <span class="flex items-center gap-x-3 flex-shrink-0">
    <span class="muted h5">Added <%= format_date webauthn_credential.created_at %></span>
    <%= link_to user_webauthn_credential_path(webauthn_credential.user, webauthn_credential),
      data: { turbo_method: :delete },
      class: "muted tooltipped tooltipped--w z5",
      'aria-label': "Delete this security key",
      disabled: !policy(webauthn_credential).destroy? do %>
      <%= inline_icon "delete", size: home_action_size %>
    <% end %>
  </span>
</div>
