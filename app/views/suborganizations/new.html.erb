<% title "Sub-organizations of #{@event.name}" %>
<% page_sm %>
<%= render "events/nav", selected: :sub_organizations %>

<% if organizer_signed_in? %>
  <%= turbo_stream_from @event, :scoped_tags %>
<% end %>

<h1 class="heading flex">
  <span class="flex-grow">Create a sub-organization</span>
</h1>

<% if @argosy_grant_amount.present? %>
  <p>The contract for this Argosy suborganization will include a grant amount of <%= render_money @argosy_grant_amount %></p>
<% end %>

<%= render "suborganizations/form", event: @event, argosy_grant_amount: @argosy_grant_amount %>
