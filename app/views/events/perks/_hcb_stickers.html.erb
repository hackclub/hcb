<%# locals: (event:, perks_available:) %>

<div class="card mb3 pb0 <%= "muted" unless event.country_US? && perks_available %>" id="stickers">
  <div class="card__banner card__banner--top flex justify-between items-center promo-stickers">
    <span class="flex flex-row items-center">
      <h3 class="h1 white py-4 my0 card-title z-[1]">
        HCB Stickers
      </h3>
    </span>
    <% if perks_available && !event.country_US? %>
      <div class="actions tooltipped tooltipped--w inline-block mt0" aria-label="HCB stickers can only be shipped to 🇺🇸 US addresses.">
        <span class="btn disabled">Ineligible</span>
      </div>
    <% else %>
      <%= link_to "Request",
        perks_available ? fillout_form("umhwJ5s1fNus", { "Recipient Name" => current_user.name, "Login Email" => current_user.email, "Organization" => event.slug }, prefix: "prefill_") : root_path,
        class: "btn #{"disabled" unless perks_available}",
        target: :_blank %>
    <% end %>
  </div>

  <div class="mb0">
    <p><strong>Want some HCB stickers?</strong> You can request an envelope full of them for yourself! Every request is reviewed by the HCB team before it’s sent out.</p>
    <p><em><strong>With great power comes great responsibility...</strong></em></p>
    <p>Please enjoy responsibly. HCB operates at a loss that donors pay for, and stickers are not cheap—every package costs real donor money.</p>
  </div>

  <section class="card__banner card__darker secondary border-top">
    <p class="my0">
      HCB stickers can only be shipped to 🇺🇸 US addresses.
    </p>
  </section>
</div>
