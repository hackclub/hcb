<%# locals: (frame_id:, revealed: false, animated: false, tooltip_direction: :n) %>

<%# The account number isn't sent with the page. Clicking the eye asks for it as a turbo stream, which fills in
    this frame and its twin (the account number page shows one inline and one in the modal), like a card's number and CVC. %>
<%= turbo_frame_tag frame_id, class: "inline-flex items-center gap-2 fs-mask" do %>
  <% if revealed %>
    <%= copy_to_clipboard @event.account_number, tooltip_direction:, class: "font-mono" do %>
      <%= tag.span @event.account_number, data: { controller: ("reveal-animation" if animated) } %>
    <% end %>
  <% else %>
    <span class="font-mono muted"><%= "•" * @event.account_number.length %></span>
  <% end %>
  <%= link_to reveal_account_number_event_path(@event, show_details: (!revealed).to_s),
              class: "inline-flex text-muted hover:text-blue tooltipped tooltipped--#{tooltip_direction}",
              "aria-label": revealed ? "Hide account number" : "Show account number",
              data: { turbo_stream: true, turbo_prefetch: false } do %>
    <%= inline_icon revealed ? "view-fill" : "view", size: 24 %>
  <% end %>
<% end %>
