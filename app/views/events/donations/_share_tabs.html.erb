<%# locals: () %>
<%# herb:slots client %>
<%# herb:state (selected_tab: "link") %>
<%# The donation page's Share modal. jquery-modal moves the modal's <section> to the end of <body>,
    so the state lives in this partial, inside the section. %>

<div data-controller="qr-code">
  <header class="pb-8">
    <%= modal_close %>
    <h2 class="mt-0 mb-4">Share</h2>
    <div class="flex -mx-[35px] px-[23px] sm:-mb-3">
      <button type="button" class="filter-tab bordered h-10 !rounded-t-lg" aria-current="<%= selected_tab == "link" %>" data-herb-set="selected_tab=link">Link</button>
      <button type="button" class="filter-tab bordered h-10 !rounded-t-lg" aria-current="<%= selected_tab == "qr" %>" data-herb-set="selected_tab=qr">QR code</button>
      <% if @event.is_public? %>
        <button type="button" class="filter-tab bordered h-10 !rounded-t-lg" aria-current="<%= selected_tab == "donor_graph" %>" data-herb-set="selected_tab=donor_graph">Donor&nbsp;graph</button>
      <% end %>
      <button type="button" class="filter-tab bordered h-10 !rounded-t-lg" aria-current="<%= selected_tab == "embed" %>" data-herb-set="selected_tab=embed">Embed</button>
    </div>
  </header>

  <div hidden="<%= selected_tab != "link" %>">
    <%= react_component "donation_overview/PreviewLink", path: start_donation_donations_url(@event) %>
  </div>
  <div hidden="<%= selected_tab != "qr" %>">
    <div class="flex flex-wrap flex-col sm:flex-row gap-4">
      <div class="flex-1">
        <div class="bg-white rounded-2xl w-fit h-fit cursor-pointer border border-muted *:w-52 *:h-52 *:hidden" data-action="click->qr-code#download" style="padding-top: 4.5px; padding-left: 4.5px;">
          <qr-code
            contents='<%= start_donation_donations_url @event %>'
            id="qrCode--icon">
            <img
              src="https://icons.hackclub.com/api/icons/black/bank-account"
              class="h-12 -translate-x-[5.5px]"
              slot="icon">
          </qr-code>
          <qr-code
            contents='<%= start_donation_donations_url @event %>'
            id="qrCode--support">
            <img
              src="https://icons.hackclub.com/api/icons/black/support"
              class="h-12 -translate-x-[5.5px]"
              slot="icon">
          </qr-code>
          <% if @event.logo.attached? %>
            <qr-code
              contents='<%= start_donation_donations_url @event %>'
              id="qrCode--logo">
              <%= image_tag "data:#{@event.logo.blob.content_type};base64," + @event.logo.open { |file| Base64.encode64(file.read) }, slot: "icon", class: "rounded", style: "height: 36px;" %>
            </qr-code>
          <% end %>
          <qr-code
            contents='<%= start_donation_donations_url @event %>'
            id="qrCode--bank">
            <%= image_tag "logo-production.svg", slot: "icon", class: "rounded", style: "height: 36px;" %>
          </qr-code>
          <qr-code
            contents='<%= start_donation_donations_url @event %>'
            id="qrCode--bank-dark">
            <%= image_tag "logo-production-dark.svg", slot: "icon", class: "rounded", style: "height: 36px;" %>
          </qr-code>
          <qr-code
            contents='<%= start_donation_donations_url @event %>'
            class="!block"
            id="qrCode--blank" />
        </div>
      </div>
      <div class="flex-1">
        <div class="w-full iconsGrid grid grid-cols-5 sm:grid-cols-3 gap-2 w-fit *:p-2 *:sm:p-4 *:aspect-square *:w-full *:rounded-xl *:cursor-pointer">
          <%= inline_icon "view-close", size: 56, class: "btn h-auto", "data-action": "click->qr-code#change", "data-qr-code-id-param": "blank" %>
          <%= inline_icon "bank-account", size: 56, class: "btn h-auto", "data-action": "click->qr-code#change", "data-qr-code-id-param": "icon" %>
          <%= inline_icon "support", size: 56, class: "btn h-auto", "data-action": "click->qr-code#change", "data-qr-code-id-param": "support" %>
          <% if @event.logo.attached? %>
            <%= image_tag @event.logo, slot: "icon", class: "btn h-auto", data: { action: "click->qr-code#change", "qr-code-id-param": "logo" } %>
          <% end %>
          <%= image_tag "logo-production.svg", slot: "icon", class: "btn h-full", data: { action: "click->qr-code#change", "qr-code-id-param": "bank" } %>
          <%= image_tag "logo-production-dark.svg", slot: "icon", class: "btn h-full", data: { action: "click->qr-code#change", "qr-code-id-param": "bank-dark" } %>
        </div>
        <button class="btn mt-2 w-full" data-action="click->qr-code#download" data-qr-code-target="downloadButton" id="downloadButton">Download</button>
      </div>
    </div>
  </div>
  <div hidden="<%= selected_tab != "donor_graph" %>" class="flex gap-4 flex-col sm:flex-row">
    <div class="flex-1">
      <p class="mt0">Use this image URL to show a donor graph on your website, GitHub repo, or anywhere in between.</p>
      <pre class="bg-gray-200 dark:bg-gray-700 select-all">https://graph.hcb.hackclub.com/<%= @event.slug %></pre>
      <pre class="bg-gray-200 dark:bg-gray-700 select-all"><%= html_escape(%(<img src="https://graph.hcb.hackclub.com/#{@event.slug}" alt="Donor graph for #{@event.name}">)) %></pre>

      <p class="muted text-sm">
        To use additional styling and image options,
        <%= link_to "check out the docs", "https://graph.hcb.hackclub.com", target: "_blank" %>
        for more info.
      </p>
    </div>

    <div>
      <img src="https://graph.hcb.hackclub.com/<%= @event.slug %>" style="width: 250px;height:auto">
    </div>
  </div>
  <div hidden="<%= selected_tab != "embed" %>">
    <p class="mt0">Paste this HTML code into your website to embed your donation page. Feel free to change the styling.</p>
    <pre class="bg-gray-200 dark:bg-gray-700 select-all"><%= html_escape "<iframe src='#{start_donation_donations_url @event}' style='border:none;' name='donateFrame' scrolling='yes' frameborder='0' marginheight='0px' marginwidth='0px' height='512px' width='512px' allowfullscreen></iframe>".gsub("'", '"') %></pre>
  </div>
</div>
