<%# locals: (is_blankslate: false) %>

<button type="button" class="pop" data-behavior="modal_trigger" data-modal="share_donation_page"><%= inline_icon "share", size: 28 %></button>
<a href="<%= start_donation_donations_url(@event) %>" class="btn bg-success gap-2 <%= is_blankslate ? "w-full" : "ml-2" %>" target="_blank">
  Donation page
  <%= inline_icon "external", class: "!m-0" %>
</a>

<section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="share_donation_page">
  <%= render "events/donations/share_tabs" %>
</section>
