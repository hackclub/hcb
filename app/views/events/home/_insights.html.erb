<%# locals: (event:) %>

<%# The timeframe links navigate this frame, so the server re-renders the label and the charts' sources without moving the page. %>
<%# For those requests `EventsController#show` renders this partial alone. %>
<% timeframes = BreakdownEngine.timeframes_for(event) %>
<% timeframe = params[:timeframe].presence_in(timeframes - ["All time"]) %>
<%= turbo_frame_tag "insights", class: "contents" do %>
  <div class="flex justify-between items-center mb-2 mt-10">
    <h2 class="my-0 px-0">Insights</h2>
    <% if timeframes.size > 1 %>
      <div data-controller="menu" data-menu-append-to-value="#tags-chart">
        <button
          class="whitespace-nowrap homepage-eyebrow my-0 border-0 bg-transparent flex items-center cursor-pointer"
          data-action="menu#toggle click@document->menu#close keydown@document->menu#keydown"
          data-menu-target="toggle">
          <span><%= timeframe || "All time" %></span>
          <%= inline_icon "down-caret", size: 20 %>
        </button>
        <div class="menu__content menu__content--2 menu__content--compact h5 -mt-2 ml-1" data-menu-target="content">
          <% timeframes.each do |option| %>
            <%= link_to option, event_path(event, timeframe: (option unless option == "All time")), data: { turbo_frame: "insights", action: "click->menu#close" } %>
          <% end %>
        </div>
      </div>
    <% else %>
      <h5 class="homepage-eyebrow mt0 mb0">All&nbsp;time</h5>
    <% end %>
  </div>

  <%= turbo_frame_tag "money_flow", src: event_money_flow_chart_path(event, timeframe:), loading: "lazy", target: "_top", class: "empty:hidden card card--breakdown w-100 mb-4" do %>
    <div class="p-0 min-h-96 text-center flex-1 flex flex-col items-center justify-center" style="flex: 1">
      <%= render partial: "application/loading_container" %>
    </div>
  <% end %>

  <div class="homepage-row">
    <%= turbo_frame_tag "merchants", src: event_merchants_chart_path(event, timeframe:), loading: "lazy", class: "empty:hidden card card--breakdown w-100 mb-4" do %>
      <div class="p-0 min-h-96 text-center flex-1 flex flex-col items-center justify-center" style="flex: 1">
        <%= render partial: "application/loading_container" %>
      </div>
    <% end %>
    <%= turbo_frame_tag "categories", src: event_categories_chart_path(event, timeframe:), loading: "lazy", class: "empty:hidden card card--breakdown w-100 mb-4" do %>
      <div class="p-0 min-h-96 text-center flex-1 flex flex-col items-center justify-center" style="flex: 1">
        <%= render partial: "application/loading_container" %>
      </div>
    <% end %>
  </div>

  <div class="homepage-row">
    <%= turbo_frame_tag "tags", src: event_tags_chart_path(event, timeframe:), loading: "lazy", class: "empty:hidden card card--breakdown w-100 mb-4" do %>
      <div class="p-0 min-h-96 text-center flex-1 flex flex-col items-center justify-center" style="flex: 1">
        <%= render partial: "application/loading_container" %>
      </div>
    <% end %>
    <%= turbo_frame_tag "users", src: event_users_chart_path(event, timeframe:), loading: "lazy", class: "empty:hidden card card--breakdown w-100 mb-4" do %>
      <div class="p-0 min-h-96 text-center flex-1 flex flex-col items-center justify-center" style="flex: 1">
        <%= render partial: "application/loading_container" %>
      </div>
    <% end %>
  </div>
<% end %>
