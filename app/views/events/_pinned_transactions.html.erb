<% @show_popovers = popovers_enabled? && organizer_signed_in? %>
<% if @event.pinned_ledger_items.any? %>
  <div class="flex gap-4 my-2 pinned__container">
    <% @event.pinned_ledger_items.each do |ledger_item| %>
      <% hcb_code = ledger_item.hcb_code %>
      <%= link_to organizer_signed_in? ? hcb_code : "#", data: @show_popovers ? hcb_code_popover_data(hcb_code.local_hcb_code) : {}, class: "pinned__transaction relative card card-outlined flex flex-col black" do %>
        <% if organizer_signed_in? %>
          <%= form_for(
                ledger_item,
                url: unpin_ledger_item_path(ledger_item),
                method: :post,
                data: { turbo_confirm: "This will unpin the transaction for all team members. Continue?" }
              ) do |form| %>
            <%= form.button(
                  type: "submit",
                  class: "pinned__transaction__pin pointer pop tooltipped tooltipped--w",
                  aria: { label: "Unpin" },
                  style: "margin-left: auto",
                  onclick: "event.stopPropagation()"
                ) do %>
              <%= inline_icon "pin-remove", size: 28 %>
            <% end %>
          <% end %>
        <% end %>

        <p class="font-bold m0 flex items-center g2">
          <%= format_date ledger_item.datetime %>
          <%# TODO: extract to partial %>
          <% unless ledger_item.settled? %>
            <%= badge_for ledger_item.status_text, class: ledger_item.status_css %>
          <% end %>
        </p>
        <p class="pinned__transaction__text pinned__transaction__text--memo mt1 mb1 leading-[1.25] h3">
          <%= ledger_item.memo %>
        </p>
        <footer class="flex items-center justify-between -mb-1 gap-2 w-full">
          <span class="m0 muted">
            <%= render_money ledger_item.amount_cents %>
          </span>
          <%# TODO: extract to partial %>
          <% if ledger_item.icon.is_a?(YellowPages::Merchant) %>
            <%= merchant_icon(ledger_item.icon, style: "height: 1.2em") %>
          <% else %>
            <%= inline_icon(ledger_item.icon, size: 32) %>
          <% end %>
        </footer>
      <% end %>
    <% end %>
  </div>
<% end %>
