<% cache_if @cacheable, "#{@event.id}_ledger", expires_in: 5.minutes, race_condition_ttl: 1.minute do %>
  <%= turbo_frame_tag [dom_id(@event), :ledger] do %>
    <%= render partial: "events/filters/filter", locals: { event: @event, filter_category: @category, filter_direction: @direction, filter_end_date: @end_date, filter_maximum_amount: @maximum_amount, filter_merchant: @merchant, filter_merchant_name: @merchant_name, filter_minimum_amount: @minimum_amount, filter_missing_receipts: @missing_receipts, filter_order_by: @order_by, filter_start_date: @start_date, filter_tag: @tag, filter_type: @type, filter_user: @user, ledger_filters_disabled: @ledger_filters_disabled, show_running_balance: @show_running_balance, subledger: @subledger, users: @users } %>
    <% if @pending_transactions.any? || @transactions.any? %>
      <div class="table-container mt-4" data-tour-step="transactions">
        <table>
          <thead>
          <tr>
            <th><%# icon %></th>
            <th>Date</th>
            <th>Description</th>
            <th class="text-right">Amount</th>
            <% if @show_running_balance %>
              <th>Running Balance</th>
            <% end %>
            <th><%# user avatar %></th>
          </tr>
          </thead>
          <tbody data-behavior="transactions">
          <%= render "events/pending_fee_transaction", direction: @direction, event: @event, show_running_balance: @show_running_balance, subledger: @subledger %>

          <%= render partial: "canonical_pending_transactions/canonical_pending_transaction", collection: @pending_transactions, as: :pt, locals: { selectable: @event.tags.any?, show_author_column: true, show_tags: true, card_grant: @card_grant, force_no_popover: @force_no_popover, frame: @frame, page_event: @event, show_running_balance: @show_running_balance } %>

          <%= render partial: "canonical_transactions/canonical_transaction", collection: @transactions, as: :ct, locals: { selectable: @event.tags.any?, show_author_column: true, show_tags: true, card_grant: @card_grant, force_no_popover: @force_no_popover, frame: @frame, page_event: @event, show_running_balance: @show_running_balance } %>
          </tbody>
        </table>
      </div>
      <%= paginate @transactions %>
    <% else %>
      <%= blankslate "No transactions yet" %>
    <% end %>

    <%#
      We are unable to use turbo frame's action='advance' to update the url and
      browser history since it's attempt to set the URL to this frame's. So, i'm
      manually doing it here.
    %>
    <% unless @subledger %>
      <script>
        window.history.pushState(null, '', <%= event_transactions_url(@event, **params.except(:action, :controller, :event_id).to_unsafe_h).to_s.to_json.html_safe %>);
      </script>
    <% end %>
  <% end %>
<% end %>
