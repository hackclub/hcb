<% title "Account number for #{@event.name}" %>
<% page_md %>
<%= render "events/nav", selected: :account_number %>
<%= render "events/account_number_modal" unless @event.demo_mode? %>

<h1 class="heading items-center">
  <div class="flex flex-col justify-center">
    <span class="flex items-center flex-grow">
      Account & routing number
    </span>
    <h4 class="mt1 mb1 muted medium center">Connect your HCB account to GoFundMe, Shopify, Venmo, and more.</h4>
  </div>
  <% unless @event.demo_mode? %>
    <a href="#" data-modal="account_number" class="btn">
      <%= inline_icon "bank-account" %>
      Account details
    </a>
  <% end %>
</h1>

<% if @event.demo_mode? %>
  <%= blankslate "Unavailable in Playground Mode" %>
<% else %>
  <%# Right after the account number is generated without JavaScript, the page shows it revealed. %>
  <%= render "events/account_number_details", revealed: @animated, animated: @animated %>
<% end %>

<% if @event.column_account_number.present? %>
  <% if @show_transfer_callout %>
    <%= render "application/callout", type: "info", title: "Starting May 21st, 2026, this page only shows direct #{@event.column_account_number.deposit_only? ? "credits" : "debits and credits"}.", class: "mt-2 mb-3" do %>
      <% if Flipper.enabled?(:payments_contractors_refresh_2026_06_26, @event) %>
        Your previous payments can still be viewed on the <%= link_to "Payments", event_payments_path(@event) %> page.
      <% else %>
        Your previous transfers can still be viewed on the <%= link_to "Transfers", event_transfers_path(@event) %> page.
      <% end %>
    <% end %>
  <% end %>

  <%= render "ledgers/ledger", ledger: @ledger, items: @ledger_items, show_author: false %>
<% elsif !@event.demo_mode? %>
  <%= blankslate "No transactions yet" %>
<% end %>
