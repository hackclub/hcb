<%# locals: (form:, klass: "my-2", initial_query: params[:q].to_s) %>
<%# herb:slots client %>
<%# herb:state (selected_q: initial_query, applied_q: initial_query) %>

<div class="input <%= klass %> input-group max-w-none h-[36px]" tabindex="0" data-controller="search-submit" data-action="turbo:before-cache@document->search-submit#unmarkBusy">
  <%= inline_icon "search" %>
  <%= form.text_field :q, placeholder: "Type / to search...", class: "bg-transparent", data: { behavior: "search", herb_set: "selected_q=$value" }, value: params[:q] %>
  <% if params[:q].present? %>
    <%= link_to upsert_query_params(q: nil), class: "pop muted w-7 h-7 tooltipped tooltipped--s form-busy:hidden", "aria-label": "Clear search", data: { action: "turbo:click->search-submit#markBusy" } do %>
      <%= inline_icon "view-close", size: 24 %>
    <% end %>
  <% end %>
  <%# Only offered once the query differs from the one the page is showing. %>
  <button type="submit" class="pop muted w-7 h-7 tooltipped tooltipped--s -mr-1 form-busy:hidden" aria-label="Search" hidden="<%= selected_q == applied_q %>">
    <%= inline_icon "enter", size: 24 %>
  </button>
  <%= inline_icon "loading", size: 28, class: "hidden form-busy:block p-1 -mr-1 !text-inherit" %>
</div>
