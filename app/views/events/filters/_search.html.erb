<%# locals: (form:, klass: "my-2", initial_query: params[:q].to_s) %>
<%# herb:slots client %>
<%# herb:state (selected_q: initial_query, applied_q: initial_query, searching: false) %>

<%# `searching` swaps the actions for a spinner while the next page loads; reset before Turbo caches so going back doesn't restore a stuck spinner. %>
<div class="input <%= klass %> input-group max-w-none h-[36px]" tabindex="0" data-herb-set="turbo:before-cache@document->searching=false">
  <%= inline_icon "search" %>
  <%= form.text_field :q, placeholder: "Type / to search...", class: "bg-transparent", data: { behavior: "search", herb_set: "selected_q=$value keydown.enter->searching=true" }, value: params[:q] %>
  <% if params[:q].present? %>
    <a href="<%= url_for(upsert_query_params(q: nil)) %>" class="pop muted w-7 h-7 tooltipped tooltipped--s" aria-label="Clear search" hidden="<%= searching %>" data-herb-set="searching=true">
      <%= inline_icon "view-close", size: 24 %>
    </a>
  <% end %>
  <%# Only offered once the query differs from the one the page is showing. %>
  <button type="submit" class="pop muted w-7 h-7 tooltipped tooltipped--s -mr-1" aria-label="Search" hidden="<%= searching || selected_q == applied_q %>" data-herb-set="searching=true">
    <%= inline_icon "enter", size: 24 %>
  </button>
  <span class="p-1 -mr-1" hidden="<%= !searching %>"><%= inline_icon "loading", size: 28 %></span>
</div>
