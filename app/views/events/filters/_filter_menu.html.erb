<%# locals: () %>

<% ledger_turbo_frame_id = "#{dom_id(@event)}_ledger" %>
<% tags = @event.tags.order(label: :asc) %>

<div data-controller="menu" data-menu-append-to-value="turbo-frame#<%= ledger_turbo_frame_id %>" data-menu-placement-value="bottom-start" class="-mb-1">
  <button
    type="button"
    aria-label="Add filter"
    class="tooltipped tooltipped--s pop menu__toggle menu__toggle--arrowless overflow-visible"
    data-menu-target="toggle" data-action="menu#toggle click@document->menu#close keydown@document->menu#keydown">
    <%= inline_icon "filter", size: 28 %>
  </button>
  <div class="menu__content menu__content--2 menu__content--compact h5 w-[350px] h-[400px] p-0" data-menu-target="content">
    <%= render "events/filters/filter_tabs", tags:, initial_tab: @tag ? "tags" : @user ? "user" : @type ? "type" : @start_date || @end_date ? "date" : @maximum_amount || @minimum_amount ? "amount" : tags.length > 0 ? "tags" : "user" %>
  </div>
</div>
