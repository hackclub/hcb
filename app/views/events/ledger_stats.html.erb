<%= turbo_frame_tag "event_stats" do %>
  <div class="statset mb-2">
    <div class="stat">
      <span class="stat__label">Account balance</span>
      <%# this event has a fee credit (owes negative fees) %>
      <% if @ledger.fee_balance_cents.negative? %>
        <span class="stat__value stat__value--no-space"><%= render_money_amount @ledger.balance_cents %></span>
        <span class="self-end" style="font-size: 10px;">+$<%= render_money_amount @ledger.fee_balance_cents.abs %>
          fee credit</span>
      <% else %>
        <span class="stat__value stat__value--no-space">
          <%= render_money_amount(@ledger.available_balance_cents) %>
        </span>
      <% end %>
    </div>

    <div class="stat stat--small tooltipped tooltipped--s" aria-label="May differ slightly from the classic ledger's total revenue. Your total account balance is unaffected.">
      <span class="stat__label flex items-center">
        Total revenue
        <%= inline_icon "info", size: 24, class: "ml1", 'aria-label': "Info icon" %>
      </span>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(@ledger.items.where("amount_cents > 0").sum(:amount_cents)) %>
      </span>
    </div>

    <div class="stat stat--small tooltipped tooltipped--s" aria-label="May differ slightly from the classic ledger's total expenses. Your total account balance is unaffected.">
      <span class="stat__label flex items-center">
        Total expenses
        <%= inline_icon "info", size: 24, class: "ml1", 'aria-label': "Info icon" %>
      </span>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(@ledger.items.where("amount_cents < 0").sum(:amount_cents).abs) %>
      </span>
    </div>
  </div>
<% end %>
