<%# locals: (event: nil) %>

<section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="send_transfer">
  <%= turbo_frame_tag :transfer_form do %>
    <%= modal_header "Transfer money" %>

    <%= render partial: "events/unauthorized_callout", locals: { action: "transfer money", event: event } unless policy(event).create_transfer? %>

    <%= render "events/transfers/form", event: event %>
  <% end %>
</section>
