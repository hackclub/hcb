<%# locals: () %>
<%# herb:slots client %>
<%# herb:state (selected_step: "home") %>

<%= form_with(local: true) do |form| %>
  <div>
    <div hidden="<%= selected_step != "home" %>">
      <fieldset>
        <legend class="heading h2 pb2">What type of transfer?</legend>
        <div class="field field--options fit">
          <%= link_to new_event_ach_transfer_path(@event), class: "text-decoration-none btn--form-option", data: { turbo_frame: "_top" } do %>
            <%= inline_icon "payment-transfer", size: 28 %>
            <strong>ACH transfer</strong>
            <small>United States</small>
          <% end %>
          <%= link_to new_event_increase_check_path(@event), class: "text-decoration-none btn--form-option", data: { turbo_frame: "_top" } do %>
            <%= inline_icon "email", size: 28 %>
            <strong>Mailed check</strong>
            <small>United States</small>
          <% end %>
          <%= link_to new_event_wise_transfer_path(@event), class: "text-decoration-none btn--form-option relative overflow-hidden", data: { turbo_frame: "_top" }, disabled: true do %>
            <%= inline_icon "wise", size: 28 %>
            <strong>Wise transfer</strong>
            <small>International</small>
          <% end %>
          <%= link_to new_event_wire_path(@event), class: "text-decoration-none btn--form-option relative overflow-hidden", data: { turbo_frame: "_top" } do %>
            <%= inline_icon "web", size: 28 %>
            <div class="badge badge--corner bg-info m1 mt0" style="width: fit-content;">$500 minimum</div>
            <strong>Wire transfer</strong>
            <small>International</small>
          <% end %>
          <%= link_to new_disbursement_path(source_event_id: @event), class: "text-decoration-none btn--form-option", data: { turbo_frame: "_top" } do %>
            <%= inline_icon "bank-account", size: 28 %>
            <strong>HCB transfer</strong>
            <small>Any HCB organization</small>
          <% end %>
          <% if @event.plan.card_grants_enabled? %>
            <%= link_to new_event_card_grant_path(@event), class: "text-decoration-none btn--form-option", data: { turbo_frame: "_top", behavior: "modal_trigger", modal: "create_card_grant" } do %>
              <%= inline_icon "card", size: 28 %>
              <strong>Card grant</strong>
              <small>A grant sent through HCB</small>
            <% end %>
          <% end %>
        </div>
      </fieldset>
      <a class="w-full text-center block no-underline -mb-2 pointer" role="button" tabindex="0" data-herb-set="click->selected_step=q1 keydown.return->selected_step=q1">Which method should I use? <strong>Help me decide &rarr;</strong></a>
    </div>

    <div hidden="<%= selected_step == "home" %>">
      <a class="no-underline text-xs inline-flex items-center -ml-2 pointer" role="button" tabindex="0" data-herb-set="click->selected_step=home keydown.return->selected_step=home">
        <%= inline_icon "view-back" %>
        Exit
      </a>
    </div>

    <%# Help me decide: each answer moves to the next question or to a recommendation. %>
    <div hidden="<%= selected_step != "q1" %>">
      <p class="eyebrow mb-0">Help me decide</p>
      <h3 class="mt-2 font-bold mb-4">Does your recipient live within the US?</h3>
      <%= render "events/transfers/wizard_answers", yes: "q2", no: "q3" %>
    </div>
    <div hidden="<%= selected_step != "q2" %>">
      <p class="eyebrow mb-0">Help me decide</p>
      <h3 class="mt-2 font-bold mb-4">Do you have their account & routing number?</h3>
      <%= render "events/transfers/wizard_answers", yes: "ach", no: "check" %>
    </div>
    <div hidden="<%= selected_step != "q3" %>">
      <p class="eyebrow mb-0">Help me decide</p>
      <h3 class="mt-2 font-bold mb-4">Is your transfer amount over $500?</h3>
      <%= render "events/transfers/wizard_answers", yes: "wire", no: "wise" %>
    </div>

    <div hidden="<%= selected_step != "ach" %>">
      <%= render "events/transfers/recommendation", title: "ACH transfer", path: new_event_ach_transfer_path(@event), help: "https://help.hcb.hackclub.com/en/articles/15410090-how-do-i-send-an-ach-transfer" %>
    </div>
    <div hidden="<%= selected_step != "check" %>">
      <%= render "events/transfers/recommendation", title: "Mailed check", path: new_event_increase_check_path(@event), help: "https://help.hcb.hackclub.com/en/articles/15410094-how-do-i-send-a-check" %>
    </div>
    <div hidden="<%= selected_step != "wire" %>">
      <%= render "events/transfers/recommendation", title: "International wire", path: new_event_wire_path(@event), help: "https://help.hcb.hackclub.com/en/articles/15410092-how-do-i-send-a-wire-transfer" %>
    </div>
    <div hidden="<%= selected_step != "wise" %>">
      <%= render "events/transfers/recommendation", title: "Wise transfer", path: new_event_wise_transfer_path(@event), help: "https://help.hcb.hackclub.com/en/articles/15410093-how-do-i-send-a-wise-transfer" do %>
        <div style="font-weight: normal" class="mb-4">
          <strong>Note:</strong>
          Wise does <strong>not</strong> support these currencies:
          <ul>
            <% WiseTransfer.unsupported_currencies_supported_by_wire.excluding("USD").each do |currency_code| %>
              <li><%= currency_code %></li>
            <% end %>
          </ul>
          If you need to send to one of these currencies, <strong>please select "International wire" instead.</strong>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
