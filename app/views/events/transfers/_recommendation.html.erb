<%# locals: (title:, path:, help:) %>
<%# herb:slots client %>
<%# herb:state (selected_step: "home") %>

<p class="eyebrow pt-0 mb-0">Our recommendation</p>
<h3 class="mt-2 font-bold mb-2 capitalize"><%= title %></h3>
<%= yield %>
<%= link_to "Learn more →", help, class: "mb-3 inline-block no-underline", target: "_blank" %>
<div class="flex gap-2">
  <%= link_to path, class: "btn bg-primary shadow-none", data: { turbo_frame: "_top" } do %>
    Let's do it!
    <%= inline_icon "view-forward", style: "margin-right: -5px;margin-left: 5px" %>
  <% end %>
  <button type="button" class="btn bg-muted shadow-none" data-herb-set="selected_step=q1">
    Reset
    <%= inline_icon "view-reload", style: "margin-right: -5px;margin-left: 5px" %>
  </button>
</div>
