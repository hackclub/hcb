<% title "Transactions for #{@event.name}" %>

<%= render "events/nav", selected: :transactions %>

<%= render "events/heading", event: @event, new_ledger_active: true, show_ledger_toggle: true do %>
  <span class="flex-grow">Transactions</span>
<% end %>

<%= turbo_frame_tag "event_stats", src: event_stats_path(@event) do %>
  <div class="statset mb-2">
    <div class="stat">
      <span class="stat__label">Account balance</span>
      <span class="stat__value stat__value--no-space">
        —
      </span>
    </div>

    <div class="stat stat--small">
      <span class="stat__label">Total revenue</span>
      <span class="stat__value stat__value--no-space">
        —
      </span>
    </div>

    <div class="stat stat--small">
      <span class="stat__label">Total expenses</span>
      <span class="stat__value stat__value--no-space">
        —
      </span>
    </div>
  </div>
<% end %>

<%= render "callout", type: "info", title: "You're previewing the new ledger", footer: :questions, klass: "mt-0" do %>
  HCB is working on a faster ledger to improve your experience. If you have any feedback, send it our way!
<% end %>

<%= render "events/public_message", event: @ledger.event %>

<%= render "ledgers/pinned_items", event: @ledger.event %>

<%= render "ledgers/ledger", ledger: @ledger, items: @items, table_only: true, filter: capture { render partial: "ledgers/filters/filter", locals: { event: @event, filter_category: @category, filter_direction: @direction, filter_end_date: @end_date, filter_maximum_amount: @maximum_amount, filter_merchant: @merchant, filter_merchant_name: @merchant_name, filter_minimum_amount: @minimum_amount, filter_missing_receipts: @missing_receipts, filter_order_by: @order_by, filter_start_date: @start_date, filter_tag: @tag, filter_type: @type, filter_user: @user, ledger_filters_disabled: @ledger_filters_disabled, show_running_balance: @show_running_balance, use_card_grant_ledgers: @use_card_grant_ledgers, users: @users } }, show_fee: true %>
