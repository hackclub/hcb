<%# locals: (affiliation:, form:) %>

<% disabled = !policy(affiliation).update? %>

<fieldset class="field">
  <legend class="font-medium">Type</legend>
  <p class="h5 muted mt-0 mb-3">
    Which organization are you affiliated with, if any? Leave blank if none of these apply.
  </p>
  <div class="field field--options field--green trio mb-0">
    <%= form.radio_button :type, :first, disabled:, data: { conditional_fields_key: "type", action: "change->conditional-fields#update" } %>
    <%= form.label :type, value: :first do %>
      <%= inline_icon "sam", size: 28 %>
      <strong>FIRST Robotics</strong>
    <% end %>
    <%= form.radio_button :type, :vex, disabled:, data: { conditional_fields_key: "type", action: "change->conditional-fields#update" } %>
    <%= form.label :type, value: :vex do %>
      <%= inline_icon "sam", size: 32 %>
      <strong>VEX Robotics</strong>
    <% end %>
    <%= form.radio_button :type, :hack_club, disabled:, data: { conditional_fields_key: "type", action: "change->conditional-fields#update" } %>
    <%= form.label :type, value: :hack_club do %>
      <%= inline_icon "clubs-fill", size: 28 %>
      <strong>Hack Club</strong>
    <% end %>
  </div>
</fieldset>

<template data-conditional-fields-when='[{"key":"type","in":["first"]}]'>
  <div class="field">
    <%= form.label :league, "League" %>
    <%= form.select :league, [["FRC", "frc"], ["FTC", "ftc"], ["FLL", "fll"]], { required: true, include_blank: "Select a league", selected: affiliation.league }, disabled: %>
  </div>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["first"]}]'>
  <div class="field">
    <%= form.label :team_number, "Team number" %>
    <%= form.text_field :team_number, { required: true, placeholder: "9101", value: affiliation.team_number, disabled: } %>
  </div>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["first"]}]'>
  <div class="field">
    <%= form.label :size, "Size" %>
    <div class="flex items-center" data-controller="pluralize" data-pluralize-singular-value="person" data-pluralize-plural-value="people">
      <div class="input flex gap-2 items-center justify-between py-0">
        <%= form.number_field :size, placeholder: "10", step: 1, min: 0, required: true, class: "!p-0 !border-none !shadow-none min-h-auto", disabled:, data: { pluralize_target: "input", action: "input->pluralize#update" } %>
        <span class="bold muted" data-pluralize-target="label">people</span>
      </div>
    </div>
  </div>
</template>

<template data-conditional-fields-when='[{"key":"type","in":["vex"]}]'>
  <div class="field">
    <%= form.label :league, "League" %>
    <%= form.select :league, [["123", "123"], ["GO", "go"], ["AIM", "aim"], ["IQ", "iq"], ["EXP", "exp"], ["V5", "v5"], ["CTE", "cte"], ["AIR", "air"]], { required: true, include_blank: "Select a league", selected: affiliation.league }, disabled: %>
  </div>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["vex"]}]'>
  <div class="field">
    <%= form.label :team_number, "Team number" %>
    <%= form.text_field :team_number, { required: true, placeholder: "11981B", value: affiliation.team_number, disabled: } %>
  </div>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["vex"]}]'>
  <div class="field">
    <%= form.label :size, "Size" %>
    <div class="flex items-center" data-controller="pluralize" data-pluralize-singular-value="person" data-pluralize-plural-value="people">
      <div class="input flex gap-2 items-center justify-between py-0">
        <%= form.number_field :size, placeholder: "10", step: 1, min: 0, required: true, class: "!p-0 !border-none !shadow-none min-h-auto", disabled:, data: { pluralize_target: "input", action: "input->pluralize#update" } %>
        <span class="bold muted" data-pluralize-target="label">people</span>
      </div>
    </div>
  </div>
</template>

<template data-conditional-fields-when='[{"key":"type","in":["hack_club"]}]'>
  <p class="p-0 text-sm">
    Select this only if you're a local Hack Club chapter.
    <% if affiliation.affiliable.is_a?(Event::Application) %>
      If you're running an official project for Hack Club HQ, don't use this application form.
    <% end %>
  </p>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["hack_club"]}]'>
  <div class="field">
    <%= form.label :venue_name, "Venue name" %>
    <%= form.text_field :venue_name, { required: true, placeholder: "Pierson Library", value: affiliation.venue_name, disabled: } %>
  </div>
</template>
<template data-conditional-fields-when='[{"key":"type","in":["hack_club"]}]'>
  <div class="field">
    <%= form.label :size, "Size" %>
    <div class="flex items-center" data-controller="pluralize" data-pluralize-singular-value="person" data-pluralize-plural-value="people">
      <div class="input flex gap-2 items-center justify-between py-0">
        <%= form.number_field :size, placeholder: "10", step: 1, min: 0, required: true, class: "!p-0 !border-none !shadow-none min-h-auto", disabled:, data: { pluralize_target: "input", action: "input->pluralize#update" } %>
        <span class="bold muted" data-pluralize-target="label">people</span>
      </div>
    </div>
  </div>
</template>

<% if affiliation.new_record? %>
  <div class="flex flex-row items-center justify-between" data-conditional-fields-when='[{"key":"type","present":true}]'>
    <%= form.submit "Save affiliation", disabled: %>
    <button type="button" class="btn btn-secondary" <%= "disabled" if disabled %> data-action="conditional-fields#assign" data-conditional-fields-assign-key-param="type" data-conditional-fields-assign-value-param="">Cancel</button>
  </div>
<% else %>
  <% if disabled %>
    <%= form.submit "Update", disabled: true %>
  <% else %>
    <%= form.submit "Update", data: { conditional_fields_disable: [{ key: "type", blank: true }].to_json } %>
  <% end %>
<% end %>
