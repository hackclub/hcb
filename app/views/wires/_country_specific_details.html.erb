<%# locals: (form:, disabled:, required: true, excluded_fields: [], initial_country: form.object.recipient_country.to_s) %>
<%# Shows the fields for the country in the `selected_recipient_country` state of the herb view rendering this. %>

<div data-controller="state-switch">
  <% Event.countries_for_select.each do |code, _name| %>
    <% fields = Wire.information_required_for(code).reject { |field| field[:key].in?(excluded_fields) } %>
    <% next if fields.empty? %>
    <%= tag.fieldset class: "contents", hidden: code != initial_country, disabled: code != initial_country,
                     data: { state_switch_target: "case", state_switch_name: "selected_recipient_country", state_switch_when: code } do %>
      <div>
        <% fields.each do |field| %>
          <% id = form.field_id(field[:key], code.downcase) %>
          <div class="flex flex-col mt-2">
            <%= form.label field[:key], field[:label], for: id %>
            <div class="muted mb-1">
              <%= field[:description] %>
              <% if field[:refer_to] %>
                <%= link_to "Refer to this document", field[:refer_to], target: "_blank" %>
              <% end %>
            </div>
            <% if field[:type] == :select %>
              <%= form.select field[:key], field[:options], { required:, disabled: "", prompt: "Please select..." }, { id: } %>
            <% else %>
              <%= form.send(field[:type], field[:key], required:, class: "!max-w-full", id:) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
