<%# Money in picks its expenses with checkboxes; an expense picks the one payment that repaid it. %>
<% repaid = @item.amount_cents.negative? %>
<%= turbo_frame_tag "repayment_candidates" do %>
  <% if @candidates.any? %>
    <p class="muted text-sm mt-0 mb-2"><%= page_entries_info @candidates, entry_name: "transaction" %></p>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <% unless repaid %><th><span class="sr-only">Select</span></th><% end %>
            <th><span class="sr-only">Type</span></th>
            <th>Date</th>
            <th>Memo</th>
            <th class="text-right">Amount</th>
            <% if repaid %><th><span class="sr-only">Choose</span></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% if repaid %>
            <%= render partial: "ledger/repayments/candidate", collection: @candidates, locals: { ledger_item: @item } %>
          <% else %>
            <%= render partial: "disbursements/repayable_transaction", collection: @candidates, as: :item %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= paginate @candidates, per_page_menu: false %>
  <% else %>
    <%= blankslate repaid ? "No transactions of exactly #{@item.amount.abs.format} to match" : "No expenses of #{@item.amount.format} or less to match" %>
  <% end %>
<% end %>
