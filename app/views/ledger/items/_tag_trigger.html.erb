<%# locals: (item:, tag_picker_event: nil, taggable_codes: nil) %>

<%#
  Adapter between the ledger item view and the tag store. The item view delegates
  the whole "add tag" affordance here; the coupling to the backing HCB code and
  event lives in this partial so a future migration only touches it.

  Only the trigger is per row; `ledgers/_tag_picker` holds the options. A row
  whose HCB code isn't mapped to `tag_picker_event` gets no trigger, because the
  picker it would open holds another organization's tags. `taggable_codes` is
  that membership resolved for the whole table, since asking each row costs two
  queries per row.

  It also stands in for `HcbCodePolicy#toggle_tag?`: `tag_picker_event` is only
  set for a member of that event, so a code mapped to it already satisfies the
  policy. The server re-authorizes every toggle regardless.
%>
<% hcb_code = item.hcb_code %>
<% if tag_picker_event.present? && hcb_code.present? && taggable_codes&.include?(hcb_code.hcb_code) %>
  <button
    type="button"
    class="list-badge add-tag-badge !mx-0 menu__toggle menu__toggle--arrowless"
    style="margin-left: 0.5rem;"
    data-hcb-code="<%= hcb_code.hashid %>"
    data-action="ledger-tag-picker#toggle">+ Add tag</button>
<% end %>
