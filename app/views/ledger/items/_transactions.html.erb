<%# locals: (ledger_item:) %>

<section class="my-5 flex flex-col gap-3">
  <% ct_count = 0 %>
  <% pt_count = 0 %>

  <% transactions = [ledger_item.canonical_transactions, ledger_item.canonical_pending_transactions].flatten.sort_by { |t| [t.date, t.created_at] } %>
  <% transactions.each do |transaction| %>
    <% index = ct_count + pt_count %>

    <% canonical_transactions = transactions.first(index + 1).select { |t| t.is_a?(CanonicalTransaction) } %>
    <% canonical_pending_transactions = transactions.first(index + 1).select { |t| t.is_a?(CanonicalPendingTransaction) } %>
    <% amount = ledger_item.amount_for(canonical_transactions:, canonical_pending_transactions:).format %>

    <% if transaction.is_a?(CanonicalTransaction) %>
      <div class="flex flex-col md:flex-row justify-start items-center gap-5">
        <div class="flex-shrink-0 flex flex-col items-start min-w-[100px] w-full md:w-auto">
          <% if index.zero? %>
            Created
          <% elsif ct_count.zero? %>
            Settled
          <% else %>
            Updated
          <% end %>
          <span class="text-sm muted">
            <%= transaction.date.strftime("%b %e, %Y") %>
          </span>
        </div>

        <div class="card flex flex-grow w-full justify-between items-center">
          <div class="flex flex-row justify-start items-center gap-3">
            <%= inline_icon "transactions" %>
            <% admin_tool("badge p-0.5 m-0", "span") do %>
              <%= badge_for transaction.id, class: "bg-muted m-0" %>
            <% end %>
            <span>
              <%= amount %>
            </span>
            <span>
              <%= transaction.memo %>
            </span>
          </div>
          <% admin_tool("m-0 p-0.5") do %>
            <%= render partial: "hcb_codes/transaction_category_form", locals: { model: transaction } %>
          <% end %>
          <% admin_tool("-m-0.5 p-0.5") do %>
            <%= link_to canonical_transaction_path(transaction), class: "p-0 m-0 align-middle leading-[0]", target: :_blank do %>
              <%= inline_icon "external", size: 30, class: "!m-0" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% ct_count += 1 %>
    <% else %>
      <div class="flex flex-col md:flex-row justify-start items-center gap-5">
        <div class="flex-shrink-0 flex flex-col items-start min-w-[100px] w-full md:w-auto">
          <% if index.zero? %>
            Created
          <% else %>
            Updated
          <% end %>
          <span class="text-sm muted">
            <%= transaction.date.strftime("%b %e, %Y") %>
          </span>
        </div>

        <div class="card flex flex-grow w-full justify-between items-center">
          <div class="flex flex-row justify-start items-center gap-3">
            <%= inline_icon "transfers-horizontal" %>
            <% admin_tool("badge p-0.5 m-0", "span") do %>
              <%= badge_for transaction.id, class: "bg-muted m-0" %>
            <% end %>
            <span>
              <%= amount %>
            </span>
            <span>
              <%= transaction.memo %>
            </span>
          </div>
          <% admin_tool("m-0 p-0.5") do %>
            <%= render partial: "hcb_codes/transaction_category_form", locals: { model: transaction } %>
          <% end %>
          <% admin_tool("-m-0.5 p-0.5") do %>
            <%= link_to canonical_pending_transaction_path(transaction), class: "p-0 m-0 align-middle leading-[0]", target: :_blank do %>
              <%= inline_icon "external", size: 30, class: "!m-0" %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% pt_count += 1 %>
    <% end %>
  <% end %>
</section>
