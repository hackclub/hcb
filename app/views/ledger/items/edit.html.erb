<% page_sm %>

<%= render "events/nav" if @event %>

<h1 class="h1">
  Rename transaction
</h1>

<% if @frame %>
  <%= turbo_frame_tag @item do %>
    <%= render "ledger/items/memo/memo", item: @item, form: true, location: "ledger_item_show_page" %>
  <% end %>
<% end %>

<%= form_with model: @item, url: ledger_item_rename_path(@item), method: :patch do |form| %>
  <div class="field">
    <%= form.label :memo %>
    <%= form.text_field :memo, autofocus: true, required: true %>
  </div>

  <div class="actions">
    <%= form.submit "Rename" %>
  </div>
<% end %>
