<% if @item.primary_ledger&.event.present? %>
  <% @event = @item.primary_ledger.event %>
  <%= render "events/nav" %>
<% end %>

<section class="details">
  <div>
    <strong>
      Memo
    </strong>
    <span>
      <%= @item.memo %>
    </span>
  </div>
  <div>
    <strong>
      Amount
    </strong>
    <span>
      <%= @item.amount.format %>
    </span>
  </div>
  <div>
    <strong>
      Date
    </strong>
    <span>
      <%= @item.datetime.strftime("%b %e, %Y") %>
    </span>
  </div>
  <% if @item.hcb_code.present? %>
    <div>
      <strong>
        HCB Code
      </strong>
      <span>
        <%= link_to @item.hcb_code.hcb_code, hcb_code_path(@item.hcb_code), target: :_blank %>
      </span>
    </div>
  <% end %>
  <% if @item.linked_object.present? %>
    <% admin_tool do %>
      <strong>
        Linked Object Type
      </strong>
      <span>
        <%= @item.linked_object_type %>
      </span>
    <% end %>
    <% admin_tool do %>
      <strong>
        Linked Object ID
      </strong>
      <span>
        <%= @item.linked_object_id %>
      </span>
    <% end %>
  <% end %>
  <% if (event = @item.primary_ledger&.event).present? %>
    <% admin_tool do %>
      <strong>
        Event
      </strong>
      <span>
        <%= link_to event.name, event_path(event), target: :_blank %> (<%= event.id %>)
      </span>
    <% end %>
  <% elsif (card_grant = @item.primary_ledger&.card_grant).present? %>
    <% admin_tool do %>
      <strong>
        Card Grant
      </strong>
      <span>
        <%= link_to "Grant to #{card_grant.name}", card_grant_path(card_grant), target: :_blank %> (<%= card_grant.id %>)
      </span>
    <% end %>
  <% end %>
</section>

<%= render partial: "application/admin_viewer", locals: { record: @item } %>
<%= render partial: "application/admin_viewer", locals: { record: @item.primary_mapping } if @item.primary_mapping.present? %>
<%= render partial: "application/admin_viewer", locals: { record: @item.primary_ledger } if @item.primary_ledger.present? %>
<%= render partial: "application/admin_viewer", locals: { record: @item.linked_object } if @item.linked_object.present? %>

<%= render partial: "ledger/items/transactions", locals: { ledger_item: @item } %>

<%= render partial: "ledger/items/linked_object", locals: { ledger_item: @item } %>

<% if @item.hcb_code.present? %>
  <div class="flex justify-end align-middle flex-wrap hcb_code_actions" style="gap: 12px">
    <%= render partial: "hcb_codes/pin", locals: { hcb_code: @item.hcb_code } %>
  </div>
<% end %>

<%= render "receipts/list_v2", hcb_code: @item, frame: false, transaction_show_receipt_button: true, transaction_show_author_img: true %>
<%= render partial: "receipts/form_v3", locals: {
      receiptable: @item,
      enable_linking: true,
      upload_method: "transaction_page",
      include_spacing: true,
      turbo: true
    } %>

<%= render "comments/list", comments: @item.comments %>
<%= render "comments/form", commentable: @item %>

<% admin_tool("p-2 my-3") do %>
  <h3 class="my-2">Quickly go to</h3>
  <% if @item.hcb_code.present? %>
    <%= link_to @item.hcb_code.hcb_code, hcb_code_path(@item.hcb_code), class: "btn btn--secondary" %>
  <% end %>
  <% @item.canonical_transactions.each do |tx| %>
    <%= link_to "CT #{tx.id}", canonical_transaction_path(tx.id), class: "btn btn--secondary" %>
  <% end %>
  <% @item.canonical_pending_transactions.each do |tx| %>
    <%= link_to "CPT #{tx.id}", canonical_transaction_path(tx.id), class: "btn btn--secondary" %>
  <% end %>
<% end %>
