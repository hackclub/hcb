<%# locals: (item:) %>

<%# A transaction on the other side of a repayment: linked if the viewer can see it, and dated. %>
<% if policy(item).show? %>
  <%= link_to item.memo, ledger_item_path(item), target: "_top" %>
<% else %>
  A transaction in <%= item.primary_ledger&.event&.name || "another organization" %>
<% end %>
<span class="muted">on <%= item.datetime.strftime("%b %-d, %Y") %></span>
