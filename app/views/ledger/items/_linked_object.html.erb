<%# locals: (ledger_item:, editing: nil, event: nil, frame: nil, ledger_instance: nil, show_ach_details: nil) %>

<% linked_object_partials = {
     "Invoice"                      => "invoice",
     "Donation"                     => "donation",
     "AchTransfer"                  => "ach_transfer",
     "Wire"                         => "wire",
     "PaypalTransfer"               => "paypal_transfer",
     "WiseTransfer"                 => "wise_transfer",
     "Check"                        => "check",
     "IncreaseCheck"                => "increase_check",
     "CheckDeposit"                 => "check_deposit",
     "Disbursement::Outgoing"       => "disbursement",
     "Disbursement::Incoming"       => "disbursement",
     "StripeServiceFee"             => "stripe_service_fee",
     "BankFee"                      => "bank_fee",
     "FeeRevenue"                   => "fee_revenue",
     "Reimbursement::PayoutHolding" => "reimbursement/payout_holding",
     "Reimbursement::ExpensePayout" => "reimbursement/expense_payout",
     "CardCharge"                   => "card_charge"
   } %>

<% partial_name = linked_object_partials.fetch(ledger_item.linked_object_type, "unknown") %>
<% extra_locals = {
     "ach_transfer"                 => { show_ach_details: },
     "card_charge"                  => { frame: },
     "reimbursement/expense_payout" => { event:, frame:, ledger_instance: },
     "reimbursement/payout_holding" => { editing:, event:, ledger_instance: }
   }.fetch(partial_name, {}) %>
<%= render partial: "ledger/items/linked_objects/#{partial_name}", locals: { ledger_item:, **extra_locals } %>
