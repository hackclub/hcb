<%# locals: (ledger_item:) %>

<% check_deposit = ledger_item.linked_object %>
<%= turbo_stream_from check_deposit %>

<% if check_deposit.column_id.present? %>
  <% admin_tool("mt3") do %>
    <%= link_to "View check on Column", "https://dashboard.column.com/app/transfers/edit/check/#{check_deposit.column_id}", class: "btn bg-accent", target: "_blank" %>
    <%= link_to check_deposit.canonical_pending_transaction.fronted ? "De-front check" : "Front check", toggle_fronted_event_check_deposit_path(ledger_item.primary_ledger.event, check_deposit), class: "btn bg-accent", data: { turbo_method: :post } %>
  <% end %>
<% end %>

<% if check_deposit.rejected? %>
  <div class="banner error-card mt3">
    <p class="bold block mt0 mb0"><%= check_deposit.rejection_description %></p>

    <% if check_deposit.rejection_reason == "incomplete_image" %>
      <p class="mt1 mb0">Try taking a photo of the entire check and <%= link_to "resubmitting", event_check_deposits_path(ledger_item.primary_ledger.event) %>.</p>
    <% elsif check_deposit.rejection_reason == "poor_image_quality" %>
      <p class="mt1 mb0">Try taking a clearer photo and <%= link_to "resubmitting", event_check_deposits_path(ledger_item.primary_ledger.event) %>.</p>
    <% elsif check_deposit.rejection_reason == "incorrect_amount" %>
      <p class="mt1 mb0">Try <%= link_to "resubmitting", event_check_deposits_path(ledger_item.primary_ledger.event) %> with the correct deposit amount.</p>
    <% elsif check_deposit.rejection_reason == "incorrect_recipient" %>
      <p class="mt1 mb0">Make sure the check is made out to<br><strong>"The Hack Foundation"</strong> or <strong>"Hack Club"</strong>.</p>
    <% end %>
  </div>
<% end %>

<article class="ledger-item">
  <%= render "ledger/items/heading", ledger_item: ledger_item do %>
    <span class="grow">
      Check deposit
      <span class="regular muted">
        of
      </span>
      <span class="regular"><%= render_money check_deposit.amount_cents %></span>
    </span>
    <%= render "check_deposits/status", check_deposit: check_deposit %>
  <% end %>

  <section class="ledger-item--details">
    <div>
      <strong>Deposited by</strong>
      <%= user_mention check_deposit.created_by %>
    </div>
    <% if ledger_item.ct_count > 0 %>
      <div>
        <strong>Deposited on</strong>
        <%= format_date ledger_item.canonical_transactions.first.date %>
      </div>
    <% else %>
      <div>
        <strong>Requested at</strong>
        <%= format_datetime check_deposit.created_at %>
      </div>
      <!-- Continue to show the estimate up until we're 2 days past due -->
      <% if check_deposit.estimated_arrival_date&.after?(2.days.ago) %>
        <div>
          <strong>Estimated arrival</strong>
          <%= check_deposit.estimated_arrival_date.strftime("%b %e, %Y") %>
        </div>
      <% end %>
    <% end %>
  </section>

  <div class="grid gap-4 grid-cols-2 grid-rows-[auto_auto] place-items-center my-4">
    <div>
      <% if policy(check_deposit).view_image? %>
        <%= link_to check_deposit.front, target: "_blank" do %>
          <%= image_tag check_deposit.front.representation(resize_to_limit: [300, nil]), class: "rounded", width: 200 %>
        <% end %>
      <% else %>
        <div class="tooltipped tooltipped--n" aria-label="You don't have permission to view this image">
          <%= image_tag check_deposit.front.representation(resize_to_limit: [25, 25], blur: "0x2"), class: "rounded", width: 200 %>
        </div>
      <% end %>
    </div>
    <div>
      <% if policy(check_deposit).view_image? %>
        <%= link_to check_deposit.back, target: "_blank" do %>
          <%= image_tag check_deposit.back.representation(resize_to_limit: [300, nil]), class: "rounded", width: 200 %>
        <% end %>
      <% else %>
        <div class="tooltipped tooltipped--n" aria-label="You don't have permission to view this image">
          <%= image_tag check_deposit.back.representation(resize_to_limit: [25, 25], blur: "0x2"), class: "rounded", width: 200 %>
        </div>
      <% end %>
    </div>
    <div class="muted">Front image</div>
    <div class="muted">Back image</div>
  </div>

  <% if check_deposit.pending? %>
    <section class="ledger-item--footer">
      <% if check_deposit.pending? %>
        Checks may take up to 2 weeks to deposit.
      <% end %>
    </section>
  <% end %>
</article>
