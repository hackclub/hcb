<%# locals: (ledger_item:) %>

<% reimbursement_payout_holding = ledger_item.linked_object %>
<% payout_transfer = reimbursement_payout_holding.payout_transfer %>

<article class="ledger-item">
  <%= render "ledger/items/heading", ledger_item: ledger_item, render_memo: true %>

  <section class="card__banner card__darker details-horiz border-top">
    <p>
      <strong>Date</strong>
      <%= format_date ledger_item.datetime %>
    </p>
    <p>
      <strong>Type</strong>
      Reimbursement payout transfer
    </p>
    <p>
      <strong>Report</strong>
      <%= link_to "View Report", reimbursement_payout_holding.report %>
    </p>
    <% if payout_transfer.present? %>
      <p>
        <strong><%= reimbursement_payout_holding.report.transfer_text.upcase_first %></strong>
        <%= link_to "View Transfer", payout_transfer.ledger_item || payout_transfer.local_hcb_code %>
      </p>
    <% end %>
  </section>

  <%= render partial: "reimbursement/reports/expenses", locals: { report: reimbursement_payout_holding.report } %>
</article>
