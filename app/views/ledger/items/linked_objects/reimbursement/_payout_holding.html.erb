<%# locals: (ledger_item:) %>

<% reimbursement_payout_holding = ledger_item.linked_object %>

<article class="ledger-item">
  <%= render "hcb_codes/heading", hcb_code: ledger_item.hcb_code, render_memo: true %>

  <section class="card__banner card__darker details-horiz border-top">
    <p>
      <strong>Date</strong>
      <%= format_date ledger_item.datetime %>
    </p>
    <p>
      <strong>Type</strong>
      Reimbursement payout transfer
    </p>
    <p>
      <strong>Report</strong>
      <%= link_to "View Report", reimbursement_payout_holding.report %>
    </p>
    <% if reimbursement_payout_holding.ach_transfer %>
      <p>
        <strong>ACH transfer</strong>
        <%= link_to "View Transfer", reimbursement_payout_holding.ach_transfer %>
      </p>
    <% end %>
    <% if reimbursement_payout_holding.increase_check %>
      <p>
        <strong>Check</strong>
        <%= link_to "View", reimbursement_payout_holding.increase_check.local_hcb_code %>
      </p>
    <% end %>
  </section>

  <%= render partial: "reimbursement/reports/expenses", locals: { report: reimbursement_payout_holding.report } %>
</article>
