<%# locals: (ledger_item:) %>

<% bank_fee = ledger_item.linked_object %>

<article class="ledger-item">
  <%= render "ledger/items/heading", ledger_item: ledger_item, render_memo: true %>

  <section class="ledger-item--details">
    <div>
      <strong>Date</strong>
      <%= format_date ledger_item.datetime %>
    </div>
    <div>
      <strong>Type</strong>
      Fee
    </div>
  </section>

  <section class="card__banner secondary border-top">
    <p class="my0 italic">
      <% if ledger_item.amount_cents.negative? %>
        HCB is charging <strong><%= number_to_percentage(bank_fee.event.revenue_fee * 100, significant: true, strip_insignificant_zeros: true) %></strong> of revenue.
      <% else %>
        This is a credit for fees previously charged by HCB.
      <% end %>
    </p>
  </section>
</article>
