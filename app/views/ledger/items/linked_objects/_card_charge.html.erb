<%# locals: (ledger_item:) %>

<% card_charge = ledger_item.linked_object %>

<% instance = ledger_item.hashid %>

<% renderable_amount_cents = card_charge.stripe_atm_fee ? ledger_item.amount_cents.abs - card_charge.stripe_atm_fee : ledger_item.amount_cents.abs %>

<% admin_tool("mt1") do %>
  <%# TODO: test this with both force capture and regular capture %>
  <%= link_to "View on Stripe", card_charge.stripe_auth_dashboard_url || card_charge.stripe_txn_dashboard_url, class: "btn bg-accent" %>
  <%= link_to "Flag transaction", admin_ledger_audits_tasks_path(hcb_code: ledger_item.hcb_code.id), method: :post, class: "btn bg-error" %>
<% end %>

<% ledger_item.canonical_pending_transactions.each do |cpt| %>
  <%= render partial: "application/admin_viewer", locals: { record: cpt } %>
  <%= render partial: "application/admin_viewer", locals: { record: cpt.raw_pending_stripe_transaction } %>
<% end %>
<% ledger_item.canonical_transactions.each do |ct| %>
  <%= render partial: "application/admin_viewer", locals: { record: ct } %>
<% end %>

<article class="ledger-item">
  <%= render "hcb_codes/heading", hcb_code: ledger_item.hcb_code do %>
    <span class="flex-auto">
      <% if card_charge.stripe_cash_withdrawal? %>
        <span class="regular"><%= render_money(renderable_amount_cents) %></span>
        <span class="regular muted">
          withdrawal from
        </span>
        <%= humanized_merchant_name card_charge.stripe_merchant_data %>
      <% else %>
        <span class="regular muted">Purchase at </span>
        <%= humanized_merchant_name card_charge.stripe_merchant_data %>
        <span class="regular muted"> <%= @hcb_code.stripe_refund? ? "refunded" : "for" %> </span>
        <span class="regular"><%= render_money(renderable_amount_cents) %></span>
      <% end %>

      <% if ledger_item.hcb_code.personal_transaction.present? %>
        <span class="badge h4 bg-warning">
          Personal
          <%= inline_icon :info, size: 20 %>
        </span>
      <% end %>
    </span>
  <% end %>

  <section class="ledger-item--details">
    <div>
      <strong>Card</strong>
      <%= stripe_card_mention card_charge.stripe_card %>
    </div>
    <div>
      <strong><%= @hcb_code.stripe_refund? ? "Refunded to" : "Spender" %></strong>
      <%= link_to card_charge.stripe_card do %>
        <%= user_mention ledger_item.author %>
      <% end %>
    </div>
    <% if card_charge.stripe_atm_fee %>
      <div>
        <strong>ATM fee</strong>
        <span><%= render_money card_charge.stripe_atm_fee %></span>
      </div>
    <% end %>
    <div>
      <strong><%= @hcb_code.stripe_refund? ? "Refunded" : "Spent" %></strong>
      <%= local_time_ago @hcb_code.pt&.raw_pending_stripe_transaction&.created_at || Time.at(@hcb_code.raw_stripe_transaction.stripe_transaction["created"]) %>
    </div>
    <% unless ledger_item.ct_count == 0 || ledger_item.cpt_count == 0 %>
      <div>
        <strong>Settled after</strong>
        <span title="<%= Time.at(@hcb_code.raw_stripe_transaction.stripe_transaction["created"]).strftime("%B %e, %Y %l:%M%P") %>">
        <%= distance_of_time_in_words @hcb_code.pt.raw_pending_stripe_transaction.created_at, @hcb_code.ct.created_at %>
        </span>
      </div>
    <% end %>
  </section>

  <section class="ledger-item--info details--wide details--tall">
    <% if @hcb_code.pt&.declined? && @hcb_code.pt.raw_pending_stripe_transaction&.stripe_transaction&.dig("status") != "reversed" %>
      <% reason = @hcb_code.pt.decline_reason %>
      <% webhook_declined_reason = @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction.dig("metadata", "declined_reason") %>
      <p>
        <strong>Declined</strong>
        <action data-behavior="modal_trigger" data-modal="declined_information_<%= instance %>" class="pointer" tabindex="0">

          <%= render partial: "hcb_codes/decline_reason", locals: {
                hcb_code: ledger_item.hcb_code,
                include_troubleshooting: false,
                include_external: true
              } %>
        </action>
      </p>
    <% end %>
    <div>
      <span style="height: 100%;">
        <strong>Merchant</strong>
      </span>
      <% if ledger_item.author == current_user || organizer_signed_in? %>
        <% if defined?(@frame) && @frame %>
          <details>
            <summary class="inline-flex no-select">
              <%= country_to_emoji(card_charge.stripe_merchant_data["country"]) if card_charge.stripe_merchant_data["country"] %>
              <%= humanized_merchant_name card_charge.stripe_merchant_data %>
              <%= inline_icon "down-caret", size: 24, class: "muted flip-when-open", 'aria-label': "Icon indicating click for more" %>
            </summary>

            <div class="details mb2 mt2">
              <p>
                <strong>Name</strong>
                <span>
                  <%= humanized_merchant_name card_charge.stripe_merchant_data %>
                </span>
              </p>
              <p>
                <strong>Category</strong>
                <%= copy_to_clipboard(card_charge.stripe_merchant_data["category"], class: "w-fit", tooltip_direction: "s") do %>
                  <%= humanized_category card_charge.stripe_merchant_data %>
                <% end %>
              </p>
              <p>
                <strong>Currency</strong>
                <span>
                <%= card_charge.stripe_merchant_data_currency.upcase %>
                </span>
              </p>
              <% if is_city_or_phone?(card_charge.stripe_merchant_data["city"]) == :phone %>
                <p>
                  <strong>Phone</strong>
                  <span><%= card_charge.stripe_merchant_data["city"] %></span>
                </p>
              <% elsif is_city_or_phone?(card_charge.stripe_merchant_data["city"]) == :city %>
                <p>
                  <strong>City</strong>
                  <span><%= card_charge.stripe_merchant_data["city"].humanize %></span>
                </p>
              <% end %>
              <% if card_charge.stripe_merchant_data["postal_code"] %>
                <p>
                  <strong>Zip</strong>
                  <span><%= card_charge.stripe_merchant_data["postal_code"] %></span>
                </p>
              <% end %>
              <% if card_charge.stripe_merchant_data["state"] %>
                <p>
                  <strong>State</strong>
                  <span><%= card_charge.stripe_merchant_data["state"]&.upcase %></span>
                </p>
              <% end %>
              <% if card_charge.stripe_merchant_data["country"] %>
                <p>
                  <strong>Country</strong>
                  <span><%= country_to_emoji card_charge.stripe_merchant_data["country"] %></span>
                </p>
              <% end %>
              <p>
                <strong>Merchant ID</strong>
                <%= copy_to_clipboard(card_charge.stripe_merchant_data["network_id"], class: "w-fit", tooltip_direction: "e") %>
              </p>
            </div>
            <%= link_to "See all transactions at #{humanized_merchant_name card_charge.stripe_merchant_data}", event_transactions_path(@event, merchant: card_charge.stripe_merchant_data["network_id"]) %>
            <p class="muted">
              Details are provided by the merchant and not guaranteed to be correct.
            </p>
          </details>
        <% else %>
          <action data-behavior="modal_trigger" data-modal="merchant_details_<%= instance %>" class="pointer" tabindex="0">
            <span class="inline-flex">
              <%= country_to_emoji(card_charge.stripe_merchant_data["country"]) if card_charge.stripe_merchant_data["country"] %>
              <%= humanized_merchant_name card_charge.stripe_merchant_data %>
              <%= inline_icon "external", size: 24, class: "muted", 'aria-label': "Icon indicating click for more" %>
            </span>
          </action>
        <% end %>
      <% else %>
        <span><strong>Sign in to view</strong></span>
      <% end %>
    </div>
    <% if @hcb_code.pt.present? %>
      <div>
        <span style="height: 100%;">
          <strong>Charge method</strong>
        </span>
      <% if ledger_item.author == current_user || organizer_signed_in? %>
        <% if defined?(@frame) && @frame %>
            <details>
              <summary class="inline-flex select-none">
                <%= @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["authorization_method"].humanize %>
                <%= inline_icon "down-caret", size: 24, class: "muted flip-when-open", 'aria-label': "Icon indicating click for more" %>
              </summary>
              <% @verification_data = @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["verification_data"] %>

              <article class="details-horiz mt2 mb1">

                <div class="mt1 md-mt0" style="width: 100%;">
                  <p class="details__simulated">
                    <%= stripe_verification_check_badge "address_line1" %>
                    <span>Address check</span>
                  </p>
                  <p class="details__simulated">
                    <%= stripe_verification_check_badge "address_postal_code" %>
                    <span>ZIP check</span>
                  </p>
                </div>

                <div class="mt1 md-mt0" style="width: 100%;">
                  <p class="details__simulated">
                    <%= stripe_verification_check_badge "expiry" %>
                    <span>Expiry check</span>
                  </p>
                  <p class="details__simulated">
                    <%= stripe_verification_check_badge "cvc" %>
                    <span>CVC check</span>
                  </p>
                </div>
              </article>

              <% if @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["authorization_method"] == "contactless" && !@hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["wallet"].nil? %>
                <p class="details__simulated">
                  <strong>Wallet</strong>
                  <span class="pl1"><%= @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["wallet"].titleize %></span>
                </p>
              <% end %>
            </details>
          <% else %>
            <action data-behavior="modal_trigger" data-modal="verification_details_<%= instance %>" class="pointer" tabindex="0">
              <span>
              <%= @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["authorization_method"].humanize %>
              <%= inline_icon "external", size: 24, class: "muted", 'aria-label': "Icon indicating click for more" %>
              </span>
            </action>
          <% end %>
        <% else %>
          <span><strong>Sign in to view</strong></span>
        <% end %>
      </div>
      <% if ledger_item.hcb_code.personal_transaction.present? %>
        <p>
          <strong>Repaid by</strong>
          <%= link_to @hcb_code.personal_transaction.invoice.local_hcb_code.memo, @hcb_code.personal_transaction.invoice %>
        </p>
      <% end %>
      <% if card_charge.stripe_card.card_grant.present? %>
        <p>
          <strong>Merchant ID</strong>
          <%= copy_to_clipboard(card_charge.stripe_merchant_data["network_id"], class: "w-fit", tooltip_direction: "e") %>
        </p>
        <p>
          <strong>Category</strong>
          <%= copy_to_clipboard(card_charge.stripe_merchant_data["category"], class: "w-fit", tooltip_direction: "s") do %>
            <%= humanized_category card_charge.stripe_merchant_data %> (<%= card_charge.stripe_merchant_data["category"] %>)
          <% end %>
        </p>
      <% end %>
    <% end %>
  </section>

  <%= render "hcb_codes/stripe_card_receipts" %>
</article>

<% unless defined?(@frame) && @frame %>
  <% if ledger_item.author == current_user || organizer_signed_in? %>
    <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="merchant_details_<%= instance %>">
      <%= modal_header "Merchant details" %>

      <div class="details mb2">
        <p>
          <strong>Name</strong>
          <span>
            <%= humanized_merchant_name card_charge.stripe_merchant_data %>
          </span>
        </p>
        <p>
          <strong>Category</strong>
          <%= copy_to_clipboard(card_charge.stripe_merchant_data["category"], class: "w-fit", tooltip_direction: "s") do %>
            <%= humanized_category card_charge.stripe_merchant_data %>
          <% end %>
        </p>
        <p>
          <strong>Currency</strong>
          <span>
          <%= card_charge.stripe_merchant_data_currency.upcase %>
          </span>
        </p>
        <% if is_city_or_phone?(card_charge.stripe_merchant_data["city"]) == :phone %>
          <p>
            <strong>Phone</strong>
            <span><%= card_charge.stripe_merchant_data["city"] %></span>
          </p>
        <% elsif is_city_or_phone?(card_charge.stripe_merchant_data["city"]) == :city %>
          <p>
            <strong>City</strong>
            <span><%= card_charge.stripe_merchant_data["city"].humanize %></span>
          </p>
        <% end %>
        <p>
          <strong>Zip</strong>
          <span><%= card_charge.stripe_merchant_data["postal_code"] or "Unknown" %></span>
        </p>
        <p>
          <strong>State</strong>
          <span><%= card_charge.stripe_merchant_data["state"]&.upcase or "Unknown" %></span>
        </p>
        <p>
          <strong>Country</strong>
          <span><%= card_charge.stripe_merchant_data["country"] ? country_to_emoji(card_charge.stripe_merchant_data["country"]) : "Unknown" %></span>
        </p>
        <p>
          <strong>Merchant ID</strong>
          <%= copy_to_clipboard(card_charge.stripe_merchant_data["network_id"], class: "w-fit", tooltip_direction: "e") %>
        </p>
      </div>
      <%= link_to "See all transactions at #{humanized_merchant_name card_charge.stripe_merchant_data}", event_transactions_path(@event, merchant: card_charge.stripe_merchant_data["network_id"]) %>
      <article class="card__banner secondary border-top" style="margin: -2em; margin-top: 0.5rem;">
        <p class="my0 muted">
          Details are provided by the merchant and not guaranteed to be correct.
        </p>
      </article>
    </section>

    <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="declined_information_<%= instance %>">
      <%= modal_header "Transaction declined" %>

      <%= render partial: "hcb_codes/decline_reason", locals: {
            hcb_code: ledger_item.hcb_code,
            include_troubleshooting: true,
            include_external: true
          } %>
    </section>
  <% end %>

  <% if organizer_signed_in? && ledger_item.cpt_count > 0 %>
    <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="verification_details_<%= instance %>">
      <%= modal_header "Charge details" %>
      <% @verification_data = @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["verification_data"] %>

      <article class="details-horiz">
        <div class="mt1 md-mt0" style="width: 100%;">
          <p class="details__simulated">
            <strong>Type</strong>
            <span class="pl1">
            <%= @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["authorization_method"].humanize.capitalize %>
            </span>
          </p>
          <% if @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["authorization_method"] == "contactless" && !@hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["wallet"].nil? %>
            <p class="details__simulated">
              <strong>Wallet</strong>
              <span class="pl1"><%= @hcb_code.pt.raw_pending_stripe_transaction.stripe_transaction["wallet"].titleize %></span>
            </p>
          <% end %>
        </div>

        <div class="mt1 md-mt0" style="width: 100%;">
          <p class="details__simulated">
            <%= stripe_verification_check_badge "address_line1" %>
            <span>Address check</span>
          </p>
          <p class="details__simulated">
            <%= stripe_verification_check_badge "address_postal_code" %>
            <span>ZIP check</span>
          </p>
        </div>

        <div class="mt1 md-mt0" style="width: 100%;">
          <p class="details__simulated">
            <%= stripe_verification_check_badge "expiry" %>
            <span>Expiry check</span>
          </p>
          <p class="details__simulated">
            <%= stripe_verification_check_badge "cvc" %>
            <span>CVC check</span>
          </p>
        </div>
      </article>

      <% raw_pending_stripe_tranasction_decorator = RawPendingStripeTransactionDecorator.new card_charge.raw_pending_stripe_transaction %>
      <% if raw_pending_stripe_tranasction_decorator.currency != 'USD' %>
        <article class="card__banner secondary border-top" style="margin: -2em; margin-top: 0;">
          <p class="my0 muted">
            This transaction was initially charged as <%= raw_pending_stripe_tranasction_decorator.original_amount_international %>.
          </p>
        </article>
      <% end %>
    </section>
  <% end %>
<% end %>
