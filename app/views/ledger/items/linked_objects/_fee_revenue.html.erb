<%# locals: (ledger_item:) %>

<% fee_revenue = ledger_item.linked_object %>

<article class="ledger-item">
  <%= render "ledger/items/heading", ledger_item: ledger_item, render_memo: true %>

  <section class="ledger-item--details">
    <div>
      <strong>Date</strong>
      <%= format_date ledger_item.datetime %>
    </div>
    <div>
      <strong>Type</strong>
      Fee revenue
    </div>
  </section>

  <section class="card__banner secondary border-top">
    <p class="my0">
      <table>
        <thead>
          <tr>
            <th>Organization</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% fee_revenue.bank_fees.each do |fee| %>
            <tr>
              <td><%= link_to fee.event.name, fee.event %></td>
              <td><%= render_money fee.amount_cents %></td>
              <td><%= link_to "Details", url_for(fee.ledger_item) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </p>
  </section>
</article>
