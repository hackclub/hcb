<%# locals: (ledger_item:) %>

<% increase_check = ledger_item.linked_object %>

<link href="https://fonts.googleapis.com/css?family=Damion" rel="stylesheet">
<link href="https://fonts.googleapis.com/css?family=Space+Mono" rel="stylesheet">

<% if increase_check.column_id.present? %>
  <% admin_tool("mt3") do %>
    <%= link_to "View check on Column", "https://dashboard.column.com/app/transfers/edit/check/#{increase_check.column_id}", class: "btn bg-accent", target: "_blank" %>
  <% end %>
<% end %>

<% if increase_check.increase_id.present? %>
  <% admin_tool("mt3") do %>
    <%= link_to "View on Increase", "https://dashboard.increase.com/transfers/#{increase_check.increase_id}", class: "btn bg-accent", target: "_blank" %>
  <% end %>
<% end %>

<%= render "increase_checks/paper_check",
      check_number: increase_check.check_number,
      date: (increase_check.approved_at || increase_check.created_at).strftime("%b %d, %Y"),
      recipient_name: increase_check.recipient_name,
      amount: increase_check.amount,
      memo: increase_check.memo,
      account_details: increase_check.increase? ? increase_check.event.increase_account_number : increase_check.event.column_account_number %>

<article class="ledger-item">
  <%= render "hcb_codes/heading", hcb_code: ledger_item.hcb_code do %>
    <div class="flex items-center justify-between" style="gap: 8px">
      <span class="flex-auto mr1">
        <span class="regular muted">Check to</span>
        <%= increase_check.recipient_name %>
        <span class="regular muted">for</span>
        <span class="regular"><%= render_money increase_check.amount %></span>
      </span>
      <span class="badge h4 nowrap bg-<%= increase_check.state %>">
        <%= increase_check.state_text %>
      </span>
    </div>
  <% end %>

  <section class="ledger-item--details">
    <div>
      <% if increase_check.sent? %>
        <strong>Sent by</strong>
      <% else %>
        <strong>Requested by</strong>
      <% end %>
      <%= user_mention increase_check.user %>
    </div>
    <% if increase_check.sent? %>
      <div>
        <strong>Sent at</strong>
        <%= format_datetime increase_check.approved_at %>
      </div>
    <% else %>
      <div>
        <strong>Requested at</strong>
        <%= format_datetime increase_check.created_at %>
      </div>
    <% end %>
    <% if increase_check.reimbursement_payout_holding.present? %>
      <div>
        <strong>Reimbursing</strong>
       <%= link_to increase_check.reimbursement_payout_holding.report.name, increase_check.reimbursement_payout_holding.report, data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </section>

  <section class="ledger-item--info">
    <p>
      <strong>Sent to</strong>
      <%= increase_check.recipient_name %>
    </p>

    <p>
      <strong>Addressed to</strong>
      <%= increase_check.address %>
    </p>

    <p>
      <strong>Recipient email</strong>
      <%= increase_check.recipient_email || "(no email provided)" %>
    </p>

    <p>
      <strong>Check memo</strong>
      <%= increase_check.memo %>
    </p>

    <p>
      <strong>Payment purpose</strong>
      <%= increase_check.payment_for %>
    </p>

    <% if increase_check.check_number.present? %>
      <p>
        <strong>Check number</strong>
        <span class="font-mono"><%= increase_check.check_number %></span>
      </p>
    <% end %>

    <% if increase_check.increase_status.present? %>
      <% admin_tool "", "p" do %>
        <strong>Status</strong>
        <%= increase_check.increase_status.humanize %>
      <% end %>
    <% end %>
  </section>

  <% if increase_check.may_mark_rejected? || increase_check.column_id.present? %>
    <div class="card__banner card__darker border-top overflow-hidden flex items-center g2">
      <% if increase_check.may_mark_rejected? %>
        <% cancel_button = button_to "Cancel check", reject_increase_check_path(increase_check), class: "btn bg-error", data: { turbo_confirm: "Are you sure you want to cancel this check?", turbo_confirm_danger: true }, disabled: !policy(increase_check).reject? %>
        <% if policy(increase_check).reject? %>
          <%= cancel_button %>
        <% else %>
          <div class="tooltipped tooltipped--e w-fit" aria-label="Only managers can cancel checks!">
            <%= cancel_button %>
          </div>
        <% end %>

        <% admin_tool do %>
          <%= button_to "Process", increase_check_process_admin_path(increase_check), class: "btn", method: :get, data: { turbo_frame: "_top" } %>
        <% end %>
      <% end %>

      <% if increase_check.column_id.present? %>
        <% stop_button = button_to "Stop payment", stop_increase_check_path(increase_check), class: "btn bg-error", target: "_blank", data: { turbo_confirm: "This action will stop the check and is irreversible. The recipient may still receive a check in the mail. This check will no longer be valid and can be disposed of safely.", turbo_confirm_danger: true }, disabled: !policy(increase_check).stop? %>
        <% if policy(increase_check).stop? %>
          <%= stop_button %>
        <% elsif increase_check.can_stop? %>
          <div class="tooltipped tooltipped--e w-fit" aria-label="Only managers can stop checks!">
            <%= stop_button %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</article>
