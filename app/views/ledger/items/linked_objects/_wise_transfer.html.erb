<%# locals: (ledger_item:) %>

<% wise_transfer = ledger_item.linked_object %>

<% if wise_transfer.wise_url %>
  <% admin_tool("mt3") do %>
    <%= link_to wise_transfer.wise_url, class: "btn !bg-[#9fe870]", target: "_blank" do %>
      <%= inline_icon "wise" %>
      View transfer on Wise
    <% end %>
  <% end %>
<% end %>

<article class="ledger-item">
  <%= render "hcb_codes/heading", hcb_code: ledger_item.hcb_code do %>
    <span>
      <% if wise_transfer.failed? %>
        <span class="regular muted">Attempted to Wise transfer to</span>
        <%= wise_transfer.recipient_name %>
        <span class="regular muted">for</span>
        <span class="regular"><%= Money.from_cents(wise_transfer.amount_cents, wise_transfer.currency).format %></span>
        <span class="regular muted">(charged <%= render_money(ledger_item.amount_cents * -1) %>)</span>
      <% else %>
        <span class="regular muted">Wise transfer to</span>
        <%= wise_transfer.recipient_name %>
        <span class="regular muted">for</span>
        <span class="regular"><%= Money.from_cents(wise_transfer.amount_cents, wise_transfer.currency).format %> <%= wise_transfer.currency %></span>
      <% end %>
    </span>
    <span class="badge h4 bg-<%= wise_transfer.status_color %> nowrap order-1">
      <%= wise_transfer.state_text %>
    </span>
  <% end %>

  <section class="ledger-item--details">
    <div>
      <strong>Sent by</strong>
      <%= user_mention wise_transfer.user %>
    </div>
    <div>
      <strong>Sent at</strong>
      <%= format_datetime wise_transfer.created_at %>
    </div>
    <% if wise_transfer.pending? || wise_transfer.approved? %>
        <% admin_tool "w-fit flex items-center justify-center !px-4" do %>
          <%= link_to "Process", wise_transfer_process_admin_path(wise_transfer), class: "btn", target: "_blank" %>
        <% end %>
      <% end %>
  </section>
  <turbo-frame id="details">
    <section class="ledger-item--info">
      <p>
        <strong>Recipient name</strong>
        <%= wise_transfer.recipient_name %>
      </p>

      <p>
        <strong>Recipient email</strong>
        <%= wise_transfer.recipient_email %>
      </p>

      <p>
        <strong>Recipient country</strong>
        <%= wise_transfer.recipient_country %>
      </p>

      <p>
        <strong>Payment purpose</strong>
        <%= wise_transfer.payment_for %>
      </p>

      <% if wise_transfer.return_reason.present? %>
        <p>
          <strong>Return reason</strong>
          <%= wise_transfer.return_reason %>
        </p>
      <% end %>

      <p>
        <strong>Amount (<%= wise_transfer.currency %>)</strong>
        <%= Money.from_cents(wise_transfer.amount_cents, wise_transfer.currency).format %>
      </p>

      <p>
        <% if ledger_item.canonical_transactions.any? %>
          <strong>Settled amount (USD)</strong>
        <% else %>
          <strong>Pending amount (USD)</strong>
        <% end %>
        <%= render_money ledger_item.amount_cents.abs %>
      </p>
    </section>

    <% unless ledger_item.canonical_pending_transactions.first.settled? %>
      <section class="card__banner relative bg-[#9FE870] dark:text-[#9FE870] text-[#163300] dark:bg-[#163300] flex flex-row items-center justify-start gap-4 mt-0 md:gap-2">
        <%= inline_icon "wise", size: 16 %>
        <div class="flex md:flex-row flex-col items-start justify-start gap-1 flex-grow">
          The amount you pay (<%= render_money ledger_item.amount_cents.abs %> USD) might change.
          <span class="md:flex-grow"></span>
          <%= link_to "Learn more about Wise transfers on HCB →", "https://help.hcb.hackclub.com/article/65-wise", class: "dark:!text-[#9FE870] !text-[#163300] bold no-underline after:content-[''] after:top-0 after:left-0 after:bottom-0 after:right-0 after:z-index-1 after:absolute", target: "_blank" %>
        </div>
      </section>
    <% end %>
  </turbo-frame>
</article>
