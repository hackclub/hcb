<%# locals: (ledger_item:) %>

<% stripe_service_fee = ledger_item.linked_object %>

<%= render partial: "application/admin_viewer", locals: { record: stripe_service_fee.stripe_topup } if stripe_service_fee.stripe_topup.present? %>
<%= render partial: "application/admin_viewer", locals: { record: stripe_service_fee.raw_pending_stripe_service_fee_transaction } if stripe_service_fee.raw_pending_stripe_service_fee_transaction.present? %>

<article class="ledger-item">
  <%= render "ledger/items/heading", ledger_item: ledger_item, render_memo: true %>

  <section class="ledger-item--details">
    <div>
      <strong>Date</strong>
      <%= format_date ledger_item.datetime %>
    </div>
    <div>
      <strong>Type</strong>
      Stripe service fee
    </div>
  </section>

  <section class="card__banner secondary border-top">
    <p class="my0 italic">
      Stripe charged HCB this service fee. HCB tops up its Stripe balance to cover it.
    </p>
  </section>
</article>
