<%# locals: (ledger_item:) %>

<% paypal_transfer = ledger_item.linked_object %>

<article class="ledger-item">
  <%= render "hcb_codes/heading", hcb_code: ledger_item.hcb_code do %>
    <span>
      <span class="regular muted"><%= paypal_transfer.deposited? ? "Transferred " : "Transferring " %> </span>
      <%= paypal_transfer.recipient_name %>
      <span class="regular"><%= render_money paypal_transfer.amount %></span>
      <span class="regular muted">via PayPal</span>
    </span>
    <span class="badge h4 ml0 bg-<%= paypal_transfer.state %> nowrap order-1">
      <%= paypal_transfer.state_text %>
    </span>
  <% end %>

  <section class="ledger-item--details">
    <div>
      <strong>Sent by</strong>
      <%= user_mention paypal_transfer.user %>
    </div>
    <div>
      <strong>Sent at</strong>
      <%= format_datetime paypal_transfer.created_at %>
    </div>
  </section>
  <turbo-frame id="details">
    <section class="ledger-item--info">
      <p>
        <strong>Recipient name</strong>
        <%= paypal_transfer.recipient_name %>
      </p>

      <p>
        <strong>Recipient email</strong>
        <%= paypal_transfer.recipient_email %>
      </p>

      <p>
        <strong>Payment purpose</strong>
        <%= paypal_transfer.payment_for %>
      </p>

      <p>
        <strong>Amount</strong>
        <%= render_money paypal_transfer.amount %>
      </p>
    </section>
  </turbo-frame>

  <% if admin_signed_in? && paypal_transfer.may_mark_rejected? %>
    <div class="card__banner card__darker border-top overflow-hidden">
      <% admin_tool "w-fit" do %>
        <%= button_to "Process", paypal_transfer_process_admin_path(paypal_transfer), class: "btn", method: :get, data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% end %>
</article>
