<%# locals: (item:) -%>

<% if policy(item).rename? %>
  <div class="flex gap-1" style="flex-grow: 1" data-controller="memo">
    <% link_data = (popovers_enabled? ? ledger_item_popover_data(item) : { turbo: false }).merge(
         memo_target: "display",
         action: "click->memo#editOnShiftClick"
       ) %>
    <%= link_to ledger_item_path(item), style: "color: inherit; min-width: 0;", data: link_data do %>
      <%= render "ledger/items/memo/span", item: %>
    <% end %>

    <%# form_with only passes :id, :class, :multipart, :method, :data, and
        :authenticity_token through as top-level html attributes — anything
        else (like `hidden`) has to go through html: {} or it's silently
        dropped. %>
    <%= form_with model: item, url: ledger_item_rename_path(item), method: :patch, class: "renaming", html: { hidden: true }, data: { memo_target: "form", turbo_stream: true, action: "turbo:submit-end->memo#submitEnd" } do |form| %>
      <div class="flex items-center w-screen">
        <%# form.text_field defaults to id="ledger_item_memo" — identical for
            every row, since Rails derives it from the model/field name, not
            the record. Scoping it by item avoids duplicate ids across the
            page (which was also confusing the browser's autofill into
            suggesting other rows' memos); autocomplete is off for the same
            reason — it's not a field a browser should ever be filling in. %>
        <%= form.text_field :memo,
                            value: item.memo,
                            id: "#{dom_id(item)}_memo",
                            autocomplete: "off",
                            data: { memo_target: "input", action: "blur->memo#save keydown->memo#keydown" },
                            class: "bg-transparent fit",
                            style: "border: none; outline: none; padding: 0; border-radius: 0; min-height: 0; margin-top: 5px; margin-bottom: 3px; width: 100%" %>
      </div>
    <% end %>
  </div>
<% else %>
  <%= link_to item.memo, ledger_item_path(item), style: "color: inherit; min-width: 0;", data: popovers_enabled? ? ledger_item_popover_data(item) : { turbo: false } %>
<% end %>
