<%# locals: (item:, form: false, location: "ledger_item_show_page", renamed: false) -%>

<% frame_id = "#{location}:#{dom_id(item)}:memo" %>
<% link_data = popovers_enabled? ? ledger_item_popover_data(item) : { turbo: false } %>

<% if policy(item).update? %>
  <%= turbo_frame_tag frame_id, class: "flex gap-1", style: "flex-grow: 1" do %>
    <% if form %>
      <%= form_with model: item, url: ledger_item_rename_path(item), method: :patch, class: "renaming", data: { turbo: true, controller: "form" } do |form| %>
        <div class="flex items-center w-screen">
          <%= form.hidden_field :inline, value: "true" %>
          <%= form.hidden_field :location, value: location %>
          <%= form.text_field :memo,
                              placeholder: item.memo,
                              autofocus: true,
                              defaultValue: item.memo,
                              data: { controller: "input", input_target: "input", action: "focus->input#select blur->form#submit keydown->form#keydown" },
                              class: "bg-transparent fit",
                              style: "border: none; outline: none; padding: 0; border-radius: 0; min-height: 0; margin-top: 5px; margin-bottom: 3px; width: 100%" %>
        </div>
      <% end %>
    <% else %>
      <% contents = capture do %>
        <span class="<%= "renamed" if renamed %>"
              data-controller="navigation"
              title="<%= item.memo %>"
              style="flex-grow: 1"
              data-action="click->navigation#navigateOnShiftClick"
              data-navigation-location-param="<%= ledger_item_rename_path(item, inline: true, location:) %>"
              data-navigation-frame-param="<%= frame_id %>">
          <span class="mr2 tooltipped tooltipped--s memo-underline"
                style="color: inherit; text-decoration: none;"
                aria-label="Shift+click to rename this transaction">
            <span data-memo-for="<%= dom_id(item) %>">
              <%= item.memo %>
            </span>
          </span>
        </span>
      <% end %>
      <%= link_to contents, ledger_item_path(item), style: "color: inherit; min-width: 0;", data: link_data %>
      <% if renamed %>
        <%= render "ledger/items/memo/stream", item: %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= link_to item.memo, ledger_item_path(item), style: "color: inherit; min-width: 0;", data: link_data %>
<% end %>
