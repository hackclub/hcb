<%# locals: (transaction:) %>
<%# The decline of a pending transaction, dated by when its declined mapping was recorded. %>

<% mapping = transaction.canonical_pending_declined_mapping %>

<div class="flex flex-col md:flex-row justify-start items-center gap-5">
  <div class="flex-shrink-0 flex flex-col items-start min-w-[100px] w-full md:w-auto">
    <span class="flex items-center gap-1">
      <span class="muted" aria-hidden="true">↳</span>
      Declined
    </span>
    <span class="text-sm muted">
      <%= mapping.created_at.strftime("%b %e, %Y") %>
    </span>
  </div>

  <div class="card flex flex-grow w-full justify-between items-center">
    <div class="flex flex-row justify-start items-center gap-3">
      <%= inline_icon "forbidden" %>
      <% admin_tool("badge p-0.5 m-0", "span") do %>
        <%= badge_for mapping.id, class: "bg-muted m-0" %>
      <% end %>
      <span>
        <%= transaction.decline_reason.present? ? transaction.decline_reason.to_s.humanize : "No decline reason recorded" %>
      </span>
    </div>
  </div>
</div>
