<%# locals: (klass: "") -%>

<% messages = renderable_flash -%>
<% messages.each_key { |key| flash.discard(key) } if turbo_frame_request? -%>

<div id="flash-container">
  <% messages.each_with_index do |(key, value), index| %>
    <article
      role="alertdialog"
      class="flash flex items-center <%= "mt2" unless index == 0 %> shrink-none <%= key %> <%= klass %>"
      data-behavior="flash"
      data-turbo-temporary>
      <div class="min-w-0 overflow-hidden break-words hyphens-auto">
        <% if value.is_a? Hash %>
          <%= value["text"] %>
          <%= link_to value["link_text"], value["link"] if value["link"] %>
        <% else %>
          <%= value %>
        <% end %>
      </div>
      <%= inline_icon "view-close", size: 32, class: "pointer shrink-0 ml-auto" %>
    </article>
  <% end %>
</div>
