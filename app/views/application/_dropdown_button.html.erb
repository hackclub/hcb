<%# locals: (button:, radios:, menu_class: nil, wrapper_class: nil) %>
<%# herb:slots client %>
<%# herb:state (menu_open: false) %>

<%# Rendered by the `dropdown_button` helper, which builds `button` (its caret toggles `menu_open`) and `radios`. %>
<div class="dropdown-button relative w-fit <%= wrapper_class %>" data-herb-set="click@outside->menu_open=false">
  <%= button %>
  <div class="dropdown-button__menu fade-card-show <%= menu_class %>" hidden="<%= !menu_open %>">
    <div>
      <%= radios %>
    </div>
  </div>
</div>
