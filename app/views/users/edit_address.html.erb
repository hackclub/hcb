<% title "Account settings" %>
<% page_md %>
<% disabled = !policy(@user).update? %>

<%= render "users/nav", selected: :settings_billing_address %>

<turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth">
  <%= render "settings_header", active: "address" %>
  <section>
    <p class="muted mt0 mb2">
      Merchants use this address to verify your identity on card transactions.
      <b class="bold">Changing your address applies immediately to all of your cards</b>;
      recurring card charges like subscriptions might break.
    </p>

    <%= form_with model: @user, id: "billing_address_form", data: { turbo_frame: "_top" } do |form| %>
      <%= form.fields_for :stripe_cardholder, @user.stripe_cardholder do |form| %>
        <div class="field mb1">
          <%= form.label :stripe_billing_address_line1, "Street address" %>
          <%= form.text_field :stripe_billing_address_line1, placeholder: StripeCardholder::DEFAULT_BILLING_ADDRESS[:line1], required: true, disabled: %>
        </div>

        <div class="field mt1">
          <%= form.text_field :stripe_billing_address_line2, placeholder: "(Building / Apartment / Room)", disabled: %>
        </div>

        <div class="grid grid--split">
          <div class="field flex-auto">
            <%= form.label :stripe_billing_address_city, "City" %>
            <%= form.text_field :stripe_billing_address_city, placeholder: StripeCardholder::DEFAULT_BILLING_ADDRESS[:city], required: true, disabled: %>
          </div>
          <div class="field flex-auto">
            <%= form.label :address_state, "State / Province" %>
            <%= form.select :stripe_billing_address_state, @states, {}, disabled: %>
          </div>
        </div>

        <div class="grid grid--split">
          <div class="field flex-auto">
            <%= form.label :postal_code %>
            <%= form.text_field :stripe_billing_address_postal_code, placeholder: StripeCardholder::DEFAULT_BILLING_ADDRESS[:postal_code], required: true, disabled: %>
          </div>

          <div class="field flex-auto">
            <%= form.label :country %>
            <%= form.country_select :stripe_billing_address_country, nil, { only: ["US"] }, { required: true, disabled: } %>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="actions mt1 flex gap-2 items-center">
      <%= submit_tag "Save", disabled:, form: "billing_address_form" %>
      <% unless disabled || @user.stripe_cardholder.default_billing_address? %>
        <%= button_to "Reset to default address",
              reset_billing_address_user_path(@user),
              method: :post,
              class: "btn bg-muted",
              form: { data: { turbo_frame: "_top" } },
              data: { turbo_confirm: "Reset your billing address to HCB's default address? This applies immediately to all of your cards, and recurring card charges like subscriptions might break." } %>
      <% end %>
    </div>
  </section>
</turbo-frame>
