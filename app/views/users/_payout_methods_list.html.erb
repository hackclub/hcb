<%# locals: (user:, legal_entity:, attempted: nil, initial_row: (attempted&.persisted? && (attempted.errors.any? || attempted.details&.errors&.any?) ? attempted.id.to_s : "")) %>
<%# herb:slots client %>
<%# The id of the row whose edit form is open, or "". A row whose save failed starts open.
    It's reset before Turbo caches the page, so a restored snapshot matches the seed. %>
<%# herb:state (selected_row: initial_row) %>
<% methods = legal_entity ? legal_entity.payout_methods.unarchived.includes(:details).order(created_at: :asc) : [] %>
<% locking_by_method = methods.any? ?
     Reimbursement::Report
       .where(legal_entity_payout_method_id: methods.map(&:id), aasm_state: LegalEntity::PayoutMethod::LOCKING_REPORT_STATES)
       .includes(:event)
       .group_by(&:legal_entity_payout_method_id) : {} %>
<% errored = attempted && (attempted.errors.any? || attempted.details&.errors&.any?) %>
<% create_error = errored && attempted.new_record? %>
<% edit_error_id = errored && attempted.persisted? ? attempted.id : nil %>

<div class="payout-methods" data-herb-reset="turbo:before-cache@document->selected_row">
  <div class="card p0 overflow-hidden">
    <div class="payout-methods__header flex items-center justify-between" style="padding: 14px 20px;">
      <strong>Payout methods</strong>
      <button type="button" class="btn btn-small bg-success" data-behavior="modal_trigger" data-modal="add_payout_method_modal">
        <%= inline_icon "plus", size: 16 %>
        Add method
      </button>
    </div>

    <% if methods.any? %>
      <div class="payout-methods__rows">
        <% methods.each do |pm| %>
          <% errored_row = edit_error_id == pm.id %>
          <%= render "users/payout_form/payout_method_row", user:, payout_method: (errored_row ? attempted : pm), locking_reports: locking_by_method[pm.id] || [], sole_method: methods.one?, state: { selected_row: selected_row } %>
        <% end %>
      </div>
    <% else %>
      <div class="muted center" style="padding: 32px 20px; font-size: 13px;">
        No payout methods yet — add one so you can be paid.
      </div>
    <% end %>

  </div>

  <section
    id="add_payout_method_modal"
    class="modal modal--scroll bg-snow py"
    data-behavior="modal"
    role="dialog"
    data-controller="turbo-frame-modal"
    data-action="turbo:submit-end->turbo-frame-modal#submitEnd">
    <%= modal_header "Add method" %>
    <div style="padding: 0 20px 20px;">
      <%= render "users/payout_form/form", user:, legal_entity:, creating: true, attempted: (create_error ? attempted : nil) %>
    </div>
  </section>
</div>
