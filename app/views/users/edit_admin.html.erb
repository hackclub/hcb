<% title "Account settings" %>
<% page_md %>
<%= render "users/nav", selected: :settings_admin %>

<%= render "users/settings_header", active: "admin" %>
<turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth" class="flex flex-col gap-4">
  <% admin_tool "p-3" do %>
    <h3 class="mb2 mt1">User info</h3>
    <section>
      <p>
        <%= user_mention @user %>'s profile was created on <%= @user.created_at.strftime("%B %d, %Y at %I:%M %P") %>
      </p>
      <% if @user.locked? %>
        <p>Locked by <%= user_mention @user.locked_by %> on <%= format_date @user.locked_at %></p>
      <% end %>
      <p>
        <strong>User ID:</strong> <%= @user.id %> (<%= @user.public_id %>)
      </p>
      <p>
        <strong>Email:</strong> <%= mail_to @user.email %>
      </p>
      <% if @user.stripe_cardholder.present? %>
        <p>
          <%= link_to "View cardholder on Stripe", @user.stripe_cardholder.stripe_dashboard_url, class: "btn" %>
        </p>
      <% end %>
    </section>
  <% end %>

  <% admin_tool "p-3", override_pretend: true do %>
    <h3 id="admin" class="mb2 mt1">Admin configurations</h3>
      <%= form_with(model: @user, local: true, data: { turbo_frame: "_top" }) do |form| %>
        <%= form_errors @user %>

        <% if @user == current_user %>
          <div class="field field--checkbox">
            <%= form.label :pretend_is_not_admin, "Pretend not to be an admin on HCB" %>
            <%= form.check_box :pretend_is_not_admin %>
          </div>
        <% end %>

        <% if admin_signed_in? %>
          <p>
            <%= link_to "Impersonate", impersonate_user_path(@user.id), data: { turbo_confirm: "Are you sure?", turbo_method: :post, turbo_frame: "_top" } unless current_session&.impersonated? %>
          </p>

          <div class="field field--checkbox">
            <%= form.label :locked, "Lock user from signing into HCB (also freezes all of their active cards)" %>
            <%= form.check_box :locked, checked: @user.locked?, disabled: !admin_signed_in? %>
          </div>

          <div class="field field--checkbox">
            <%= form.label :running_balance_enabled, "Show running balance?" %>
            <%= form.check_box :running_balance_enabled, checked: @user.running_balance_enabled? %>
          </div>

          <div class="field field--checkbox">
            <%= form.label :phone_number_verification_bypassed, "Bypass phone number verification for stripe cards / card grants" %>
            <%= form.check_box :phone_number_verification_bypassed, checked: @user.phone_number_verification_bypassed? %>
          </div>

        <% end %>

        <% if superadmin_signed_in? %>
          <div class="field">
            <%= form.label :access_level, "Access level" %>
            <%= form.select :access_level,
                            [
                              ["👤 Regular user", "user"],
                              ["📚 Auditor", "auditor"],
                              ["🛡️ Admin", "admin"],
                              ["👑 Superadmin (can manage other users' admin status)", "superadmin"],
                            ],
                            {},
                            disabled: current_user == @user %>
          </div>
        <% end %>

        <div class="actions flex">
          <%= form.submit "Save settings" %>
        </div>
      <% end %>
  <% end %>

  <% admin_tool "p-3" do %>
    <h3 class="mb2 mt1">Card locking</h3>
    <section>
      <p>
        Cards are currently
        <strong class="<%= @user.cards_locked? ? "error" : "success" %>"><%= @user.cards_locked? ? "locked" : "active" %></strong>.
      </p>
      <% if @user.card_locking_suppressed? %>
        <p>Card locking is suppressed until <%= format_datetime @user.card_locking_suppressed_until %>.</p>
      <% end %>
      <% if admin_signed_in? && (@user != current_user || Flipper.enabled?(:card_locking_self_suppression, current_user)) %>
        <%= form_with url: suppress_card_locking_user_path(@user), method: :post, data: { turbo_frame: "_top" } do |form| %>
          <div class="field">
            <%= form.label :hours, "Suppress card locking for (hours)" %>
            <%= form.number_field :hours, value: 24, min: 1, max: 720 %>
          </div>
          <div class="actions flex">
            <%= form.submit "Suppress card locking", data: { turbo_confirm: "Pause card locking for this user and unlock their cards now?" } %>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% admin_tool "p-3" do %>
    <h3 class="mb2 mt1">Admin transfer limit</h3>
    <section>
      <p>Admin transfer limit is currently: <strong><%= @limit ? number_to_currency(@limit.amount_cents / 100.0) : "None" %></strong></p>
      <% if superadmin_signed_in? %>
        <%= form_with url: update_admin_transfer_limit_user_path(@user), method: :post, data: { turbo_frame: "_top" } do |form| %>
          <div class="field">
            <%= form.label :limit_amount, "Set admin transfer limit (dollars)" %>
            <%= form.number_field :limit_amount, step: 0.01, min: 0, value: @limit ? "%.2f" % (@limit.amount_cents / 100.0) : nil %>
          </div>
          <div class="actions flex">
            <%# The confirmation names the amount in the field, which only the browser knows. %>
            <%= form.submit "Set admin transfer limit", data: {
                  turbo_confirm: "Set the admin transfer limit for this user to $0.00?",
                  controller: "confirm-amount",
                  action: "click->confirm-amount#update",
                  confirm_amount_field_value: "limit_amount",
                  confirm_amount_template_value: "Set the admin transfer limit for this user to $%{amount}?"
                } %>
          </div>
        <% end %>
      <% end %>
    </section>
    <% if @limit %>
      <section class="mt-6">
        <h4 class="mb2">Temporary boosts</h4>
        <p class="muted">
          A boost raises this user's admin transfer limit for a set time, for example to approve a one-off transfer larger than their usual limit.
          Approved transfers count against the limit for <%= distance_of_time_in_words(Governance::Admin::Transfer::Limit::WINDOW_DURATION) %>, so a boost should outlast that window after it's used.
        </p>
        <% if @limit.boost_amount_cents.positive? %>
          <p>
            Effective limit right now: <strong><%= @limit.effective_amount.format %></strong>
            (<%= @limit.amount.format %> usual + <%= @limit.boost_amount.format %> boosted)
          </p>
        <% end %>

        <% if @limit_boosts.any? %>
          <section class="table-container mt-3">
            <table class="table">
              <thead>
                <tr>
                  <th>Amount</th>
                  <th>Granted</th>
                  <th>Expires</th>
                  <th>Granted by</th>
                  <th>Reason</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% @limit_boosts.each do |boost| %>
                  <tr>
                    <td><%= boost.amount.format %></td>
                    <td><%= format_datetime boost.created_at %></td>
                    <td>
                      <%= format_datetime boost.expires_at %>
                      <% unless boost.active? %><span class="muted">(expired)</span><% end %>
                    </td>
                    <td><%= user_mention boost.granted_by %></td>
                    <td><%= boost.reason %></td>
                    <td>
                      <% if boost.active? && superadmin_signed_in? %>
                        <%= button_to "Revoke", revoke_admin_transfer_limit_boost_user_path(@user, boost_id: boost.id),
                                      method: :post,
                                      class: "btn btn-small bg-error",
                                      form: { data: { turbo_frame: "_top", turbo_confirm: "Revoke this #{boost.amount.format} boost now?" } } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </section>
        <% end %>

        <% if superadmin_signed_in? %>
          <%= form_with url: create_admin_transfer_limit_boost_user_path(@user), method: :post, class: "mt-3", data: { turbo_frame: "_top" } do |form| %>
            <div class="field">
              <%= form.label :amount, "Boost amount (dollars)" %>
              <%= form.number_field :amount, step: 0.01, min: 0.01, required: true %>
            </div>
            <div class="field">
              <%= form.label :duration_in_hours, "Duration (hours)" %>
              <%= form.number_field :duration_in_hours,
                                    value: Governance::Admin::Transfer::Limit::Boost::DEFAULT_DURATION_IN_HOURS,
                                    min: Governance::Admin::Transfer::Limit::Boost::MINIMUM_DURATION_IN_HOURS,
                                    max: Governance::Admin::Transfer::Limit::Boost::MAXIMUM_DURATION_IN_HOURS,
                                    step: 1,
                                    required: true %>
            </div>
            <div class="field">
              <%= form.label :reason %>
              <%= form.text_field :reason, placeholder: "Approving the $1M grant to …", required: true %>
            </div>
            <div class="actions flex">
              <%# The confirmation names the amount in the field, which only the browser knows. %>
              <%= form.submit "Boost admin transfer limit", data: {
                    turbo_confirm: "Boost the admin transfer limit for this user by $0.00?",
                    controller: "confirm-amount",
                    action: "click->confirm-amount#update",
                    confirm_amount_field_value: "amount",
                    confirm_amount_template_value: "Boost the admin transfer limit for this user by $%{amount}?"
                  } %>
            </div>
          <% end %>
        <% end %>
      </section>

      <%= turbo_frame_tag "transfer_limit_history",
            src: admin_transfer_limit_history_user_path(@user),
            loading: :lazy do %>
        <p>Loading transfer limit history...</p>
      <% end %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag :admin_details, src: admin_details_user_path(@user), loading: :lazy do %>
    <% admin_tool "p-3" do %>
      <p>Loading user details</p>
    <% end %>
  <% end %>

  <%= turbo_frame_tag :admin_details_emails, src: admin_details_emails_user_path(@user), loading: :lazy do %>
    <% admin_tool "p-3" do %>
      <p>Loading emails sent to user</p>
    <% end %>
  <% end %>

  <% admin_tool "p-3" do %>
    <h3 class="mb2 mt1">Comments</h3>
    <%= render "comments/list", comments: @user.comments, show_blankslate: true %>
    <%= render "comments/form", commentable: @user, admin_only: true %>
  <% end %>
</turbo-frame>
