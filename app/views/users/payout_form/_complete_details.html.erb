<%# locals: (payout_method:) %>
<% details = payout_method.details %>

<%= form_with model: details, scope: :payout_method_details, url: complete_details_payout_method_path(payout_method), method: :patch, data: { turbo_frame: "_top" } do |form| %>
  <% details.required_field_definitions(payout_method.missing_required_fields).each do |field| %>
    <div class="field">
      <%= form.label field[:key], field[:label] %>
      <% if field[:type] == :segmented_date %>
        <%= render "wise_transfers/segmented_date_field", form:, field:, input_options: { required: true } %>
      <% else %>
        <%= form.public_send(field[:type], field[:key], placeholder: field[:placeholder], pattern: field[:pattern], required: true) %>
      <% end %>
    </div>
  <% end %>
  <%= form.submit "Save details", class: "btn btn-small bg-success" %>
<% end %>
