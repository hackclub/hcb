<% title "Account settings" %>
<% page_md %>
<%= render "users/nav", selected: :settings_tax %>

<% show_tin = policy(@legal_entity).show_masked_tin? %>
<% for_name = @legal_entity.person? ? "" : " for #{@legal_entity.display_name}" %>
<% possessive = @legal_entity.person? ? "Your" : "#{@legal_entity.display_name}'s" %>
<% next_req = @legal_entity.pending_payable_requirements(requires_tax_form: @legal_entity.tax_form_required?).first %>
<% mismatched = @legal_entity.mismatched_tax_form || @legal_entity.entity_type_mismatched_tax_form if @legal_entity.completed_tax_form? %>

<turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth">
  <%= render "settings_header", active: "tax", legal_entities: @legal_entities, legal_entity: @legal_entity %>
  <section>
    <p class="muted mt0 mb2">
      Before organizations can pay you or your business through HCB, we need a tax form (W-9 or W-8) on file.
      Tax information is stored securely and used to send tax forms at the end of the year
      if total payments exceed IRS reporting requirements.
    </p>

    <% case next_req %>
    <% when :not_tin_banned %>
      <p><%= possessive %> TIN has been banned from receiving payments on HCB.</p>
    <% when :not_archived %>
      <p><%= @legal_entity.person? ? "Your personal legal entity" : @legal_entity.display_name %> has been archived.</p>
    <% when :form_present %>
      <% if @legal_entity.latest_tax_form.present? && !@legal_entity.latest_tax_form.failed? %>
        <p><%= possessive %> tax form is unfinished.</p>

        <%= link_to "Resume tax form", tax_form_path(@legal_entity.latest_tax_form), class: "btn" %>
      <% else %>
        <p><%= possessive %> tax form hasn't been submitted yet.</p>

        <%= button_to "Start tax form", tax_forms_path, params: { legal_entity_id: @legal_entity.hashid }, class: "btn" %>
      <% end %>
    <% when :form_not_mismatched %>
      <%= render "legal_entities/mismatched_tax_form", legal_entity: @legal_entity, mismatched:, show_tin: %>
    <% when :form_verified %>
      <% if @completed_tax_form.taxbandits_tin_match_failed? %>
        <p>
          We couldn't verify the tax form you submitted on <%= format_date @completed_tax_form.completed_at %>
          with TIN <%= masked_tin_tag @completed_tax_form, viewable: show_tin %>.
          Double-check the name and TIN, then submit a new tax form.
        </p>

        <%= button_to "Start new tax form", tax_forms_path, params: { legal_entity_id: @legal_entity.hashid }, class: "btn" %>
      <% else %>
        <p>
          The tax form you submitted on <%= format_date @completed_tax_form.completed_at %>
          with TIN <%= masked_tin_tag @completed_tax_form, viewable: show_tin %> is pending verification.
        </p>
      <% end %>
    <% else %>
      <% if mismatched.present? %>
        <%= render "legal_entities/mismatched_tax_form", legal_entity: @legal_entity, mismatched:, show_tin: %>
      <% elsif @completed_tax_form.present? %>
        <p>
          You last submitted a tax form<%= for_name %> on <%= format_date @completed_tax_form.completed_at %>
          with TIN <%= masked_tin_tag @completed_tax_form, viewable: show_tin %>.
          If you need to update your tax information, start a new tax form.
        </p>

        <%= button_to "Start new tax form", tax_forms_path, params: { legal_entity_id: @legal_entity.hashid }, class: "btn" %>
      <% else %>
        <p>A tax form isn't needed<%= for_name %> right now.</p>
      <% end %>
    <% end %>
  </section>
</turbo-frame>
