<% title "Emburse cards" %>

<h1>
  Emburse cards
</h1>

<%= paginate @emburse_cards %>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th class="text-right">Project</th>
      <th><%# show link %></th>
    </tr>
  </thead>

  <tbody>
    <% @emburse_cards.each do |card| %>
      <tr>
        <td><%= user_mention card.user %></td>
        <td class="text-right"><%= card.event.name %></td>
        <td><%= link_to "Show", card %></td>
      </tr>
    <% end %>
  </tbody>
</table>
