<%# locals: (event:) %>
<%# Big closing CTA, with HCB's own hand-drawn dino. %>
<div class="mk-ais-cta mk-ais-cta--dino">
  <div class="mk-ais-cta__inner">
    <div class="mk-ais-cta__copy">
      <p class="mk-ais-cta__title">Send us your grant letter</p>
      <p class="mk-ais-cta__sub">A person replies within one business day.</p>
      <div class="mk-ais-cta__actions">
        <a href="#talk-to-us" class="mk-ais-cta__btn plausible-event-name=<%= event %>">Talk to our team</a>
        <a href="mailto:aisafety@hackclub.com" class="mk-ais-cta__mail">aisafety@hackclub.com</a>
      </div>
    </div>
    <img src="/dino_leaping_for_money.svg" alt="" class="mk-ais-cta__dino" width="270" height="215" loading="lazy" decoding="async">
  </div>
</div>
