<% title "Tax form for #{@legal_entity.name}" %>

<h1>Tax form for <%= @legal_entity.name %></h1>

<div data-controller="taxbandits" data-taxbandits-form-id-value="<%= @form.external_id %>">
  <iframe
    src="<%= @form.signing_url %>"
    class="border-0 relative min-h-[75vh] w-full rounded-md">
  </iframe>

  <%= button_to "Done", sync_tax_form_path(@form), data: { turbo: false, "taxbandits-target": "doneForm" }, class: "btn w-full mt-5" %>
</div>
