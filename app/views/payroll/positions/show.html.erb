<% title "#{@position.payee.display_name}'s contract" %>
<% page_sm %>
<% unless @frame %>
  <%= render "events/nav", selected: :contractors %>
<% end %>

<%= turbo_frame_tag "contractor_#{@position.id}", target: "_top" do %>
  <article class="hcb-code">
    <h2 class="h2 mt0 border-none flex items-center justify-between hcb-code--heading mb-0" style="gap: 1ch">
      <span class="flex items-center py-3 gap-2 flex-grow">
        <span>
          <span class="regular muted">Contract with</span>
          <%= @position.payee.display_name %>
        </span>
        <span class="badge h4 bg-<%= @position.status_color %> nowrap order-1"><%= @position.status_text %></span>
      </span>

      <% can_update = (@position.under_review? || @position.onboarding?) && policy(@position).edit? %>
      <% can_renew = policy(@position).renew? %>
      <% can_terminate = @position.unsigned_renewal? ? @position.may_mark_terminated? : @renewal_chain.any?(&:may_mark_terminated?) %>
      <% if can_update || can_renew || can_terminate %>
        <div data-controller="menu" data-menu-placement-value="bottom-end">
          <%= pop_icon_to "more",
              "#",
              class: "align-middle", "aria-label": "More Options",
              data: { turbo: true, "menu-target": "toggle", action: "menu#toggle click@document->menu#close keydown@document->menu#keydown" } %>

          <div class="menu__content menu__content--2 h5 menu__content--compact" data-menu-target="content">
            <% if can_update %>
              <%= link_to edit_event_payroll_position_path(event_id: @event.slug, id: @position.id), class: "flex items-center", data: { turbo_frame: "_top", turbo_confirm: (@position.contract.present? ? "Changing the details will void this contract and generate a new one to sign. Continue?" : nil) } do %>
                <%= inline_icon "edit", size: 24 %>
                Update position
              <% end %>
            <% end %>
            <% if can_renew %>
              <%= link_to renew_event_payroll_position_path(event_id: @event.slug, id: @position.id), class: "flex items-center", data: { turbo_frame: "_top" } do %>
                <%= inline_icon "view-reload", size: 24 %>
                Renew
              <% end %>
            <% end %>
            <% if can_terminate %>
              <% if @position.unsigned_renewal? %>
                <%= link_to terminate_event_payroll_position_path(event: @event, payroll_position: @position), class: "flex items-center", data: { turbo_method: :post, turbo_confirm: "Cancel this renewal? The current contract won't be affected.#{" We will notify the contractor." unless @position.under_review? }" } do %>
                  <%= inline_icon "view-close", size: 24 %>
                  Cancel renewal
                <% end %>
              <% else %>
                <%= link_to terminate_event_payroll_position_path(event: @event, payroll_position: @position), class: "flex items-center", data: { turbo_method: :post, turbo_confirm: "Are you sure you want to terminate this contractor immediately?#{" Any renewal of this contract will also be terminated." if @renewal_chain.many? }#{" We will notify the contractor." unless @position.under_review? }" } do %>
                  <%= inline_icon "profile-forbidden", size: 24 %>
                  Terminate
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </h2>

    <section class="hcb-code--info">
      <p>
        <strong>Recipient</strong>
        <%= @position.payee.display_name %>
      </p>
      <p>
        <strong>Email</strong>
        <span class="!inline-flex gap-2 items-center">
          <%= @position.payee.email %>

          <% if @position.payee.legal_entity.nil? %>
            <%= link_to "#", data: { behavior: "modal_trigger", modal: "payee_#{@position.payee.hashid}_change_email" } do %>
              <%= inline_icon "edit" %>
            <% end %>
          <% end %>
        </span>
      </p>
      <p>
        <strong>Rate</strong>
        <%= "#{render_money @position.rate_cents}#{@position.rate_suffix}" %>
      </p>
      <p>
        <strong>Period</strong>
        <%= @position.period_label %>
      </p>
      <% if @position.renewal_of.present? %>
        <p>
          <strong>Renews</strong>
          <%= link_to "Contract for #{@position.renewal_of.period_label}", event_payroll_position_path(event_id: @event.slug, id: @position.renewal_of.id), data: { turbo_frame: "_top" } %>
        </p>
      <% end %>
      <% if @renewal.present? && !@renewal.unsigned_renewal? %>
        <p>
          <strong>Renewed by</strong>
          <%= link_to "Contract for #{@renewal.period_label}", event_payroll_position_path(event_id: @event.slug, id: @renewal.id), data: { turbo_frame: "_top" } %>
        </p>
      <% end %>
      <p>
        <strong>Purpose</strong>
        <%= @position.description %>
      </p>
      <p>
        <strong>Manager</strong>
        <%= @position.manager.present? ? user_mention(@position.manager) : "No manager" %>
      </p>
      <p>
        <strong>Total paid</strong>
        <%= render_money @position.payee.total_paid_cents %>
      </p>
      <% signed_contract = @position.contract&.document %>
      <% if signed_contract.present? %>
        <p>
          <strong>Signed contract</strong>
          <%= link_to "View contract", auditor_signed_in? ? signed_contract : document_download_path(signed_contract), data: { turbo_frame: "_top" } %>
        </p>
      <% end %>
      <% if @position.file.attached? %>
        <p>
          <strong>Attached agreement</strong>
          <%= link_to "View attachment", url_for(@position.file), data: { turbo_frame: "_top" } %>
        </p>
      <% end %>
    </section>
  </article>

  <% if @position.under_review? %>
    <% admin_tool("mt-4 flex items-center justify-between") do %>
      <% if @position.contract.present? %>
        <span>This contract is awaiting HCB review. Reviewing it means signing it as HCB.</span>
        <span class="flex gap-2">
          <%= link_to "Review", contract_party_path(@position.contract.party(:hcb)), class: "btn bg-success nowrap", data: { turbo_frame: "_top" } %>
          <%= button_to "Reject", reject_admin_payroll_position_path(@position), class: "btn bg-muted", data: { turbo_frame: "_top", turbo_confirm: "Reject this contractor?" } %>
        </span>
      <% else %>
        <span>No contract has been sent for this contractor yet — the organizer needs to retry sending it from the edit page before HCB can review it.</span>
        <%= button_to "Reject", reject_admin_payroll_position_path(@position), class: "btn bg-muted", data: { turbo_frame: "_top", turbo_confirm: "Reject this contractor?" } %>
      <% end %>
    <% end %>
  <% end %>

  <% if @position.status == :onboarding %>
    <h3 class="mt-4 mb-2">Onboarding</h3>
    <%= render "payroll/positions/onboarding_flow", position: @position, perspective: :organizer %>
  <% end %>

  <% if @renewal&.unsigned_renewal? %>
    <div class="mt-4 mb-2 flex items-center justify-between gap-2">
      <h3 class="my-0">Renewal for <%= @renewal.period_label %></h3>
      <%= link_to "View renewal", event_payroll_position_path(event_id: @event.slug, id: @renewal.id), class: "btn btn-small bg-info", data: { turbo_frame: "_top" } %>
    </div>
    <%= render "payroll/positions/onboarding_flow", position: @renewal, perspective: :organizer %>
  <% end %>

  <div class="mt-4 mb-2 flex items-center justify-between gap-2">
    <h3 class="my-0">Invoices</h3>
    <% if @can_upload_invoice %>
      <%= link_to "#", class: "btn btn-small bg-success", data: { behavior: "modal_trigger", modal: dom_id(@position, :upload_invoice) } do %>
        <%= inline_icon "cloud-upload", size: 20 %>
        Upload invoice
      <% end %>

      <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog"
        id="<%= dom_id(@position, :upload_invoice) %>"
        data-controller="turbo-frame-modal"
        data-action="turbo:submit-end->turbo-frame-modal#submitEnd">
        <%= modal_header "Upload an invoice" %>
        <%= turbo_frame_tag dom_id(@position, :invoice_form), src: new_payroll_position_invoice_path(@position), loading: :lazy do %>
          <%= render "application/loading_container", klass: "py-8" %>
        <% end %>
      </section>
    <% end %>
  </div>
  <% if @invoices.any? %>
    <article class="table-container">
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th>Reviewed by</th>
            <th>Description</th>
            <% if @renewal_chain.many? %><th>Contract</th><% end %>
            <th>Attachment</th>
            <th class="text-right">Amount</th>
            <% if @can_review %><th></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @invoices.each do |invoice| %>
            <tr>
              <td>
                <span class="badge ml-0 bg-<%= invoice.state_color %>"><%= invoice.aasm_state.humanize %></span>
              </td>
              <td>
                <% if invoice.reviewed_by.present? %>
                  <%= invoice.reviewed_by.name %>
                <% else %>
                  <span class="muted">&mdash;</span>
                <% end %>
              </td>
              <td style="max-width: 25ch;" class="overflow-hidden truncate" title="<%= invoice.name %>">
                <%= invoice.name %>
              </td>
              <% if @renewal_chain.many? %>
                <td class="nowrap"><%= invoice.payroll_position.period_label %></td>
              <% end %>
              <td>
                <% if invoice.receipts.any? %>
                  <div class="receipts_list flex gap-2">
                    <%= render partial: "receipts/receipt", collection: invoice.receipts.with_attached_file.includes(:user), as: :receipt, locals: { size: 48, hide_info: true, link_to_file: true } %>
                  </div>
                <% else %>
                  <span class="muted">&mdash;</span>
                <% end %>
              </td>
              <td class="text-right"><%= render_money invoice.amount_cents %></td>
              <% if @can_review %>
                <td class="text-right">
                  <% if invoice.submitted? %>
                    <div class="flex gap-2 justify-end">
                      <%= button_to "Approve", approve_event_payroll_invoice_path(event_id: @event.slug, id: invoice.id), class: "btn bg-success", data: { turbo_frame: "_top" } %>
                      <%= button_to "Reject", reject_event_payroll_invoice_path(event_id: @event.slug, id: invoice.id), class: "btn bg-muted", data: { turbo_frame: "_top", turbo_confirm: "Reject this invoice?" } %>
                    </div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </article>
  <% else %>
    <%= blankslate "No invoices yet" %>
  <% end %>

  <h3 class="mt-4 mb-2">Payments</h3>
  <% if @payments.any? %>
    <article class="table-container">
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th>Date</th>
            <th>Purpose</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr class="<%= "clickable" if organizer_signed_in? %>">
              <td>
                <span class="badge bg-<%= payment.state_color %>"><%= payment.state_text %></span>
              </td>
              <td><%= format_date payment.created_at %></td>
              <td style="max-width: 25ch;" class="overflow-hidden truncate" title="<%= payment.purpose %>">
                <%= payment.purpose %>
              </td>
              <td class="text-right">
                <%= render_money payment.amount %>
                <% if organizer_signed_in? %>
                  <%= link_to "", payment_path(payment),
                        class: "stretched-link",
                        data: popovers_enabled? ? payment_popover_data(payment) : { turbo_frame: "_top" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </article>
  <% else %>
    <%= blankslate "No payments yet" %>
  <% end %>
<% end %>

<% if @position.payee.legal_entity.nil? %>
  <%= render partial: "payees/change_email_modal", locals: { payee: @position.payee, destination: "contractors", destination_id: @position.hashid } %>
<% end %>
