<p>Hello,</p>

<% if @position.renewal_of %>
  <p>
    <%= @position.payee.display_name %> has signed their renewed contract
    with <%= @position.event.name %>, covering <%= @position.period_label %>.
  </p>
<% else %>
  <p>
    <%= @position.payee.display_name %> has completed their onboarding to
    become a contractor for <%= @position.event.name %>!
  </p>
<% end %>

<p>
  <%= @position.payee.display_name %> will <%= @position.renewal_of ? "keep" : "now be able to start" %>
  submitting invoices for review. You can
  <%= link_to "view this contractor's information, invoices, and payment history on HCB", event_payroll_position_url(@position.event, @position) %>.
</p>

<p>
  Sincerely,
  <br><br>
  The HCB Team
</p>
