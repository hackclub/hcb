<%= turbo_frame_tag dom_id(@position, :on_behalf_invoice_form) do %>
  <p class="h5 leading-[1.25] muted mt0 mb-3">
    Submit an invoice on behalf of <strong><%= @position.payee_display_name %></strong> for their work as
    <strong><%= @position.title %></strong>. It's approved automatically and paid after HCB review.
  </p>

  <%= render "application/flash", id: dom_id(@position, :on_behalf_invoice_flash), klass: "mb-3" %>

  <%= form_with(model: @invoice, url: create_invoice_event_payroll_position_path(event_id: @event.slug, id: @position.id), scope: :payroll_invoice, local: true) do |form| %>
    <%= render "payroll/invoices/fields", form:, position: @position %>
    <%= form.submit "Submit & approve invoice", class: "btn bg-success w-full" %>
  <% end %>
<% end %>
