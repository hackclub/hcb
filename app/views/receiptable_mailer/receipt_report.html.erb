<p>
Heads up! You have <%= @ledger_item_ids.count %> <%= "receipt".pluralize(@ledger_item_ids.count) %> that <%= "hasn't".pluralize(@ledger_item_ids.count) %> been uploaded to HCB.
</p>

<p>
You can also find this list in <%= link_to "your inbox", my_inbox_url %>.
</p>

<table>
  <thead>
    <tr>
      <th>Amount</th>
      <th>Merchant</th>
      <th>Time</th>
      <% if @show_org %>
        <th>Organization</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @items.order(datetime: :desc).each do |item| %>
      <tr>
        <td><%= link_to render_money(item.amount_cents.abs.to_s), attach_receipt_url(item.hcb_code) %></td>
        <td><%= item.linked_object.stripe_merchant_data&.dig("name") %></td>
        <td><%= time_ago_in_words(item.datetime) %> ago</td>
        <% if @show_org %>
          <td><%= (item.primary_ledger&.event || item.primary_ledger&.card_grant&.event)&.name %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>

<p>
  From,<br>
  The HCB Team
</p>
