<%# locals: (event:) %>

<% show_popovers = organizer_signed_in? %>
<% pinned_ledger_items = event.pinned_ledger_items.to_a %>
<% if pinned_ledger_items.any? %>
  <div class="flex gap-4 my-2 pinned__container">
    <% pinned_ledger_items.each do |ledger_item| %>
      <%# The unpin button sits beside the link rather than inside it, so clicking it doesn't also open the transaction. %>
      <div class="pinned__item relative">
        <%= link_to organizer_signed_in? ? ledger_item_path(ledger_item) : "#", data: show_popovers ? ledger_item_popover_data(ledger_item) : {}, class: "pinned__transaction relative card card-outlined flex flex-col black h-full" do %>
          <p class="font-bold m0 flex items-center g2">
            <%= format_date ledger_item.datetime %>
            <%= render "ledger/items/status", ledger_item: %>
          </p>
          <p class="pinned__transaction__text pinned__transaction__text--memo mt1 mb1 leading-[1.25] h3">
            <%= ledger_item.memo %>
          </p>
          <footer class="flex items-center justify-between -mb-1 gap-2 w-full">
            <span class="m0 muted">
              <%= render_money ledger_item.amount_cents %>
            </span>
            <%= render "ledger/items/icon", ledger_item: %>
          </footer>
        <% end %>
        <% if organizer_signed_in? %>
          <%= button_to ledger_item_unpin_path(ledger_item),
                method: :post,
                class: "pinned__transaction__pin pointer pop tooltipped tooltipped--w",
                aria: { label: "Unpin" },
                data: { turbo_confirm: "This will unpin the transaction for all team members. Continue?" } do %>
            <%= inline_icon "pin-remove", size: 28 %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
