<%# locals: (ledger:) %>

<% if params[:page].to_i <= 1 && @direction != "revenue" && ledger.event_id.present? && ledger.fronted_fee_balance_cents > 0 %>
  <%# @direction != revenue is in case the user has a revenue-only filter applied %>
  <tr class="transaction transaction--negative muted">
    <td class="transaction__icon">
      <div class="tooltipped tooltipped--e" aria-label="Fiscal sponsorship fee">
        <%= inline_icon "bank-icon", size: 32 %>
      </div>
    </td>
    <td class="hidden sm:table-cell"><%= format_date Time.now %></td>
    <td class="transaction__memo transaction__memo--fluid">
      <div>
        <div class="flex-auto min-w-0">
          <div class="flex items-center gap-[1ch] min-w-0">
            <%= badge_for "Pending", class: "bg-transparent border border-dashed border-muted m0 mr1 hidden sm:inline-flex" %>
            Fiscal sponsorship
          </div>

          <div class="flex items-center gap-[1ch] min-w-0 text-sm muted sm:hidden">
            <time class="truncate"><%= format_date Time.now %></time>
            <%= badge_for "Pending", class: "bg-transparent border border-dashed border-muted m0 mr1" %>
          </div>
        </div>
      </div>
    </td>
    <td class="nowrap">
      <span class="flex items-center justify-end">
        <%= render_money(-1 * ledger.fronted_fee_balance_cents) %>
      </span>
    </td>
    <td class="hidden sm:table-cell"></td>
  </tr>
<% end %>
