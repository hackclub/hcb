<%# locals: (ledger: nil, items:, table_only: true, filter: nil, show_fee: false, show_author: true) %>

<%# The tag picker is shared by every row, so it hangs off the frame that holds
    them all rather than off any one row. %>
<% tag_picker_event = taggable_event(@event || ledger&.event) %>

<%= turbo_frame_tag dom_id(ledger), data: { controller: "ledger-tag-picker", action: "click@document->ledger-tag-picker#close keydown@document->ledger-tag-picker#keydown" } do %>
  <% if !table_only && ledger.present? %>
    <section class="details mb-4">
      <div>
        <strong>Type</strong>
        <span><%= ledger.primary? ? "Primary Ledger" : "Non-Primary Ledger" %></span>
      </div>

      <% if ledger.event %>
        <div>
          <strong>Event</strong>
          <span><%= link_to ledger.event.name, event_path(ledger.event) %></span>
        </div>
      <% end %>

      <% if ledger.card_grant %>
        <div>
          <strong>Card Grant</strong>
          <span><%= link_to ledger.card_grant.name, card_grant_path(ledger.card_grant) %></span>
        </div>
      <% end %>

      <div>
        <strong>Balance</strong>
        <span><%= ledger.balance.format %></span>
      </div>
    </section>

    <h2>Ledger Items</h2>

    <div class="flex items-center mb2 flex-col sm:flex-row">
      <div class="flex-grow">
        <%= page_entries_info items, entry_name: "item" %>
      </div>
      <%= paginate items %>
    </div>
  <% end %>

  <% if defined?(filter) %>
    <%= filter %>
  <% end %>

  <% if items.load.any? %>
    <%# Resolved for the whole table; asking per row is two queries per row. %>
    <% taggable_codes = tag_picker_event ? hcb_codes_mapped_to(tag_picker_event, items.map(&:hcb_code)) : Set.new %>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th><%# icon %></th>
            <th>Date</th>
            <th>Memo</th>
            <th class="text-right">Amount</th>
            <% if show_author %><th><%# user avatar %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "ledgers/pending_fee_transaction", locals: { ledger: } if show_fee && ledger.present? %>
          <%= render partial: "ledger/item", locals: { show_author:, tag_picker_event:, taggable_codes: }, collection: items, as: :item %>
        </tbody>
      </table>
    </div>

    <%= render partial: "ledgers/tag_picker", locals: { event: tag_picker_event } if tag_picker_event %>

    <%= paginate items %>
  <% else %>
    <%= blankslate "This ledger has no items yet" %>
  <% end %>
<% end %>
