<%# locals: (ledger: nil, items:, table_only: true, filter: nil, show_fee: false, show_author: true, rows_cache_key: nil) %>

<%= turbo_frame_tag ledger.present? ? dom_id(ledger) : "ledger" do %>
  <% if !table_only && ledger.present? %>
    <section class="details mb-4">
      <div>
        <strong>Type</strong>
        <span><%= ledger.primary? ? "Primary Ledger" : "Non-Primary Ledger" %></span>
      </div>

      <% if ledger.event %>
        <div>
          <strong>Event</strong>
          <span><%= link_to ledger.event.name, event_path(ledger.event) %></span>
        </div>
      <% end %>

      <% if ledger.card_grant %>
        <div>
          <strong>Card Grant</strong>
          <span><%= link_to ledger.card_grant.name, card_grant_path(ledger.card_grant) %></span>
        </div>
      <% end %>

      <div>
        <strong>Balance</strong>
        <span><%= ledger.balance.format %></span>
      </div>
    </section>

    <h2>Ledger Items</h2>

    <div class="flex items-center mb2 flex-col sm:flex-row">
      <div class="flex-grow">
        <%= page_entries_info items, entry_name: "item" %>
      </div>
      <%= paginate items %>
    </div>
  <% end %>

  <% if defined?(filter) %>
    <%= filter %>
  <% end %>

  <% if items.load.any? %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th><%# icon %></th>
            <th>Date</th>
            <th>Memo</th>
            <th class="text-right">Amount</th>
            <% if show_author %><th><%# user avatar %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "ledgers/pending_fee_transaction", locals: { ledger: } if show_fee && ledger.present? %>
          <%#
            Row markup is only shareable between viewers when it carries no
            per-session state — no CSRF-bearing tag forms, no rename affordance.
            Callers that can guarantee that (see EventsController#ledger_rows_cache_key)
            pass a key; everyone else passes nil and renders uncached.
          %>
          <% cache_if rows_cache_key.present?, rows_cache_key, expires_in: 5.minutes, race_condition_ttl: 1.minute do %>
            <%= render partial: "ledger/item", locals: { show_author: }, collection: items, as: :item %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= paginate items %>
  <% else %>
    <%= blankslate "This ledger has no items yet" %>
  <% end %>
<% end %>
