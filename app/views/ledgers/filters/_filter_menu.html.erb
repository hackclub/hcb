<%# locals: () %>

<%# The card grant ledger is a frame on the card grants page; the menu lives inside it so its links navigate that frame. %>
<% menu_frame = "turbo-frame#card_grant_transaction_overview" if @use_card_grant_ledgers %>
<% tags = @event.tags.order(label: :asc) %>

<div data-controller="menu" data-menu-append-to-value="<%= menu_frame %>" data-menu-placement-value="bottom-start" class="-mb-1">
  <button
    type="button"
    aria-label="Add filter"
    class="tooltipped tooltipped--s pop menu__toggle menu__toggle--arrowless overflow-visible"
    data-menu-target="toggle" data-action="menu#toggle click@document->menu#close keydown@document->menu#keydown">
    <%= inline_icon "filter", size: 28 %>
  </button>
  <div class="menu__content menu__content--2 menu__content--compact h5 w-[350px] h-[400px] p-0" data-menu-target="content">
    <div class="grid grid-cols-3 h-full gap-0" data-controller="tabs" data-tabs-default-tab-value="<%= @tag ? "tags" : @user ? "user" : @type ? "type" : @start_date || @end_date ? "date" : @maximum_amount || @minimum_amount ? "amount" : tags.length > 0 ? "tags" : "user" %>">
      <div class="bg-[rgba(200,200,200,0.2)] dark:bg-[rgb(30,29,34)] flex flex-col items-start gap-1 p-3">
        <% if tags.length > 0 %>
          <button id="tags" data-tabs-target="btn" data-action="click->tabs#select">Tag</button>
        <% end %>
        <button id="user" data-tabs-target="btn" data-action="click->tabs#select">User</button>
        <% unless @use_card_grant_ledgers %>
          <button id="type" data-tabs-target="btn" data-action="click->tabs#select">Type</button>
        <% end %>
        <button id="date" data-tabs-target="btn" data-action="click->tabs#select">Date</button>
        <button id="amount" data-tabs-target="btn" data-action="click->tabs#select">Amount</button>
        <button id="category" data-tabs-target="btn" data-action="click->tabs#select">Category</button>
        <button id="merchant" data-tabs-target="btn" data-action="click->tabs#select">Merchant</button>
        <button id="receipts" data-tabs-target="btn" data-action="click->tabs#select">Receipts</button>
      </div>

      <div class="col-span-2 p-2 overflow-y-scroll">
        <% if tags.length > 0 %>
          <div data-tabs-target="tab" id="tags">
            <% tags.each do |tag| %>
              <div class="flex items-center" data-tag="<%= tag.id %>">
                <%= link_to(ledger_filter_path(@ledger_filters.merge("tag" => tag.id)), class: "flex-auto menu__action #{"menu__action--active" if @tag == tag}", data: { turbo_prefetch: "false" }) do %>
                  <%= render partial: "canonical_transactions/tag_icon", locals: { tag: } %>
                  <%= tag.label %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <div data-tabs-target="tab" id="user">
          <% @users.each do |user| %>
            <div class="flex items-center">
              <%= link_to(ledger_filter_path(@ledger_filters.merge("author" => user.slug)), class: "flex-auto flex items-center menu__action #{"menu__action--active" if @user == user}", data: { turbo_prefetch: "false" }) do %>
                <div class="avatar-grow line-height-0 mr1">
                  <%= avatar_for user, size: 18 %>
                </div>
                <%= user.name %>
              <% end %>
            </div>
          <% end %>
        </div>
        <% unless @use_card_grant_ledgers %>
          <div data-tabs-target="tab" id="type">
            <% SetLedgerFilters::TYPE_PREDICATES.sort.each do |type, predicate| %>
              <div class="flex items-center">
                <%= link_to(ledger_filter_path(@ledger_filters.merge("linked_object_type" => predicate)), class: "flex-auto menu__action #{"menu__action--active" if @type == type}", data: { turbo_prefetch: "false" }) do %>
                  <%= type.humanize.gsub("Ach", "ACH").gsub("Paypal", "PayPal").gsub("Hcb", "HCB") %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
        <div data-tabs-target="tab" id="date">
          <%= form_with(model: false, local: true, method: :get, class: "flex-auto p1", data: { controller: "ledger-query", ledger_query_filters_value: @ledger_filters.to_json, action: "submit->ledger-query#dates" }) do |form| %>
            <p class="bold mb0 mt0">Transactions after...</p>
            <input type="date" class="border mb1" value="<%= @start_date %>" data-ledger-query-target="start">
            <p class="bold mb0 mt0">Transactions before...</p>
            <input type="date" class="border mb1" value="<%= @end_date %>" data-ledger-query-target="end">

            <% request.query_parameters.except(:query, :page).each do |key, value| %>
              <%= hidden_field_tag key, value %>
            <% end %>
            <%= hidden_field_tag :query, nil, id: nil, data: { ledger_query_target: "query" } %>

            <div class="flex justify-start">
              <%= form.submit "Filter transactions" %>
            </div>
          <% end %>
        </div>
        <div data-tabs-target="tab" id="amount">
          <%= form_with(model: false, local: true, method: :get, class: "flex-auto", data: { controller: "ledger-query", ledger_query_filters_value: @ledger_filters.to_json, action: "submit->ledger-query#amounts" }) do |form| %>
            <div class="m-2">
              <p class="bold mb-0 mt-2">Transactions more than...</p>
              <div class="flex mb1">
                <span class="bold muted flex self-end items-center justify-center" style="width: 1rem; height: 48px;">$</span>
                <input type="number" placeholder="50.00" value="<%= @minimum_amount %>" step="0.01" data-controller="truncate-decimal" data-action="truncate-decimal#truncate blur->truncate-decimal#pad" data-ledger-query-target="minimum">
              </div>

              <p class="bold mb-0 mt-0">Transactions less than...</p>
              <div class="flex">
                <span class="bold muted flex self-end items-center justify-center" style="width: 1rem; height: 48px;">$</span>
                <input type="number" placeholder="500.00" value="<%= @maximum_amount %>" step="0.01" data-controller="truncate-decimal" data-action="truncate-decimal#truncate blur->truncate-decimal#pad" data-ledger-query-target="maximum">
              </div>

              <% request.query_parameters.except(:query, :page).each do |key, value| %>
                <%= hidden_field_tag key, value %>
              <% end %>
              <%= hidden_field_tag :query, nil, id: nil, data: { ledger_query_target: "query" } %>
            </div>

            <div class="flex justify-start m-1">
              <%= form.submit "Filter transactions" %>
            </div>

            <% unless @use_card_grant_ledgers %>
              <hr class="!border-muted !my-3">
              <div class="m-2">
                <p class="bold mb-0 mt-2">Revenue or expenses?</p>
              </div>
              <% SetLedgerFilters::DIRECTION_PREDICATES.each do |direction, predicate| %>
                <div class="flex items-center">
                  <%= link_to(ledger_filter_path(@ledger_filters.merge("amount_cents" => predicate)), class: "flex-auto menu__action #{"menu__action--active" if @direction == direction}", data: { turbo_prefetch: "false" }) do %>
                    <%= direction.humanize %>
                  <% end %>
                </div>
              <% end %>
              <div class="flex items-center">
                <%= link_to(ledger_filter_path(@ledger_filters.except("amount_cents")), class: "flex-auto menu__action #{"menu__action--active" unless @direction}", data: { turbo_prefetch: "false" }) do %>
                Both
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <div data-tabs-target="tab" id="category">
          <% TransactionCategory.order(slug: :asc).each do |category| %>
            <div class="flex items-center">
              <%= link_to(category.definition.label, ledger_filter_path(@ledger_filters.merge("category" => category.slug)), class: "flex-auto menu__action #{"menu__action--active" if @category == category}", data: { turbo_prefetch: "false" }) %>
            </div>
          <% end %>
        </div>
        <div data-tabs-target="tab" id="merchant">
          <%= turbo_frame_tag :merchants_filter, src: event_merchants_filter_path(@event, merchant: @merchant, ledger: true), loading: :lazy, target: "_top" %>
        </div>
        <div data-tabs-target="tab" id="receipts">
          <div class="flex items-center">
            <%= link_to("Missing receipts", ledger_filter_path(@ledger_filters.merge(SetLedgerFilters::MISSING_RECEIPTS)), class: "flex-auto menu__action #{"menu__action--active" if @missing_receipts}", data: { turbo_prefetch: "false" }) %>
          </div>
          <div>
            <%= link_to("All transactions", ledger_filter_path(@ledger_filters.except(*SetLedgerFilters::MISSING_RECEIPTS.keys)), class: "flex-auto menu__action #{"menu__action--active" unless @missing_receipts}", data: { turbo_prefetch: "false" }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
