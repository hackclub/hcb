<%# locals: (event:) %>

<%# The single tag picker shared by every row; see ledger_tag_menu_controller. %>
<div class="menu__content menu__content--2 menu__content--compact menu__content--left text-sm"
     data-ledger-tag-menu-target="content"
     style="display: none; position: fixed;">
  <% event.tags.each do |tag| %>
    <div class="flex items-center">
      <button
        type="button"
        class="menu__action flex-auto"
        data-tag-id="<%= tag.id %>"
        data-action="ledger-tag-menu#toggleTag">
        <%= render partial: "canonical_transactions/tag_icon", locals: { tag: } %>
        <%= tag.label %>
        <span data-check></span>
      </button>
      <%= button_to event_tag_path(event, tag), class: "menu__action", method: :delete, title: "Delete this tag", form: { "data-turbo" => "true", "data-turbo-confirm" => tag.removal_confirmation_message, "data-turbo-confirm-danger" => true } do %>
        <%= inline_icon "delete", size: 18, style: "margin: 0" %>
      <% end %>
    </div>
  <% end %>
  <% if event.tags.any? %>
    <div class="menu__divider tags__divider"></div>
  <% end %>

  <%# The modal this opens is rendered by `events/nav`, which is keyed to @event. %>
  <% if @event == event && OrganizerPosition.role_at_least?(current_user, @event, :member) %>
    <%= link_to "#", class: "menu__input", data: { behavior: "modal_trigger", modal: "create_tag", action: "ledger-tag-menu#stampCreateTag" } do %>
      <%= inline_icon "plus", size: 15 %>
      Create tag
    <% end %>
  <% end %>
</div>
