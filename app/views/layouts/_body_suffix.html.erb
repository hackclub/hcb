<%# locals: () %>

<% if Rails.env.production? %>
  <%= render "application/fullstory" if current_user&.sessions_reported %>
<% end %>

<% if flash[:confetti] %>
  <%# turbo-temporary so a cached restore (Back) doesn't fire it again %>
  <div data-controller="confetti" data-confetti-auto-value="true" data-confetti-emojis-value="<%= flash[:confetti_emojis] %>" data-turbo-temporary></div>
<% end %>
<% if Flipper.enabled?(:transactions_background_2024_06_05, current_user) %>
  <style>
      .success-dark {
          color: #1f8164
      }
  </style>
<% end %>
