<%# Overrides turbo-rails' own frame layout to render the flash. Turbo keeps
    only the requested frame, so it never reaches the DOM; the client picks it
    out of the response instead. -%>
<html>
  <head>
    <%= csrf_meta_tags %>
    <%= yield :head %>
  </head>
  <body>
    <%= yield %>
    <%= render "application/flash" %>
  </body>
</html>
