<p>
  Your <%= link_to "#{render_money @card_charge.amount_cents} charge", ledger_item_url(@ledger_item) %> on <%= @ledger_item.datetime.strftime("%B #{@ledger_item.datetime.day.ordinalize}") %> was reversed by <strong><%= @merchant_name %></strong>. Your balance has been updated to reflect this reversal.
</p>

<h3 class="mb-2">Wasn't expecting this reversal?</h3>
<p class="my-0">
  Charges are often reversed by <strong><%= @merchant_name %></strong> when an order is canceled or a refund is requested. Another common cause is a mismatch between the billing information you provided and your card's details.
  <br><br>
  Reversals can also happen for other reasons at the merchant's sole discretion. To find out why this charge was reversed, we recommend reaching out to <%= @merchant_name %> directly.
</p>

<% if @failed_verification_checks.present? || @insufficient_balance || @spending_limit_exceeded %>
  <h3 class="mb-2">What went wrong</h3>

  <ul class="my-0">
    <% if @failed_verification_checks.include?("address_postal_code_check") %>
      <li class="pt1 pb1">We noticed that the zip code used at <%= @merchant_name %> didn't match your <%= link_to "billing address", settings_address_url %>. Please double-check it and try again.</li>
    <% end %>
    <% if @failed_verification_checks.include?("address_line1_check") %>
      <li class="pt1 pb1">We noticed that the billing address used at <%= @merchant_name %> didn't match your <%= link_to "billing address", settings_address_url %>. Please double-check it and try again.</li>
    <% end %>
    <% if @failed_verification_checks.include?("cvc_check") %>
      <li class="pt1 pb1">We noticed that the CVC used at <%= @merchant_name %> didn't match your <%= link_to "HCB card", stripe_card_url(@card_charge.stripe_card) %>. Please double-check it and try again.</li>
    <% end %>
    <% if @failed_verification_checks.include?("expiry_check") %>
      <li class="pt1 pb1">We noticed that the expiration date used at <%= @merchant_name %> didn't match your <%= link_to "HCB card", stripe_card_url(@card_charge.stripe_card) %>. Please double-check it and try again.</li>
    <% end %>
    <% if @insufficient_balance %>
      <li class="pt1 pb1">Your organization doesn't have enough balance to cover the purchase.</li>
    <% end %>
    <% if @spending_limit_exceeded %>
      <li class="pt1 pb1">You've hit a spending limit set on your card.</li>
    <% end %>
  </ul>
  <br>
  <p class="mt-2 mb-0">
    If you're still running into problems, you can find more info in <%= link_to "our help center", "https://help.hcb.hackclub.com/en/articles/15409721-my-card-was-declined-what-should-i-do" %>.
  </p>
<% end %>

<p>
  <%= link_to "Click here to view this transaction.", ledger_item_url(@ledger_item) %>
</p>
