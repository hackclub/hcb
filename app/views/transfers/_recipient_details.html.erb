<%# locals: (form:, disabled:, required: true, show_us: false, initial_country: form.object.recipient_country.to_s) %>
<%# herb:slots client %>
<%# herb:state (selected_recipient_country: initial_country) %>

<div data-controller="address-autocomplete">
  <%= form.label :address_line1, "Street address" %>
  <div class="grid grid--split gap-2">
    <div class="field flex-auto">
      <%= form.text_field :address_line1, class: "flex-1", placeholder: "17 Oakfield Close", required:, disabled:, data: { address_autocomplete_target: "line1" } %>
    </div>

    <div class="field flex-auto">
      <%= form.text_field :address_line2, class: "flex-1", placeholder: "Flat 4B", disabled: %>
    </div>

    <div class="field flex-auto">
      <%= form.label :address_city, "City" %>
      <%= form.text_field :address_city, placeholder: "Sheffield", required:, disabled:, data: { address_autocomplete_target: "city" } %>
    </div>

    <div class="field flex-auto">
      <%= form.label :address_state, "State / province" %>
      <%= form.text_field :address_state, placeholder: "South Yorkshire", required:, disabled:, data: { address_autocomplete_target: "state" } %>
    </div>

    <div class="field flex-auto">
      <%= form.label :address_postal_code, "Postal code / ZIP code" %>
      <%= form.text_field :address_postal_code, placeholder: "S1 2AB", required:, disabled:, data: { address_autocomplete_target: "postalCode" } %>
    </div>

    <div class="field flex-auto">
      <%= form.label :recipient_country, "Country" %>
      <%= form.collection_select :recipient_country, show_us ? Event.countries_for_select : Event.countries_for_select.excluding([["US", "United States"]]), :first, :last, { include_blank: "Select a country" }, { style: "min-height:37px", required:, disabled:, data: { herb_set: "selected_recipient_country=$value", address_autocomplete_target: "country" } } %>
    </div>
  </div>
</div>
