<%# locals: (comments:, show_blankslate: nil, viewing_commentable: nil) %>

<section class="comments" id="comments">
  <% if policy_scope(comments).empty? && show_blankslate %>
    <%= blankslate "No comments yet." %>
  <% else %>
    <%= render partial: "comments/item", collection: policy_scope(comments).includes(:user, :versions).with_attached_file, as: :comment, locals: { viewing_commentable: } %>
  <% end %>
</section>
